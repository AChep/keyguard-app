# macOS metadata
*.DS_Store
.localized
.AppleDouble/
.LSOverride
._*
__MACOSX/

# Built application files
*.apk
*.ap_

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Python generated files
__pycache__/
*.pyc

# Gradle files
.gradle/
.gradle-*/
build/

# Swift Package Manager / xcodebuild run output
.build/
.build-run/
.build-run-nosign/
# Keep shared package configuration, schemes, and Package.resolved versioned.
**/.swiftpm/configuration/registries.json
**/.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata

# Kotlin files
.kotlin/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Apple / Xcode
# Per-developer signing identity; see xcode/Signing.local.xcconfig.example
xcode/Signing.local.xcconfig
# Signing keys, certificate bundles, and provisioning profiles (any letter case).
# Keep .key/.pem files eligible for version control; they include test fixtures.
*.[pP]8
*.[pP]12
*.[pP][fF][xX]
*.[mM][oO][bB][iI][lL][eE][pP][rR][oO][vV][iI][sS][iI][oO][nN]
*.[pP][rR][oO][vV][iI][sS][iI][oO][nN][pP][rR][oO][fF][iI][lL][eE]
DerivedData/
xcuserdata/
*.xcuserstate
*.moved-aside
*.xccheckout
*.xcscmblueprint
*.hmap
*.app/
*.ipa
*.dmg
*.pkg
*.xcarchive/
*.xcresult/
*.dSYM
*.dSYM.zip

# iOS dependency build products
Pods/
Carthage/Build/

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/

# Keystore files
# Uncomment the following line if you do not want to check your keystore files in.
#*.jks

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild

# Google Services (e.g. APIs or Firebase)
google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Build artifacts (packaged extension / app images)
/dist/

# Browser extension — generated manifests (switch-browser.sh)
extension/manifest.json
extension/manifest.json.bak

# Safari — Xcode build artifacts
safari/build/
safari/*/build/
safari/*.xcuserstate
# FIDO2 native build output
/util/fido2/rust/target/
