        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschlüsselte Repositorys verwenden eine ZIP-Verschlüsselung mit AES-256. Öffnen Sie repo.zip und die neueste lesbare Datei, die dem Muster indexes/*.zip entspricht, mit dem Backup-Passwort. Der Index verweist auf jedes Archiv unter snapshots/*.zip und blobs/**/*.zip und speichert dessen ZIP-Passwort als encryption.keyBase64. Wenn kein Backup-Passwort festgelegt wurde, handelt es sich bei diesen Dateien um normale ZIP-Archive."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
