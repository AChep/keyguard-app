    "urlblock_expose_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indien geaktiveer, word die item buite die kluis gestoor, wat toelaat dat outovul-voorstelle heeltemal versteek word selfs al is die kluis gesluit"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في حال التفعيل، يتم تخزين العنصر خارج القبو، مما يسمح بإخفاء اقتراحات التعبئة التلقائية تمامًا حتى لو كان القبو مقفلاً."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If enabled, the item is stored outside of the vault, allowing to completely hide the autofill suggestions even if the vault is locked"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If enabled, the item is stored outside of the vault, allowing to completely hide the autofill suggestions even if the vault is locked"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud je tato možnost zapnutá, položka se ukládá mimo trezor, což umožní zcela skrýt návrhy automatického vyplňování i v případě, že je trezor uzamčen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indien ingeschakeld, wordt het item buiten de kluis opgeslagen, waardoor de suggesties voor automatisch invullen volledig kunnen worden verborgen, zelfs als de kluis is vergrendeld"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn diese Option aktiviert ist, wird das Element außerhalb des Tresors gespeichert, sodass die Vorschläge für die automatische Ausfüllung vollständig ausgeblendet werden können, selbst wenn der Tresor gesperrt ist"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If enabled, the item is stored outside of the vault, allowing to completely hide the autofill suggestions even if the vault is locked"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If enabled, the item is stored outside of the vault, allowing to completely hide the autofill suggestions even if the vault is locked"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If enabled, the item is stored outside of the vault, allowing to completely hide the autofill suggestions even if the vault is locked"
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If enabled, the item is stored outside of the vault, allowing to completely hide the autofill suggestions even if the vault is locked"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, el elemento se almacena fuera de la caja fuerte, permitiendo ocultar completamente las sugerencias de autocompletado incluso si la caja fuerte está bloqueada"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If enabled, the item is stored outside of the vault, allowing to completely hide the autofill suggestions even if the vault is locked"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, l'élément est stocké en dehors du coffre-fort, ce qui permet de masquer complètement les suggestions de remplissage automatique, même si le coffre-fort est verrouillé"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If enabled, the item is stored outside of the vault, allowing to completely hide the autofill suggestions even if the vault is locked"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha engedélyezve van, az elem a széfen kívül tárolódik, ami lehetővé teszi az automatikus kitöltési javaslatok teljes elrejtését még akkor is, ha a széf zárolva van"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se attivata, l'elemento viene memorizzato al di fuori della cassaforte, consentendo di nascondere completamente i suggerimenti di compilazione automatica anche se la cassaforte è bloccata"
          }
        },
        "ja" : {
          "stringUnit" : {
