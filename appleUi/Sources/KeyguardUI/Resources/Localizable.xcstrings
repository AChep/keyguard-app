    "pref_item_load_website_icons_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gaan haal van webwerfikone kan moontlik webwerfadresse aan jou internetverskaffer uitlek"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يؤدي رمز موقع قائمة الانتظار إلى تسريب عنوان موقع الويب إلى مزود خدمة الإنترنت"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fetching website icons might leak website addresses to your internet provider"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sol·licitar la icona del lloc web pot filtrar la direcció al proveïdor d'Internet"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Načtení ikony webu může poskytovateli připojení prozradit adresu webové stránky"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placering af webstedsikoner i kø lækker muligvis webstedsadressen til internetudbyderen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachfragen der Icons könnte die Adresse der Webseite an den Internetprovider preisgeben"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fetching website icons might leak website addresses to your internet provider"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fetching website icons might leak website addresses to your internet provider"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queuing website icon might leak the website address to internet provider"
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fetching website icons might leak website addresses to your internet provider"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El icono de la página web podría filtrar la dirección del sitio web al proveedor de Internet"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkkosivuston kuvakkeiden jonottaminen saattaa vuotaa verkkosivustojen osoitteita internet-palveluntarjoajallesi"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'icône du site web en attente peut révéler l'adresse du site Web au fournisseur d'accès à Internet"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fetching website icons might leak website addresses to your internet provider"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A webhely ikonok betöltésekor a webhely címe kiszivároghat az internetszolgáltatójához"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'icona del sito web in coda potrebbe perdere l'indirizzo del sito web al provider internet"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウェブサイトのアイコンを取得すると、インターネットプロバイダーにウェブサイトの URL が漏洩する可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웹사이트 아이콘을 불러오면 인터넷 제공사에 웹사이트 주소가 노출될 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fetching website icons might leak website addresses to your internet provider"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het tonen van website iconen kan het adres van de website lekken naar uw internetprovider"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobieranie ikon ze stron internetowych może narazić Cię na udostępnienie adresów witryn swojemu dostawcy internetu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A consulta pelo ícone do site pode vazar o endereço do site para o provedor de Internet"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pesquisa pelos ícones dos sites pode levar à exposição do endereço dos sites ao provedor do serviço de internet"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișarea pictogramelor presupune interogarea site-urilor, iar furnizorul tău de internet ar putea vedea acest trafic"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрос значка сайта может привести к утечке адреса сайта к интернет-провайдеру"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fetching website icons might leak website addresses to your internet provider"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fetching website icons might leak website addresses to your internet provider"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web sitesi simgelerini çekmek, ziyaret ettiğiniz web sitelerini internet sağlayıcınıza sızdırabilir"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запит іконки вебсайту може дати інформацію інтернет-провайдеру про збережені в сховищі адреси вебсайтів"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xếp hàng biểu tượng trang web có thể rò rỉ địa chỉ trang web cho nhà cung cấp internet"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "获取网站图标时可能会向运营商泄露网站地址"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "獲取網站圖示時可能會向運營商洩露網站地址"
          }
        }
      }
    },
