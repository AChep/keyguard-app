    "gpg_agent_setup_step_5_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the same GNUPGHOME when Git signs commits. Keep the config local to one repository, or change --local to --global."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم نفس GNUPGHOME عندما يوقّع Git الالتزامات. أبقِ الإعداد محليًا لمستودع واحد، أو غيّر --local إلى --global."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the same GNUPGHOME when Git signs commits. Keep the config local to one repository, or change --local to --global."
          }
        },
        "ca" : {
