    "pref_item_gpg_keyserver_auto_refresh_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While the app is active and the vault is unlocked, Keyguard contacts your configured GPG keyserver at the selected interval using the fingerprint of each GPG item that contains only a public key. If a matching public key is found, Keyguard updates the stored public key, key metadata, and keyserver status."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أثناء نشاط التطبيق وفتح الخزنة، يتصل Keyguard بخادم مفاتيح GPG المُعدّ لديك على الفترة المحددة باستخدام بصمة كل عنصر GPG يحتوي على مفتاح عام فقط. إذا عُثر على مفتاح عام مطابق، فسيحدّث Keyguard المفتاح العام المخزّن وبيانات المفتاح الوصفية وحالة خادم المفاتيح."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While the app is active and the vault is unlocked, Keyguard contacts your configured GPG keyserver at the selected interval using the fingerprint of each GPG item that contains only a public key. If a matching public key is found, Keyguard updates the stored public key, key metadata, and keyserver status."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While the app is active and the vault is unlocked, Keyguard contacts your configured GPG keyserver at the selected interval using the fingerprint of each GPG item that contains only a public key. If a matching public key is found, Keyguard updates the stored public key, key metadata, and keyserver status."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While the app is active and the vault is unlocked, Keyguard contacts your configured GPG keyserver at the selected interval using the fingerprint of each GPG item that contains only a public key. If a matching public key is found, Keyguard updates the stored public key, key metadata, and keyserver status."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While the app is active and the vault is unlocked, Keyguard contacts your configured GPG keyserver at the selected interval using the fingerprint of each GPG item that contains only a public key. If a matching public key is found, Keyguard updates the stored public key, key metadata, and keyserver status."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während die App aktiv und der Tresor entsperrt ist, kontaktiert Keyguard Ihren konfigurierten GPG-Schlüsselserver im ausgewählten Intervall mit dem Fingerabdruck jedes GPG-Elements, das nur einen öffentlichen Schlüssel enthält. Wenn ein passender öffentlicher Schlüssel gefunden wird, aktualisiert Keyguard den gespeicherten öffentlichen Schlüssel, die Schlüssel-Metadaten und den Schlüsselserver-Status."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While the app is active and the vault is unlocked, Keyguard contacts your configured GPG keyserver at the selected interval using the fingerprint of each GPG item that contains only a public key. If a matching public key is found, Keyguard updates the stored public key, key metadata, and keyserver status."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While the app is active and the vault is unlocked, Keyguard contacts your configured GPG keyserver at the selected interval using the fingerprint of each GPG item that contains only a public key. If a matching public key is found, Keyguard updates the stored public key, key metadata, and keyserver status."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While the app is active and the vault is unlocked, Keyguard contacts your configured GPG keyserver at the selected interval using the fingerprint of each GPG item that contains only a public key. If a matching public key is found, Keyguard updates the stored public key, key metadata, and keyserver status."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While the app is active and the vault is unlocked, Keyguard contacts your configured GPG keyserver at the selected interval using the fingerprint of each GPG item that contains only a public key. If a matching public key is found, Keyguard updates the stored public key, key metadata, and keyserver status."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras la aplicación está activa y la caja fuerte está desbloqueada, Keyguard se pone en contacto con el servidor de claves GPG configurado en el intervalo seleccionado usando la huella digital de cada elemento GPG que solo contenga una clave pública. Si se encuentra una clave pública coincidente, Keyguard actualiza la clave pública almacenada, los metadatos de la clave y el estado del servidor de claves."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While the app is active and the vault is unlocked, Keyguard contacts your configured GPG keyserver at the selected interval using the fingerprint of each GPG item that contains only a public key. If a matching public key is found, Keyguard updates the stored public key, key metadata, and keyserver status."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque l'application est active et que le coffre-fort est déverrouillé, Keyguard contacte le serveur de clés GPG que vous avez configuré à l'intervalle sélectionné en utilisant l'empreinte de chaque élément GPG qui ne contient qu'une clé publique. Si une clé publique correspondante est trouvée, Keyguard met à jour la clé publique stockée, les métadonnées de la clé et le statut du serveur de clés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While the app is active and the vault is unlocked, Keyguard contacts your configured GPG keyserver at the selected interval using the fingerprint of each GPG item that contains only a public key. If a matching public key is found, Keyguard updates the stored public key, key metadata, and keyserver status."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While the app is active and the vault is unlocked, Keyguard contacts your configured GPG keyserver at the selected interval using the fingerprint of each GPG item that contains only a public key. If a matching public key is found, Keyguard updates the stored public key, key metadata, and keyserver status."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre l'app è attiva e la cassaforte è sbloccata, Keyguard contatta il keyserver GPG configurato all'intervallo selezionato utilizzando l'impronta digitale di ogni elemento GPG che contiene solo una chiave pubblica. Se viene trovata una chiave pubblica corrispondente, Keyguard aggiorna la chiave pubblica memorizzata, i metadati della chiave e lo stato del keyserver."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリがアクティブで保管庫のロックが解除されている間、Keyguard は、公開鍵のみを含む各 GPG アイテムのフィンガープリントを使用して、選択した間隔で設定された GPG キーサーバーに問い合わせます。一致する公開鍵が見つかった場合、保存済みの公開鍵、キーのメタデータ、キーサーバーの状態を更新します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 활성 상태이고 보관함이 잠금 해제된 동안, Keyguard는 공개 키만 포함된 각 GPG 항목의 핑거프린트를 사용하여 선택한 간격마다 설정된 GPG 키 서버에 접속합니다. 일치하는 공개 키를 찾으면 Keyguard가 저장된 공개 키, 키 메타데이터, 키 서버 상태를 업데이트합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mens appen er aktiv og hvelvet er låst opp, kontakter Keyguard den konfigurerte GPG-nøkkelserveren med det valgte intervallet ved hjelp av fingeravtrykket til hvert GPG-element som bare inneholder en offentlig nøkkel. Hvis en samsvarende offentlig nøkkel blir funnet, oppdaterer Keyguard den lagrede offentlige nøkkelen, nøkkelmetadataene og nøkkelserverstatusen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terwijl de app actief is en de kluis ontgrendeld is, neemt Keyguard op het geselecteerde interval contact op met de door jou ingestelde GPG-sleutelserver met behulp van de vingerafdruk van elk GPG-item dat alleen een publieke sleutel bevat. Als er een overeenkomende publieke sleutel wordt gevonden, werkt Keyguard de opgeslagen publieke sleutel, de sleutelmetadata en de sleutelserverstatus bij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy aplikacja jest aktywna, a sejf odblokowany, Keyguard kontaktuje się ze skonfigurowanym serwerem kluczy GPG w wybranych odstępach czasu, używając odcisku palca każdego elementu GPG zawierającego wyłącznie klucz publiczny. Jeśli zostanie znaleziony pasujący klucz publiczny, Keyguard aktualizuje przechowywany klucz publiczny, metadane klucza oraz status serwera kluczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto o aplicativo estiver ativo e o cofre desbloqueado, o Keyguard entra em contato com o servidor de chaves GPG configurado, no intervalo selecionado, usando a impressão digital de cada item GPG que contenha apenas uma chave pública. Se uma chave pública correspondente for encontrada, o Keyguard atualiza a chave pública armazenada, os metadados da chave e o status do servidor de chaves."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto a aplicação estiver ativa e o cofre desbloqueado, o Keyguard contacta o servidor de chaves GPG configurado no intervalo selecionado, utilizando a impressão digital de cada item GPG que contenha apenas uma chave pública. Se for encontrada uma chave pública correspondente, o Keyguard atualiza a chave pública armazenada, os metadados da chave e o estado do servidor de chaves."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cât timp aplicația este activă și seiful este deblocat, Keyguard contactează serverul de chei GPG configurat la intervalul selectat folosind amprenta fiecărui element GPG care conține doar o cheie publică. Dacă este găsită o cheie publică potrivită, Keyguard actualizează cheia publică stocată, metadatele cheii și starea serverului de chei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока приложение активно и хранилище разблокировано, Keyguard обращается к настроенному серверу ключей GPG с выбранным интервалом, используя отпечаток каждой записи GPG, содержащей только открытый ключ. Если найден соответствующий открытый ключ, Keyguard обновляет сохранённый открытый ключ, метаданные ключа и статус сервера ключей."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Док је апликација активна и трезор откључан, Keyguard контактира ваш подешени GPG сервер кључева у изабраном интервалу користећи отисак сваке GPG ставке која садржи само јавни кључ. Ако се пронађе одговарајући јавни кључ, Keyguard ажурира сачувани јавни кључ, метаподатке кључа и статус сервера кључева."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medan appen är aktiv och valvet är upplåst kontaktar Keyguard din konfigurerade GPG-nyckelserver med det valda intervallet med hjälp av fingeravtrycket för varje GPG-objekt som endast innehåller en offentlig nyckel. Om en matchande offentlig nyckel hittas uppdaterar Keyguard den lagrade offentliga nyckeln, nyckelns metadata och nyckelserverstatusen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While the app is active and the vault is unlocked, Keyguard contacts your configured GPG keyserver at the selected interval using the fingerprint of each GPG item that contains only a public key. If a matching public key is found, Keyguard updates the stored public key, key metadata, and keyserver status."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поки застосунок активний і сховище розблоковане, Keyguard звертається до налаштованого вами сервера ключів GPG із вибраним інтервалом, використовуючи відбиток кожного запису GPG, який містить лише відкритий ключ. Якщо буде знайдено відповідний відкритий ключ, Keyguard оновлює збережений відкритий ключ, метадані ключа та статус сервера ключів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi ứng dụng đang hoạt động và kho đã được mở khóa, Keyguard sẽ liên hệ với máy chủ khóa GPG mà bạn đã cấu hình theo khoảng thời gian đã chọn, sử dụng dấu vân tay của từng mục GPG chỉ chứa khóa công khai. Nếu tìm thấy khóa công khai khớp, Keyguard sẽ cập nhật khóa công khai đã lưu, siêu dữ liệu khóa và trạng thái máy chủ khóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当应用处于活跃状态且密码库已解锁时，Keyguard 会使用每个仅包含公钥的 GPG 条目的指纹，按照选定的时间间隔联系您配置的 GPG 密钥服务器。如果找到匹配的公钥，Keyguard 将更新已存储的公钥、密钥元数据和密钥服务器状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While the app is active and the vault is unlocked, Keyguard contacts your configured GPG keyserver at the selected interval using the fingerprint of each GPG item that contains only a public key. If a matching public key is found, Keyguard updates the stored public key, key metadata, and keyserver status."
          }
        }
      }
    },
