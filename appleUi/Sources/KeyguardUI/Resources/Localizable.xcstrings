        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes enregistrent les instantanés du coffre-fort à l'emplacement que vous choisissez. Keyguard les crée en cas de modification du coffre, et, à tout moment, vous pouvez déclencher un instantané manuellement."
          }
        },
