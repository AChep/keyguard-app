        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een aangewezen intrekking kan niet worden geverifieerd omdat de publieke sleutel van de intrekker niet beschikbaar is. Importeer deze en probeer het opnieuw."
