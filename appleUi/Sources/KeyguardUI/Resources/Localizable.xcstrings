    "emailleak_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uitgelekke rekeningdata kan kwaadwillige daders toegang gee tot sensitiewe persoonlike en finansiële inligting, wat potensieel kan lei tot identiteitsdiefstal, finansiële bedrog, en ander vorme van kubermisdaad."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن أن توفر بيانات الحساب المخترقة للجهات الفاعلة الخبيثة إمكانية الوصول إلى المعلومات الشخصية والمالية الحساسة، مما قد يؤدي إلى سرقة الهوية والاحتيال المالي وأشكال أخرى من الجرائم الإلكترونية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breached account data can provide malicious actors with access to sensitive personal and financial information, potentially leading to identity theft, financial fraud, and other forms of cybercrime."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dades de comptes filtrades poden proporcionar les teves dades personals i financeres a criminals, el qual pot dur a suplantació d'identitat, frau financer i altres formes de ciber-crims."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniklé údaje o účtech mohou škodlivým aktérům poskytnout přístup k citlivým osobním a finančním informacím, což může vést ke krádeži identity, finančním podvodům a dalším formám kyberkriminality."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompromitterede kontodata kan give ondsindede aktører med adgang til sensitive, personlige og finansielle oplysninger, hvilket potentielt kan fører til identitetstyveri, økonomisk svig og andre former for cyberkriminalitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die veröffentlichten Kontodaten können böswilligen Aktoren Zugriff auf vertrauliche persönliche und finanzielle Informationen gewähren, was potenziell zu Identitätsdiebstahl, Finanzbetrug und anderen Formen von Cyberkriminalität führen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breached account data can provide malicious actors with access to sensitive personal and financial information, potentially leading to identity theft, financial fraud, and other forms of cybercrime."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breached account data can provide malicious actors with access to sensitive personal and financial information, potentially leading to identity theft, financial fraud, and other forms of cybercrime."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breached account data can provide malicious actors with access to sensitive personal and financial information, potentially leading to identity theft, financial fraud, and other forms of cybercrime."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breached account data can provide malicious actors with access to sensitive personal and financial information, potentially leading to identity theft, financial fraud, and other forms of cybercrime."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las filtraciones de datos pueden proporcionar a los actores maliciosos acceso a información personal y financiera sensible potencialmente conduciendo a robo de identidad, fraude financiero y otras formas de cibercrimen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breached account data can provide malicious actors with access to sensitive personal and financial information, potentially leading to identity theft, financial fraud, and other forms of cybercrime."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données de compte endommagées peuvent fournir aux acteurs malveillants un accès à des informations personnelles et financières sensibles, pouvant entraîner un vol d'identité, une fraude financière et d'autres formes de cybercriminalité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breached account data can provide malicious actors with access to sensitive personal and financial information, potentially leading to identity theft, financial fraud, and other forms of cybercrime."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A feltört fiókadatok rosszindulatú szereplők számára hozzáférést biztosíthatnak érzékeny személyes és pénzügyi információkhoz, ami személyazonosság-lopáshoz, pénzügyi csaláshoz és a kiberbűnözés más formáihoz vezethet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati degli account violati possono fornire a soggetti malintenzionati l'accesso a informazioni personali e finanziarie sensibili, portando potenzialmente al furto di identità, alla frode finanziaria e ad altre forme di criminalità informatica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "漏洩したアカウントデータは、悪意のある者に機密性の高い個人情報や財務情報へのアクセスを提供し、なりすましや金融詐欺、その他の形態のサイバー犯罪につながる可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정 데이터가 유출되면 민감한 개인 및 금융 정보에 대한 접근 권한을 악성 사용자에게 제공할 수 있으며, 잠재적으로 신원 도용, 금융 사기 및 다른 형태의 사이버 범죄로 이어질 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breached account data can provide malicious actors with access to sensitive personal and financial information, potentially leading to identity theft, financial fraud, and other forms of cybercrime."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelekte accountgegevens kunnen kwaadaardige personen toegang geven tot gevoelige, persoonlijke en financiële informatie. Dit kan leiden tot identiteitsdiefstal, financiële fraude en andere vormen van cybercriminaliteit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzyskane dane o koncie mogą zapewnić podejrzanym podmiotom dostęp do szczególnie chronionych informacji osobowych i finansowych, potencjalnie prowadząc do kradzieży tożsamości, oszustw finansowych i innych form cyberprzestępczości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dados de contas que sofreram vazamento podem fornecer a agentes mal-intencionados acesso a informações pessoais e financeiras confidenciais, o que pode levar a roubo de identidade, fraude financeira e outras formas de crime cibernético."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contas com violação de dados podem fornecer aos agentes maliciosos acesso a informações pessoais e financeiras sensíveis, potencialmente conduzindo a roubo de identidade, fraude financeira e outras formas de ciber-criminalidade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datele din conturi compromise oferă persoanelor rău intenționate acces la informații personale sau financiare importante, putând duce la furt de identitate, fraude și alte fapte ilicite pe internet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скомпрометированные учетные записи могут предоставить злоумышленникам доступ к вашим персональным и финансовым данным, что подвергает вас риску кражи личных данных, финансовому мошенничеству и другим формам киберпреступлений."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breached account data can provide malicious actors with access to sensitive personal and financial information, potentially leading to identity theft, financial fraud, and other forms of cybercrime."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breached account data can provide malicious actors with access to sensitive personal and financial information, potentially leading to identity theft, financial fraud, and other forms of cybercrime."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İhlal edilmiş hesap verileri; kötü niyetli kişilerin hassas kişisel ve finansal bilgilere erişim sağlamasına neden olabilir ve bu durum kimlik hırsızlığı, finansal dolandırıcılık ve diğer siber suç türlerine zemin hazırlayabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скомпрометовані облікові записи можуть надати зловмисникам доступ до ваших персональних та фінансових даних, що наражає вас на ризик крадіжки ідентичності, фінансового шахрайства та інших форм кіберзлочинності."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu từ tài khoản bị rò rỉ có thể cấp quyền cho kẻ xấu truy cập thông tin cá nhân và thông tin tài chính nhạy cảm, từ đó có thể dẫn đến việc thông tin bị đánh cắp, giả mạo tài chính, và các loại hình tội phạm mạng khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被泄露的账户数据可让恶意行为者获取敏感的个人和财务信息，从而可能导致身份盗用、财务欺诈和其他形式的网络犯罪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被洩露的帳號資料可讓惡意行為者獲取敏感的個人和財務資訊，從而可能導致身份盜用、財務欺詐和其他形式的網路犯罪。"
          }
        }
      }
    },
