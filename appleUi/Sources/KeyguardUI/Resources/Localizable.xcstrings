    "generator_email_catch_all_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'n Vang-al-e-posadres bied gebruikers die opsie om alle pos te ontvang wat na hul domein gestuur word, selfs as dit na 'n e-posadres gestuur is wat nie vir hul domein opgestel is nie. Maak seker dat jou e-posgasheer hierdie funksie ondersteun voordat jy dit gebruik."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوفر عنوان البريد الإلكتروني لاستقبال الرسائل الخاطئة للمستخدمين خيار تلقي كل رسائل البريد المرسلة إلى نطاقهم، حتى إذا تم إرسالها إلى عنوان بريد إلكتروني لم يتم إعداده لنطاقهم. تأكد من أن استضافة البريد الإلكتروني لديك تدعم هذه الميزة قبل استخدامها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A catch-all email address provides users the option to receive all mail sent to their domain, even if they are sent to an email address that has not been set up for their domain. Ensure that your email hosting supports this feature before using it."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una adreça de correu de captura total dona l'opció als usuaris de rebre tot el correu electrònic que s'enviï al seu domini, inclús si s'envia a una adreça de correu que no ha sigut configurada per al domini. Assegura't que el teu proveïdor suporta aquesta funció abans de fer-la servir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Záchytná e-mailová adresa poskytuje uživatelům možnost získávat všechny e-maily odeslané na jejich doménu, i když jsou odeslány na adresu, která zatím u jejich domény nebyla nastavena. Před použitím této funkce se ujistěte, že ji váš poskytovatel e-mailového hostingu podporuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fang-alle e-mailadresse giver brugerne mulighed for at modtage alle mails sendt til deres domæne, selv om de er sendt til en e-mailadresse, der ikke er blevet opsat til deres domæne. Sørg for, at e-mail hosteren understøtter denne funktion, før den bruges."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine \"Catch-All-E-Mail-Adresse\" bietet Benutzern die Möglichkeit, alle E-Mails an ihre Domain zu erhalten, auch wenn sie an eine E-Mail-Adresse gesendet werden, die nicht für ihre Domain eingerichtet wurde. Stellen Sie sicher, dass Ihr E-Mail-Hosting diese Funktion unterstützt, bevor Sie sie verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A catch-all email address provides users the option to receive all mail sent to their domain, even if they are sent to an email address that has not been set up for their domain. Ensure that your email hosting supports this feature before using it."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A catch-all email address provides users the option to receive all mail sent to their domain, even if they are sent to an email address that has not been set up for their domain. Ensure that your email hosting supports this feature before using it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A catch-all email address provides users the option to receive all mail sent to their domain, even if they are sent to an email address that has not been set up for their domain. Ensure that your email hosting supports this feature before using it."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A catch-all email address provides users the option to receive all mail sent to their domain, even if they are sent to an email address that has not been set up for their domain. Ensure that your email hosting supports this feature before using it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una dirección de correo catch-all proporciona a los usuarios la opción de recibir todo el correo enviado a su dominio, incluso si se envían a una dirección de correo electrónico que no ha sido configurada para su dominio. Asegúrate de que tu alojamiento de correo electrónico soporta esta característica antes de usarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A catch-all email address provides users the option to receive all mail sent to their domain, even if they are sent to an email address that has not been set up for their domain. Ensure that your email hosting supports this feature before using it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une adresse mail catch-all donne aux utilisateurs la possibilité de recevoir tous les messages envoyés à leur domaine, même si elles sont envoyées à une adresse e-mail qui n'a pas été configurée pour leur domaine. Assurez-vous que votre hébergement de courriel prend en charge cette fonctionnalité avant de l'utiliser."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A catch-all email address provides users the option to receive all mail sent to their domain, even if they are sent to an email address that has not been set up for their domain. Ensure that your email hosting supports this feature before using it."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gyűjtő e-mail cím lehetővé teszi a felhasználók számára, hogy minden, a domainjükre küldött e-mailt megkapjanak, még akkor is, ha azokat olyan e-mail címre küldték, amelyet nem állítottak be a domainjükhöz. Mielőtt használná, győződjön meg róla, hogy az e-mail tárhelyszolgáltatója támogatja ezt a funkciót."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un indirizzo email catch-all offre agli utenti la possibilità di ricevere tutte le email inviate al proprio dominio, anche se inviate a un indirizzo e-mail che non è stato configurato per il proprio dominio. Prima dell'utilizzo assicurati che il tuo servizio di hosting email supporti questa funzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャッチオールメールアドレスは、ドメインに送信されたすべてのメールを受信できるメールアドレスです。使用する前に、メールホスティングがこの機能をサポートしていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catch-all 이메일 주소를 사용하면 이메일 설정에 관계없이 도메인으로 오는 모든 이메일을 받을 수 있습니다. 사용하기 전에 이메일 호스팅 제공 업체에서 이 기능을 지원하는지 확인해 보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A catch-all email address provides users the option to receive all mail sent to their domain, even if they are sent to an email address that has not been set up for their domain. Ensure that your email hosting supports this feature before using it."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een catch-all e-mailadres biedt gebruikers de mogelijkheid om alle e-mails te ontvangen die naar hun domein zijn verzonden. Zelfs als ze worden verzonden naar een e-mailadres dat niet is ingesteld voor hun domein. Zorg ervoor dat de e-mail hosting deze functie ondersteunt voordat je deze gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A catch-all email address provides users the option to receive all mail sent to their domain, even if they are sent to an email address that has not been set up for their domain. Ensure that your email hosting supports this feature before using it."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um endereço de e-mail catch-all oferece aos usuários a opção de receber todos os e-mails enviados para seu domínio, mesmo se eles forem enviados para um endereço de e-mail que não tenha sido configurado para seu domínio. Certifique-se de que sua hospedagem de e-mail suporta este recurso antes de usá-lo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um endereço de e-mail catch-all oferece aos utilizadores a opção de receber todos os e-mails enviados para o seu domínio, mesmo se eles forem enviados para um endereço de e-mail que não tenha sido configurado para o seu domínio. Certifique-se de que o provedor de e-mail suporta este recurso antes de usá-lo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A catch-all email address provides users the option to receive all mail sent to their domain, even if they are sent to an email address that has not been set up for their domain. Ensure that your email hosting supports this feature before using it."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Универсальный адрес электронной почты предоставляет пользователям возможность получать всю почту, отправляемую на их домен, даже если она отправляется на адрес электронной почты, который не был настроен для их домена. Убедитесь, что ваш почтовый хостинг поддерживает эту функцию, прежде чем использовать её."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A catch-all email address provides users the option to receive all mail sent to their domain, even if they are sent to an email address that has not been set up for their domain. Ensure that your email hosting supports this feature before using it."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A catch-all email address provides users the option to receive all mail sent to their domain, even if they are sent to an email address that has not been set up for their domain. Ensure that your email hosting supports this feature before using it."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tümünü yakala e-posta adresi (catch-all), kullanıcılara alan adları için ayarlanmamış bir e-posta adresine gönderilmiş olsa bile alan adlarına gönderilen tüm postaları alma seçeneği sunar. Bu özelliği kullanmadan önce e-posta barındırıcınızın bunu desteklediğinden emin olun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адреса електронної пошти catch-all надає користувачам можливість отримувати повідомлення, надіслані на їхній домен, навіть якщо вони надсилаються на адресу електронної пошти, яка не була налаштована для їх домену. Перед використанням переконайтеся, що ваш хостинг електронної пошти підтримує цю функцію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một địa chỉ email nhận-hết cung cấp cho người dùng tùy chọn nhận tất cả thư được gửi đến tên miền của họ, ngay cả khi chúng được gửi đến địa chỉ email chưa được thiết lập cho tên miền của họ. Đảm bảo rằng dịch vụ lưu trữ email của bạn hỗ trợ tính năng này trước khi sử dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catch-all 电子邮件地址可让用户选择接收发送到其域名的所有邮件，即使这些邮件是发送到未为其域名设置的电子邮件地址。使用前请确保您的电子邮件主机支持此功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catch-all 電子郵件地址可讓使用者選擇接收發送到其域名的所有郵件，即使這些郵件是傳送到未為其域名設定的電子郵件地址。使用前請確保您的電子郵件主機支援此功能。"
          }
        }
      }
    },
