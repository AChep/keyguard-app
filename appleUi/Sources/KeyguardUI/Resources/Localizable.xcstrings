        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will restore the default navigation order and visibility. Custom filters are not deleted, but their navigation items will be removed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden die Standardreihenfolge und -sichtbarkeit der Navigation wiederhergestellt. Benutzerdefinierte Filter werden nicht gelöscht, aber ihre Navigationselemente werden entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will restore the default navigation order and visibility. Custom filters are not deleted, but their navigation items will be removed."
