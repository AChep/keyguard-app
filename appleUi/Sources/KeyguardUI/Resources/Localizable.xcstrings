        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The device doesn't support retrieval of user credentials via integration with credential providers. Contact the manufacturer for more information."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The device doesn't support retrieval of user credentials via integration with credential providers. Contact the manufacturer for more information."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cihaz, kimlik bilgisi sağlayıcıları ile entegrasyon yoluyla kullanıcı kimlik bilgilerinin alınmasını desteklemiyor. Daha fazla bilgi için üreticiyle iletişime geçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пристрій не підтримує інтеграцію з постачальниками облікових даних. Щоб дізнатися більше, зверніться до виробника."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiết bị không hỗ trợ truy xuất thông tin xác thực của người dùng thông qua tích hợp với nhà cung cấp thông tin xác thực. Liên hệ với nhà sản xuất để biết thêm thông tin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备不支持通过与凭据管理器集成以检索用户凭据。请联系制造商获取更多信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裝置不支援通過與憑據管理器整合以檢索使用者憑據。請聯絡製造商獲取更多資訊。"
          }
        }
      }
    },
