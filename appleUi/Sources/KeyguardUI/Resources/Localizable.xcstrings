    "pref_item_yubikey_unlock_confirm_message_configured" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleuf %1$@ is reeds gekonfigureer. Hervoorvoorsiening vereis USB verbinding en oorskryf die huidige gleufkonfigurasie."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الفتحة %1$@ مكونة مسبقًا. إعادة التكوين تتطلب اتصال USB وستحل محل تكوين الفتحة الحالية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slot %1$@ is already configured. Re-provisioning overwrites the current slot configuration."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slot %1$@ is already configured. Re-provisioning overwrites the current slot configuration."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slot %1$@ je již konfigurován. Během nové konfigurace se provede přepis té původní; navíc vyžaduje zapojení zařízení skrze USB."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slot %1$@ is al geconfigureerd. Opnieuw configureren vereist een USB-verbinding en overschrijft de huidige slotconfiguratie."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slot %1$@ ist bereits konfiguriert. Die Neukonfiguration erfordert eine USB-Verbindung und überschreibt die aktuelle Slot-Konfiguration."
          }
        },
        "el" : {
