    "pref_item_require_app_password_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bykomend tot jou gewone sekuriteitsinstellings, sal jou toepwagwoord vereis word ná hierdie tyd of wanneer biometrie-instellings verander word"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بالإضافة إلى إعدادات الأمان المعتادة، ستتم مطالبتك بكلمة مرور التطبيق بعد هذا الوقت أو عند تغيير إعدادات القياسات الحيوية"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In addition to your regular security settings, your app password will be required after this time or when biometry settings are changed"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A més de la teva configuració de seguretat habitual, la teva contrasenya de l'app serà requerida després d'aquest temps, o quan es canviï la configuració de biometria"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kromě běžného nastavení zabezpečení bude po uplynutí této doby nebo při změně nastavení biometrie vyžadováno heslo aplikace"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ud over de almindelige sikkerhedsindstillinger kræves app-adgangskoden efter dette tidspunkt, eller når biometriindstillinger ændres"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zusätzlich zu Ihren regulären Sicherheitseinstellungen wird Ihr App-Passwort nach dieser Zeit oder wenn Biometrieeinstellungen geändert werden angefordert"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In addition to your regular security settings, your app password will be required after this time or when biometry settings are changed"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In addition to your regular security settings, your app password will be required after this time or when biometry settings are changed"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In addition to your regular security settings, your app password will be required after this time or when biometry settings are changed"
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In addition to your regular security settings, your app password will be required after this time or when biometry settings are changed"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Además de sus ajustes de seguridad regulares, su contraseña de la aplicación será requerida después de este momento o cuando se cambien los ajustes de la biometría"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavallisten turvallisuusasetustesi lisäksi sovelluksen salasana vaaditaan tämän ajan kuluttua tai kun biometriasetuksia muutetaan"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En plus de vos paramètres de sécurité habituels, le mot de passe de votre application sera requis après ce temps ou lorsque les paramètres de la biométrie seront modifiés"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In addition to your regular security settings, your app password will be required after this time or when biometry settings are changed"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szokásos biztonsági beállításokon túlmenően az alkalmazás jelszavára is szükség lesz ezen idő letelte után, vagy ha módosítják a biometrikus beállításokat"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oltre alle impostazioni di sicurezza regolari, la password dell'app sarà richiesta dopo questo periodo o quando le impostazioni biometriche vengono modificate"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常のセキュリティ設定に加えて、この期間の経過後または生体認証の設定が変更された場合は、アプリのパスワードが必要になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생체 정보 설정을 변경한 뒤에 앱 비밀번호를 추가로 요청합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In addition to your regular security settings, your app password will be required after this time or when biometry settings are changed"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naast de normale beveiligingsinstellingen is het app-wachtwoord vereist na deze tijd of wanneer de biometrische instellingen zijn gewijzigd"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In addition to your regular security settings, your app password will be required after this time or when biometry settings are changed"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Além das configurações de segurança normais, a senha do aplicativo será exigida após esse período ou quando as configurações de biometria forem alteradas"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Além das configurações de segurança normais, a palavra-passe da aplicação será exigida após este tempo ou quando as configurações de biometria forem alteradas"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In addition to your regular security settings, your app password will be required after this time or when biometry settings are changed"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В дополнение к вашим обычным настройкам безопасности, после этого времени или при изменении настроек биометрии потребуется пароль приложения"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In addition to your regular security settings, your app password will be required after this time or when biometry settings are changed"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In addition to your regular security settings, your app password will be required after this time or when biometry settings are changed"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal güvenlik ayarlarınıza ek olarak, uygulama parolanız bu süreden sonra veya biyometri ayarları değiştirildiğinde gerekli olacaktır"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На додачу до стандартних налаштувань безпеки, після цього часу або після зміни налаштувань біометрії, буде необхідно повторно ввести пароль застосунку"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngoài thiết đặt bảo mật thông thường, mật khẩu ứng dụng của bạn sẽ được yêu cầu sau thời gian này hoặc khi thiết đặt sinh trắc học được thay đổi"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除了常规的安全设置外，您的应用专用密码将在这段时间后或生物识别设置更改时被请求键入"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除了常規的安全設定外，您的應用專用密碼將在這段時間後或生物識別設定更改時被請求鍵入"
          }
        }
      }
    },
