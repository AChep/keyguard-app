    "addsend_max_access_count_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indien gestel, sal gebruikers nie meer toegang tot hierdie item kan kry nadat die maksimum toegangtelling bereik is nie."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا تم تعيينه، فلن يتمكن المستخدمون من الوصول إلى هذا العنصر بعد الوصول إلى الحد الأقصى لعدد الوصول."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If set, users will no longer be able to access this item after the maximum access count is reached."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si s’estableix, els usuaris ja no podran accedir a aquest element una vegada s’assoleixi el nombre màxim d’accessos."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud je nastaveno, bude uživatelům zakázán přístup k této položce po dosažení maximálního počtu přístupů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis indstillet, vil brugere ikke længere kunne tilgå dette emne, når det maksimale adgangsantal er nået."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
