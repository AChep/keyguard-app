    "gpg_agent_setup_step_2_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Run GnuPG commands from a shell that points to Keyguard's agent home. Keyguard listens on the agent socket that GnuPG resolves for this home."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل أوامر GnuPG من صدفة تشير إلى مجلد وكيل Keyguard. يستمع Keyguard إلى مقبس الوكيل الذي يحلّه GnuPG لهذا المجلد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Run GnuPG commands from a shell that points to Keyguard's agent home. Keyguard listens on the agent socket that GnuPG resolves for this home."
          }
        },
        "ca" : {
          "stringUnit" : {
