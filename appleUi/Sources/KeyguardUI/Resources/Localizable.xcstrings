    "pref_item_ssh_agent_local_storage_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the SSH agent is on, Keyguard keeps unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تشغيل وكيل SSH، يحتفظ Keyguard بنسخة غير مشفّرة من المفاتيح العامة على القرص حتى يتمكن العملاء من عرض المفاتيح أثناء قفل الخزنة. لا تُكشف المفاتيح الخاصة أبدًا؛ ولا تُخزَّن أسماء المفاتيح إلا إذا فعّلت الخيار المقابل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the SSH agent is on, Keyguard keeps unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the SSH agent is on, Keyguard keeps unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the SSH agent is on, Keyguard keeps unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the SSH agent is on, Keyguard keeps unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn der SSH-Agent aktiviert ist, bewahrt Keyguard eine unverschlüsselte Kopie der öffentlichen Schlüssel auf der Festplatte auf, damit Clients die Schlüssel auflisten können, während der Tresor gesperrt ist. Private Schlüssel werden niemals offengelegt; Schlüsselnamen werden nur gespeichert, wenn Sie die entsprechende Option aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the SSH agent is on, Keyguard keeps unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the SSH agent is on, Keyguard keeps unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the SSH agent is on, Keyguard keeps unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the SSH agent is on, Keyguard keeps unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the SSH agent is on, Keyguard keeps unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the SSH agent is on, Keyguard keeps unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque l'agent SSH est activé, Keyguard conserve une copie non chiffrée des clés publiques sur le disque afin que les clients puissent lister les clés lorsque le coffre-fort est verrouillé. Les clés privées ne sont jamais exposées ; les noms des clés ne sont stockés que si vous activez l'option correspondante."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the SSH agent is on, Keyguard keeps unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha az SSH ügynök be van kapcsolva, a Keyguard egy titkosítatlan másolatot tart a nyilvános kulcsokról a lemezen, hogy a kliensek listázhassák a kulcsokat a széf zárolt állapotában is. A privát kulcsok soha nem kerülnek kiadásra; a kulcsok nevei csak akkor kerülnek mentésre, ha engedélyezi a megfelelő opciót."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the SSH agent is on, Keyguard keeps unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the SSH agent is on, Keyguard keeps unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the SSH agent is on, Keyguard keeps unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the SSH agent is on, Keyguard keeps unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the SSH agent is on, Keyguard keeps unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the SSH agent is on, Keyguard keeps unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o agente SSH está ativo, o Keyguard mantém uma cópia não criptografada das chaves públicas em disco para que os clientes possam listá-las enquanto o cofre está bloqueado. As chaves privadas nunca são expostas; os nomes das chaves só são armazenados se você ativar a opção correspondente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o agente SSH está ativo, o Keyguard mantém uma cópia não encriptada das chaves públicas no disco, permitindo aos clientes listar as chaves mesmo com o cofre bloqueado. As chaves privadas nunca são expostas, os nomes das chaves são armazenados apenas se ativar a opção correspondente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the SSH agent is on, Keyguard keeps unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда SSH-агент включён, Keyguard хранит на диске незашифрованную копию открытых ключей, чтобы клиенты могли получать список ключей, пока хранилище заблокировано. Закрытые ключи никогда не раскрываются; названия ключей хранятся только если вы включите соответствующую опцию."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the SSH agent is on, Keyguard keeps unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the SSH agent is on, Keyguard keeps unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the SSH agent is on, Keyguard keeps unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли SSH-агент увімкнено, Keyguard зберігає незашифровану копію відкритих ключів на диску, щоб клієнти могли отримувати список ключів, поки сховище заблоковане. Закриті ключі ніколи не розкриваються; назви ключів зберігаються лише якщо ви ввімкнете відповідну опцію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the SSH agent is on, Keyguard keeps unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 SSH 代理开启时，Keyguard 会在磁盘上保留公钥的未加密副本，以便客户端在密码库锁定时也能列出密钥。私钥绝不会泄露；只有在您开启相应选项后，系统才会存储密钥名称。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the SSH agent is on, Keyguard keeps unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        }
      }
    },
