        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sottochiave non può rimanere utilizzabile dopo la scadenza della chiave primaria. Seleziona anche la chiave primaria oppure scegli una scadenza precedente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブキーはプライマリキーの有効期限が切れた後は使用できません。プライマリキーも選択するか、より早い有効期限を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하위 키는 기본 키가 만료된 후에는 사용할 수 없습니다. 기본 키도 함께 선택하거나 더 이른 만료일을 선택하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En undernøkkel kan ikke forbli brukbar etter at primærnøkkelen utløper. Velg primærnøkkelen også, eller velg et tidligere utløp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een subsleutel kan niet bruikbaar blijven nadat de primaire sleutel is verlopen. Selecteer ook de primaire sleutel of kies een eerdere vervaldatum."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podklucz nie może pozostać użyteczny po wygaśnięciu klucza głównego. Zaznacz również klucz główny lub wybierz wcześniejszą datę ważności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma subchave não pode permanecer utilizável depois que a chave primária expirar. Selecione também a chave primária ou escolha uma validade anterior."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma sub-chave não pode permanecer utilizável após a expiração da chave primária. Selecione também a chave primária ou escolha uma data de expiração anterior."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O subcheie nu poate rămâne utilizabilă după ce expiră cheia principală. Selectează și cheia principală sau alege o dată de expirare mai devreme."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключ не может оставаться пригодным к использованию после истечения срока действия основного ключа. Выберите также основной ключ или задайте более ранний срок действия."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подкључ не може остати употребљив након истека примарног кључа. Изаберите и примарни кључ или изаберите ранији датум истека."
          }
        },
        "sv" : {
          "stringUnit" : {
