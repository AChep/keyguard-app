    "watchtower_item_trashed_items_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items wat na die asblik geskuif is. As daar te veel items in die asblik is, kan dit bewerkings in jou kluis vertraag."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العناصر التي تم نقلها إلى سلة المهملات. قد يؤدي وجود عدد كبير جدًا من العناصر في سلة المهملات إلى إبطاء العمليات في مخزنك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items that have been moved into the trash. Having too many items in the trash may slow down operations with your vault."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elements que s'han mogut a la papereta. Tindre molts elements a la paperera pot endarrerir les operacions amb la teva caixa forta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Položky, které byly přesunuty do koše. Příliš mnoho položek v koši může zpomalit operace s vaším trezorem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emner, som er flyttet til papirkurven. For mange emner i papirkurven kan operationer med boksen langsommere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elemente, die in den Papierkorb verschoben wurden. Wenn sich zu viele Elemente im Papierkorb befinden, kann dies den Betrieb des Tresors verlangsamen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items that have been moved into the trash. Having too many items in the trash may slow down operations with your vault."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items that have been moved into the trash. Having too many items in the trash may slow down operations with your vault."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items that have been moved into the bin. Having too many items in the bin may slow down operations with your vault."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items that have been moved into the trash. Having too many items in the trash may slow down operations with your vault."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elementos que se han movido a la papelera. Tener muchos elementos en la papelera puede ralentizar las operaciones con tu caja fuerte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kohteet, jotka on siirretty roskakoriin. Liian monen kohteen pitäminen roskakorissa voi hidastaa holvin toimintoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments qui ont été déplacés dans la corbeille. Avoir trop d'éléments dans la corbeille peut ralentir les opérations dans votre coffre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items that have been moved into the trash. Having too many items in the trash may slow down operations with your vault."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lomtárba helyezett elemek. Ha túl sok elem van a lomtárban, lelassulhat a széf működése."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elementi che sono stati spostati nel cestino. Avere troppi oggetti nel cestino può rallentare le operazioni con la cassaforte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ごみ箱に移動されたアイテムです。ごみ箱にアイテムが多すぎると、保管庫の操作が遅くなることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴지통으로 간 항목입니다. 휴지통에 항목이 너무 많으면 보관함이 느려질 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items that have been moved into the trash. Having too many items in the trash may slow down operations with your vault."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voorwerpen die naar de prullenbak zijn verplaatst. Te veel voorwerpen in de prullenbak kunnen de reactietijd van je kluis verlagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elementy, które zostały przeniesione do kosza. Posiadanie zbyt wielu elementów w koszu może spowolnić działanie sejfu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itens que foram movidos para a lixeira. O excesso de itens na lixeira pode atrasar as operações do seu cofre."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dados que foram movidos para a reciclagem. Ter muitos dados na reciclagem pode reduzir a velocidade nas operações com o seu cofre."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informațiile eliminate. Un volum prea înalt reținut necurățat acolo în gunoi poate duce la o funcționare un pic mai lentă a seifului tău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи, которые были перемещены в корзину. Слишком большое количество записей в корзине может замедлить операции с хранилищем."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items that have been moved into the trash. Having too many items in the trash may slow down operations with your vault."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objekt som har flyttats till papperskorgen. Om du har för många objekt i papperskorgen kan det sakta ner driften av ditt valv."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çöp kutusuna taşınmış ögeler. Çöpte çok fazla ögenin bulunması kasanızla ilgili işlemleri yavaşlatabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи які були переміщенні в кошик. Забагато записів в кошику може сповільнити операції зі сховищем."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các mục đã được dời vô sọt rác. Việc có quá nhiều mục trong sọt rác có thể làm chậm hoạt động của kho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已移入回收站的条目，回收站中的物品过多可能会减慢密码库的运行速度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已移入回收站的專案，回收站中的物品過多可能會減慢密碼庫的執行速度。"
          }
        }
      }
    },
