    "pref_item_license_sync_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifies your active store purchase and generates an entitlement token bound to the purchase. Use the token to transfer the purchase to your other devices."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحقق من عملية شرائك النشطة في المتجر وينشئ رمز استحقاق مرتبطًا بالشراء. استخدم الرمز لنقل الشراء إلى أجهزتك الأخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifies your active store purchase and generates an entitlement token bound to the purchase. Use the token to transfer the purchase to your other devices."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifies your active store purchase and generates an entitlement token bound to the purchase. Use the token to transfer the purchase to your other devices."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifies your active store purchase and generates an entitlement token bound to the purchase. Use the token to transfer the purchase to your other devices."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifies your active store purchase and generates an entitlement token bound to the purchase. Use the token to transfer the purchase to your other devices."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüft Ihren aktiven Store-Kauf und erstellt einen an den Kauf gebundenen Berechtigungscode. Verwenden Sie diesen Code, um den Kauf auf Ihre anderen Geräte zu übertragen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifies your active store purchase and generates an entitlement token bound to the purchase. Use the token to transfer the purchase to your other devices."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifies your active store purchase and generates an entitlement token bound to the purchase. Use the token to transfer the purchase to your other devices."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifies your active store purchase and generates an entitlement token bound to the purchase. Use the token to transfer the purchase to your other devices."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifies your active store purchase and generates an entitlement token bound to the purchase. Use the token to transfer the purchase to your other devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica su compra activa en la tienda y genera un código de titularidad vinculado a la compra. Use este código para transferir la compra a sus otros dispositivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifies your active store purchase and generates an entitlement token bound to the purchase. Use the token to transfer the purchase to your other devices."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie votre achat actif dans la boutique et génère un jeton de droits lié à cet achat. Utilisez le jeton pour transférer l'achat vers vos autres appareils."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifies your active store purchase and generates an entitlement token bound to the purchase. Use the token to transfer the purchase to your other devices."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ellenőrzi az aktív áruházi vásárlását, és egy ahhoz kötött jogosultsági tokent generál. A tokennel átviheti a vásárlást a többi eszközére."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica il tuo acquisto attivo nello store e genera un codice di licenza associato all'acquisto. Usa questo codice per trasferire l'acquisto sugli altri tuoi dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクティブなストアの購入を検証し、その購入に紐付いた利用権コードを生成します。このコードを使用して、購入を他のデバイスに移行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스토어의 활성 구매 내역을 확인하고 해당 구매에 연결된 이용 권한 코드를 생성합니다. 이 코드를 사용하여 다른 기기로 구매를 이전할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifiserer ditt aktive butikkjøp og genererer et rettighetskode knyttet til kjøpet. Bruk koden til å overføre kjøpet til dine andre enheter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifieert je actieve winkelaankoop en genereert een rechtencode die aan de aankoop is gekoppeld. Gebruik deze code om de aankoop over te zetten naar je andere apparaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weryfikuje aktywny zakup w sklepie i generuje kod uprawnień powiązany z tym zakupem. Użyj tego kodu, aby przenieść zakup na inne urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica sua compra ativa na loja e gera um token de titularidade vinculado à compra. Use o token para transferir a compra para seus outros dispositivos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificar a sua compra ativa na loja e gerar um token de autorização ligado à compra. Utilize o token para transferir a compra para os seus outros dispositivos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifică achiziția ta activă din magazin și generează un cod de drept de acces asociat achiziției. Folosește codul pentru a transfera achiziția pe celelalte dispozitive."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверяет вашу активную покупку в магазине и создаёт код подтверждения прав, привязанный к покупке. Используйте этот код, чтобы перенести покупку на другие ваши устройства."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Верификује вашу активну куповину у продавници и генерише код за потврду права везан за куповину. Користите тај код да пренесете куповину на своје друге уређаје."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifierar ditt aktiva butiksköp och genererar en rättighetskod som är kopplad till köpet. Använd denna kod för att överföra köpet till dina andra enheter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifies your active store purchase and generates an entitlement token bound to the purchase. Use the token to transfer the purchase to your other devices."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевіряє вашу активну покупку в магазині та генерує код підтвердження права доступу, прив'язаний до покупки. Використовуйте цей код, щоб перенести покупку на інші ваші пристрої."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xác minh giao dịch mua đang hoạt động trên cửa hàng của bạn và tạo một mã quyền sử dụng gắn với giao dịch mua đó. Dùng mã để chuyển giao dịch mua sang các thiết bị khác của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "验证您有效的商店购买记录，并生成一个与该购买绑定的授权令牌。使用此令牌可将购买状态转移到您的其他设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifies your active store purchase and generates an entitlement token bound to the purchase. Use the token to transfer the purchase to your other devices."
          }
        }
      }
    },
