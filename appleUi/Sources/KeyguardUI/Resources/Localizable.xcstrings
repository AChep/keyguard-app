    "fido2webauthn_bitwarden_web_vault_version_warning_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gebruik van FIDO2 WebAuthn vereis die gebruik van die Bitwarden Web Vault weergawe %1$@ of hoër. Op ouer weergawes sal die verifikasie-resultaat verkeerdelik na die amptelike Bitwarden-toep aagestuur word."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب استخدام FIDO2 WebAuthn إصدار قبو الويب Bitwarden %1$@ أو أعلى. في الإصدارات القديمة، سيتم توجيه نتيجة المصادقة بشكل غير صحيح إلى تطبيق Bitwarden الرسمي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using FIDO2 WebAuthn requires using the Bitwarden Web vault version %1$@ or higher. On older versions the authentication result will incorrectly be forwarded to the official Bitwarden app."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fer servir WebAuthn FIDO2 necessita una versió de Bitwarden web igual o major a %1$@. En versions més antigues no s'interpreta correctament el resultat de l'autenticació i se't redirigirà a l'aplicació oficial de Bitwarden."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použití FIDO2 WebAuthn vyžaduje použití Bitwarden Web verze %1$@ nebo novější. Na starších verzích bude výsledek ověření nesprávně přesměrován do oficiální aplikace Bitwarden."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug af FIDO2 WebAuthn kræver minimum Bitwarden Web-boks version %1$@. På ældre versioner videresendes godkendelsesresultatet fejlagtigt til den officielle Bitwarden-app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verwendung von FIDO2 WebAuthn erfordert die Verwendung der Bitwarden Web Tresor Version %1$@ oder höher. Bei älteren Versionen wird das Authentifizierungsergebnis fälschlicherweise an die offizielle Bitwarden App weitergeleitet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using FIDO2 WebAuthn requires using the Bitwarden Web vault version %1$@ or higher. On older versions the authentication result will incorrectly be forwarded to the official Bitwarden app."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using FIDO2 WebAuthn requires using the Bitwarden Web vault version %1$@ or higher. On older versions the authentication result will incorrectly be forwarded to the official Bitwarden app."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using FIDO2 WebAuthn requires using the Bitwarden Web vault version %1$@ or higher. On older versions the authentication result will incorrectly be forwarded to the official Bitwarden app."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using FIDO2 WebAuthn requires using the Bitwarden Web vault version %1$@ or higher. On older versions the authentication result will incorrectly be forwarded to the official Bitwarden app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar WebAuthn de FIDO2 requiere usar la caja fuerte de Bitwarden Web %1$@ o superior. En versiones anteriores el resultado de autenticación será reenviado incorrectamente a la aplicación oficial de Bitwarden."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using FIDO2 WebAuthn requires using the Bitwarden Web vault version %1$@ or higher. On older versions the authentication result will incorrectly be forwarded to the official Bitwarden app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'utilisation de WebAuthn FIDO2 nécessite l'utilisation de la version du coffre Web de Bitwarden %1$@ ou supérieure. Sur les anciennes versions, le résultat d'authentification sera incorrectement transmis à l'application officielle Bitwarden."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using FIDO2 WebAuthn requires using the Bitwarden Web vault version %1$@ or higher. On older versions the authentication result will incorrectly be forwarded to the official Bitwarden app."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A FIDO2 WebAuthn használatához a Bitwarden Webes széf %1$@ vagy magasabb verziója szükséges. A régebbi verziók esetén a hitelesítési eredmény helytelenül kerül továbbításra a hivatalos Bitwarden alkalmazáshoz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'utilizzo di FIDO2 WebAuthn richiede l'utilizzo della versione %1$@ della cassaforte Web Bitwarden o superiore. Nelle versioni precedenti il risultato dell'autenticazione verrà inoltrato in modo errato all'app ufficiale Bitwarden."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIDO2 WebAuthn を使用するには、Butwarden ウェブ保管庫バージョン %1$@ 以上を使用する必要があります。古いバージョンでは、認証の結果が誤って公式の Bitwarden アプリに転送されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIDO2 WebAuthn을 사용하려면 Bitwarden 웹 보관함 %1$@ 버전 이상이 필요합니다. 이 버전보다 낮을 경우 인증 결과가 Bitwarden 공식 앱에 잘못 전달될 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using FIDO2 WebAuthn requires using the Bitwarden Web vault version %1$@ or higher. On older versions the authentication result will incorrectly be forwarded to the official Bitwarden app."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIDO2 WebAuthn vereist versie %1$@ of hoger van de Bitwarden Web kluis. Op oudere versies wordt het verificatieresultaat verkeerd doorgestuurd naar de officiële Bitwarden-app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używanie FIDO2 WebAuthn wymaga użycia sejfu internetowego Bitwarden w wersji %1$@ lub wyższej. W starszych wersjach wynik uwierzytelniania zostanie niepoprawnie przekazany do oficjalnej aplikacji Bitwarden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar FIDO2 WebAuthn requer usar a versão Web do cofre Bitwarden %1$@ ou superior. Em versões mais antigas, o resultado da autenticação será encaminhado incorretamente para o aplicativo oficial Bitwarden."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar FIDO2 WebAuthn requer usar a versão web do cofre Bitwarden %1$@ ou superior. Em versões mais antigas, a autenticação será incorretamente encaminhado para o aplicativo oficial do Bitwarden."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using FIDO2 WebAuthn requires using the Bitwarden Web vault version %1$@ or higher. On older versions the authentication result will incorrectly be forwarded to the official Bitwarden app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для использования FIDO2 WebAuthn необходимо использовать веб-хранилище Bitwarden версии %1$@ или новее. В более старых версиях результат аутентификации будет ошибочно перенаправлен в официальное приложение Bitwarden."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using FIDO2 WebAuthn requires using the Bitwarden Web vault version %1$@ or higher. On older versions the authentication result will incorrectly be forwarded to the official Bitwarden app."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using FIDO2 WebAuthn requires using the Bitwarden Web vault version %1$@ or higher. On older versions the authentication result will incorrectly be forwarded to the official Bitwarden app."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FIDO2 WebAuthn kullanmak için Bitwarden Web kasasının %1$@ veya daha yeni bir sürümü kullanılmalıdır. Eski sürümlerde kimlik doğrulama sonucu yanlışlıkla resmi Bitwarden uygulamasına iletilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для використання FIDO2 WebAuthn необхідно мати версію вебсховища Bitwarden %1$@ або новішу. В старіших версіях результат автентифікації буде помилково відправлений в офіційний застосунок Bitwarden."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc sử dụng FIDO2 WebAuthn yêu cầu sử dụng phiên bản Bitwarden kho Web %1$@ hoặc cao hơn. Trên các phiên bản cũ hơn, kết quả xác thực sẽ được chuyển tiếp sai đến ứng dụng Bitwarden chính thức."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 FIDO2 WebAuthn 需要使用 Bitwarden 网页密码库 %1$@ 或更高版本。在旧版本上，验证结果将错误地转发到 Bitwarden 官方应用程序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 FIDO2 WebAuthn 需要使用 Bitwarden 網頁密碼庫 %1$@ 或更高版本。在舊版本上，驗證結果將錯誤地轉發到 Bitwarden 官方應用程式。"
          }
        }
      }
    },
