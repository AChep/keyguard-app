    "navigation_items_reset_confirmation_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will restore the default navigation order and visibility. Custom filters are not deleted, but their navigation items will be removed."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى استعادة ترتيب التنقل الافتراضي ومرئيته. لا تُحذف عوامل التصفية المخصصة، لكن ستُزال عناصر التنقل الخاصة بها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will restore the default navigation order and visibility. Custom filters are not deleted, but their navigation items will be removed."
          }
        },
