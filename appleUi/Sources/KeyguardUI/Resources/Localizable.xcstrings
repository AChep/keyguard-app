            "value" : "SSH 代理接收来自 SSH 工具的请求，再将其转发给 Keyguard 应用，而非由自身处理敏感操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The SSH agent receives requests from SSH tools, then forwards them to the Keyguard app instead of handling the sensitive operation itself."
          }
        }
      }
    },
    "ssh_agent_setup_android_how_does_it_work_2" : {
