    "uri_match_detection_default_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik 'n globale Verstek opspangetrou-gedrag gekies in Instellings → Outovul → Verstek URI-passingsopsporing. Basisdomein passing is die verstek keuse."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم سلوك اكتشاف المطابقة الافتراضي العالمي المحدد في الإعدادات → التعبئة التلقائية → اكتشاف مطابقة URI الافتراضية. مطابقة النطاق الأساسي هي الخيار الافتراضي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses a global Default match detection behavior selected in Settings → Autofill → Default URI match detection. Base domain matching is the default option."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fa servir el comportament de detecció per defecte seleccionat a Configuració → Emplenament Automàtic → Detecció d'URI per defecte. L'opció predeterminada és la detecció per domini base."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použije globální výchozí chování zjišťování shody vybrané v Nastavení → Automatické vyplňování → Výchozí zjišťování shody URI. Shoda základní domény je výchozí možností."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruger en global Standard matchdetekteringsadfærd valgt i Indstillinger → Autofyld → Standard URI-matchdetektion. Basisdomænematchning er standardindstillingen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet ein globales standard Übereinstimmungserkennung-Verhalten, das unter Einstellungen → Autofill → Standard-Übereinstimmungserkennung ausgewählt ist. Die Standardoption ist die Basisdomänen-Übereinstimmung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses a global Default match detection behavior selected in Settings → Autofill → Default URI match detection. Base domain matching is the default option."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses a global Default match detection behavior selected in Settings → Autofill → Default URI match detection. Base domain matching is the default option."
