          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela ne désactive que les futures sauvegardes automatiques. Cela supprime de Keyguard le dossier local, le mot de passe et le choix des pièces jointes. Le dépôt de sauvegarde et les fichiers existants dans ce dossier ne sont pas supprimés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This only turns off future automatic backups. It clears the local folder, password, and attachment choice from Keyguard. The existing backup repository and files in that folder are not deleted."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez csak a jövőbeli automatikus mentéseket kapcsolja ki. Törli a helyi mappát, a jelszót és a melléklet választását a Keyguardból. A meglévő mentési tároló és az abban lévő fájlok nem törlődnek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
