    "ssh_agent_setup_android_termux_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On Android, Keyguard provides the SSH agent via a dedicated helper package. Enable SSH agent in Keyguard, install and configure the package, and approve requests when your SSH client connects."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على Android، يوفّر Keyguard وكيل SSH عبر حزمة مساعدة مخصّصة. فعّل وكيل SSH في Keyguard، وثبّت الحزمة وأعدّها، ووافق على الطلبات عند اتصال عميل SSH لديك."
          }
        },
        "bn" : {
          "stringUnit" : {
