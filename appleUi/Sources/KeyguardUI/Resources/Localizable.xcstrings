          "stringUnit" : {
            "state" : "translated",
            "value" : "Hide the content of the app when switching between recent apps and forbid capturing a screen"
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hide the content of the app when switching between recent apps and forbid capturing a screen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar el contenido de la app al cambiar entre aplicaciones recientes y restringir las capturas de pantalla"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piilota sovelluksen sisältö, kun vaihdat viimeisimpien sovellusten välillä ja estä näytön kaappaaminen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer le contenu de l'application lors du basculement entre les applications récentes et interdire la capture d'écran"
          }
        },
