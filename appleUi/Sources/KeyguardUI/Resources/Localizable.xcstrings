          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik doldurma sırasında ve daha fazlasında Keyguard'ın tek kullanımlık parolaları göstermesine olanak tanımak için bildirim izni verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надайте дозвіл показувати сповіщення щоб Keyguard показував одноразові паролі під час автозаповнення та більше."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cấp quyền thông báo để cho phép Keyguard hiển thị mật khẩu một lần khi tự động điền & nhiều hơn nữa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授予通知权限，允许 Keyguard 在自动填写时显示一次性密码等。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授予通知權限，允許 Keyguard 在自動填寫時顯示一次性密碼等。& 更多..."
