        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authenticate your Git and SSH clients without those clients ever being able to read your private key"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwierzytelniaj klienty Git i operujące przez SSH bez zapewniania im wglądu prosto w wykorzystywany we wewnątrz klucz z certyfikatu prywatnego powierzenia"
