    "pref_item_premium_membership_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Premium ontsluit ekstra kenmerke en befonds die ontwikkeling van die toep. Dankie dat jy ons ondersteun! ❤️"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح Premium ميزات إضافية ويمول تطوير التطبيق. شكرا لدعمكم لنا! ❤️"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Premium unlocks extra features and funds the development of the app. Thank you for supporting us! ❤️"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Prèmium desbloqueja funcions extra i finança el desenvolupament de l'app. Gràcies per donar-nos suport! ❤️"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium odemyká další možnosti a financuje vývoj aplikace. Děkujeme za vaší podporu! ❤️"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium oplåser ekstra funktioner og finansierer udvikling af appen. Tak for støtten til os! ❤️"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Premium entsperrt zusätzliche Funktionen und finanziert eine Entwicklung der App. Vielen Dank für Ihre Unterstützung! ❤️"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Premium unlocks extra features and funds the development of the app. Thank you for supporting us! ❤️"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Premium unlocks extra features and funds the development of the app. Thank you for supporting us! ❤️"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Premium unlocks extra features and funds a development of the app. Thank you for supporting us! ❤️"
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Premium unlocks extra features and funds the development of the app. Thank you for supporting us! ❤️"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Prémium desbloquea características adicionales y financia el desarrollo de la aplicación. ¡Gracias por apoyarnos! ❤️"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium avaa lisäominaisuuksia ja rahoittaa sovelluksen kehitystä. Kiitos, että tuet meitä! ❤️"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Premium débloque des fonctionnalités supplémentaires et finance un développement de l'application. Merci de nous soutenir ! ❤️"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Premium unlocks extra features and funds the development of the app. Thank you for supporting us! ❤️"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Prémium feloldja a további funkciókat és támogatja az alkalmazás fejlesztését. Köszönjük, hogy támogatsz minket! ❤️"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Premium sblocca funzionalità extra e finanzia lo sviluppo dell'app. Grazie per il supporto! ❤️"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレミアムプランは、追加の機能をアンロックして、アプリの開発を支援します。ご支援いただきありがとうございます！❤️"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프리미엄을 구매하시면 추가 기능을 사용할 수 있으며 앱 개발에 도움이 됩니다. 구매해 주셔서 감사합니다! ❤️"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Premium unlocks extra features and funds the development of the app. Thank you for supporting us! ❤️"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
