    "pref_item_clipboard_auto_refresh_otp_duration_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer jy 'n aanmelditem met 'n eenmalige wagwoord outovul, sal die kennisgewing met verifikasiekode vir ten minste die vasgestelde tydsduur opspring"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما تقوم بالملء التلقائي لعنصر تسجيل الدخول الذي يحتوي على كلمة مرور لمرة واحدة، سينبثق الإشعار مع رمز التحقق طوال المدة المحددة على الأقل"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you autofill a login item that has a one-time password, the notification with verification code will popup for at least the defined duration"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan emplenes un camp d'inici de sessió automàticament, i té una contrasenya d'un sol ús, la notificació amb el codi de verificació es mostrarà almenys durant la durada indicada"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při automatickém vyplnění přihlašovací položky s jednorázovým heslem se oznámení s ověřovacím kódem zobrazí minimálně na definovanou dobu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når man automatisk udfylder et login-emne, der har en engangsadgangskode, vil notifikationen med verifikationskoden vises i, som minimum, den definerede varighed"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie ein Login-Element automatisch eingeben, das ein Einmalpasswort besitzt, erscheint die Benachrichtigung mit Bestätigungscode für mindestens die definierte Dauer"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you autofill a login item that has a one-time password, the notification with verification code will popup for at least the defined duration"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you autofill a login item that has a one-time password, the notification with verification code will popup for at least the defined duration"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you autofill a login item that has a one-time password, the notification with verification code will popup for at least the defined duration"
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you autofill a login item that has a one-time password, the notification with verification code will popup for at least the defined duration"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando autorrellenas un elemento de inicio de sesión que tiene una contraseña única, la notificación con código de verificación aparecerá durante al menos la duración definida"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun täytät automaattisesti kirjautumiskohteen, jolla on kertakäyttöinen salasana, ilmoitus vahvistuskoodilla ponnahtaa esiin vähintään määritetyn keston ajan"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous remplissez automatiquement un élément de connexion qui a un mot de passe à usage unique, la notification avec le code de vérification apparaîtra pour au moins la durée définie"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you autofill a login item that has a one-time password, the notification with verification code will popup for at least the defined duration"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amikor egy egyszeri jelszóval rendelkező bejelentkezési elemet automatikusan kitölt, az ellenőrző kódot tartalmazó értesítés legalább a meghatározott ideig megjelenik"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando si compila automaticamente un elemento di accesso che ha una password monouso, la notifica con codice di verifica verrà visualizzata per almeno la durata definita"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワンタイムパスワードを含むログインアイテムを自動入力すると、認証コードの通知が指定された時間表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OTP가 있는 로그인 아이템을 자동 완성했을 때, 지정한 시간만큼 OTP 인증 코드를 알림으로 띄웁니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you autofill a login item that has a one-time password, the notification with verification code will popup for at least the defined duration"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer u een item met een eenmalige verificatiecode automatisch laat invullen zal er een notificatie met de verificatiecode verschijnen voor tenminste de ingestelde duur"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you autofill a login item that has a one-time password, the notification with verification code will popup for at least the defined duration"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando você preencher automaticamente um item de login que tenha uma senha de uso único, a notificação com o código de verificação aparecerá por pelo menos a duração definida"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando faz o preenchimento automático de uma entrada de início de sessão que tenha um código 2FA, a notificação com o código de verificação em janela flutuante aparece de acordo com a duração definida"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you autofill a login item that has a one-time password, the notification with verification code will popup for at least the defined duration"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При заполнении логина с одноразовым паролем уведомление с кодом подтверждения появляется по крайней мере на заданную длительность"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you autofill a login item that has a one-time password, the notification with verification code will popup for at least the defined duration"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you autofill a login item that has a one-time password, the notification with verification code will popup for at least the defined duration"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek kullanımlık parolası olan bir oturum açma ögesini otomatik doldurduğunuzda, doğrulama kodu içeren bildirim en az tanımlanan süre boyunca görünür kalacaktır"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При заповнюванні логіну з одноразовим паролем, сповіщення з кодом підтвердження зринає принаймні на задану тривалість"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bạn tự động điền một mục đăng nhập có mật khẩu một lần, thông báo có mã xác minh sẽ bật lên trong ít nhất khoảng thời gian đã xác định"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动填充具有一次性密码的登录条目时，会弹出带有验证码的通知，持续时间至少为所定义的持续时间"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動填充具有一次性密碼的登入專案時，會彈出帶有驗證碼的通知，持續時間至少為所定義的持續時間"
          }
        }
      }
    },
