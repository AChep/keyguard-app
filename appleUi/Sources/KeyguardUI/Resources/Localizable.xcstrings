          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña de la app nunca se almacena en el dispositivo ni se envía a través de la red. Se utiliza para generar una clave secreta que se utiliza para cifrar los datos locales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovelluksen salasanaa ei koskaan tallenneta laitteelle eikä lähetetä verkon yli. Sitä käytetään salaisen avaimen luomiseen, jota käytetään paikallisten tietojen salaamiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe de l'application ne sera jamais stocké sur l'appareil ni envoyé sur le réseau. Il est utilisé pour générer une clé secrète qui est utilisée pour chiffrer les données locales."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App password never gets stored on the device nor sent over the network. It is used to generate a secret key that is used to encrypt the local data."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alkalmazásjelszó soha nem kerül tárolásra az eszközön, és nem kerül elküldésre a hálózaton keresztül. Ez egy titkos kulcs létrehozására szolgál, amely a helyi adatok titkosítására szolgál."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La password dell'app non viene mai memorizzata sul dispositivo né inviata attraverso la rete. Viene utilizzata per generare una chiave segreta utilizzata per cifrare i dati locali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのパスワードは、デバイスに保存されることも、ネットワーク経由で送信されることもありません。ローカルデータを暗号化するために使用される秘密鍵を生成するために使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 비밀번호는 기기에 저장되거나 인터넷으로 전송되지 않습니다. 로컬 데이터를 암호화하기 위한 비밀 키를 생성하는 데에만 사용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App password never gets stored on the device nor sent over the network. It is used to generate a secret key that is used to encrypt the local data."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het app-wachtwoord wordt nooit op het apparaat opgeslagen of via het netwerk verzonden. Het wordt gebruikt om een geheime sleutel te genereren die wordt gebruikt om de lokale gegevens te versleutelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasło aplikacji nigdy nie jest przechowywane na urządzeniu ani przesyłane przez sieć. Służy do wygenerowania tajnego klucza, który jest wykorzystywany do szyfrowania lokalnych danych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A senha do aplicativo nunca é armazenada no dispositivo nem enviada pela rede. Ela é usada para gerar uma chave secreta que é usada para criptografar os dados locais."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A palavra-passe da aplicação nunca é armazenada no dispositivo nem enviada pela rede. É usada para gerar uma chave secreta que é usada para encriptar os dados locais."
          }
        },
        "ro" : {
