    "pref_item_autofill_service_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik die Android Autofill-raamwerk om te help met die invul van aanmeldinligting in ander toeps op die toestel"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم Android Autofill Framework للمساعدة في ملء معلومات تسجيل الدخول في التطبيقات الأخرى على الجهاز"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the Android Autofill Framework to assist in filling login information into other apps on the device"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fes servir el servei d'emplenament automàtic d'Android per ajudar-te emplenant informació d'inici de sessió a altres apps del dispositiu"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použít službu systému Android pro automatické vyplňování pro pomoc při vyplňování přihlašovacích údajů do jiných aplikací v zařízení"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug Android Autofill Framework som hjælp til at udfylde login-oplysninger i andre apps på enheden"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android Autofill Framework verwenden, um Login-Informationen in anderen Apps des Geräts zu füllen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the Android Autofill Framework to assist in filling login information into other apps on the device"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the Android Autofill Framework to assist in filling login information into other apps on the device"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the Android Autofill Framework to assist in filling login information into other apps on the device"
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the Android Autofill Framework to assist in filling login information into other apps on the device"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el framework de autocompletado de Android para ayudar a rellenar información de inicio de sesión en otras aplicaciones del dispositivo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä Androidin automaattisen täytön kehystä auttamaan kirjautumistietojen täyttämisessä muihin laitteen sovelluksiin"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le framework de saisie automatique d'Android pour vous accompagner à remplir les informations de connexion dans les autres applications de votre appareil"
          }
        },
