    "ciphers_action_upload_gpg_public_key_confirmation_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will send this item's armored GPG public key to your configured keyserver. The public key may include fingerprints, user IDs such as names and e-mail addresses, subkeys, dates, and revocation status. The keyserver may store and redistribute this public data."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيرسل Keyguard المفتاح العام لـ GPG المُدرَّع لهذا العنصر إلى خادم المفاتيح المُعدّ لديك. قد يتضمن المفتاح العام بصمات ومعرّفات مستخدم مثل الأسماء وعناوين البريد الإلكتروني والمفاتيح الفرعية والتواريخ وحالة الإبطال. قد يخزّن خادم المفاتيح هذه البيانات العامة ويعيد توزيعها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will send this item's armored GPG public key to your configured keyserver. The public key may include fingerprints, user IDs such as names and e-mail addresses, subkeys, dates, and revocation status. The keyserver may store and redistribute this public data."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will send this item's armored GPG public key to your configured keyserver. The public key may include fingerprints, user IDs such as names and e-mail addresses, subkeys, dates, and revocation status. The keyserver may store and redistribute this public data."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will send this item's armored GPG public key to your configured keyserver. The public key may include fingerprints, user IDs such as names and e-mail addresses, subkeys, dates, and revocation status. The keyserver may store and redistribute this public data."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will send this item's armored GPG public key to your configured keyserver. The public key may include fingerprints, user IDs such as names and e-mail addresses, subkeys, dates, and revocation status. The keyserver may store and redistribute this public data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard sendet den ASCII-Armor-kodierten öffentlichen GPG-Schlüssel dieses Elements an Ihren konfigurierten Schlüsselserver. Der öffentliche Schlüssel kann Fingerabdrücke, Benutzer-IDs wie Namen und E-Mail-Adressen, Unterschlüssel, Daten und den Widerrufsstatus enthalten. Der Schlüsselserver kann diese öffentlichen Daten speichern und weiterverbreiten. Bei diesem Hochladen werden keine Verifizierungs-E-Mails angefordert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will send this item's armored GPG public key to your configured keyserver. The public key may include fingerprints, user IDs such as names and e-mail addresses, subkeys, dates, and revocation status. The keyserver may store and redistribute this public data."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will send this item's armored GPG public key to your configured keyserver. The public key may include fingerprints, user IDs such as names and e-mail addresses, subkeys, dates, and revocation status. The keyserver may store and redistribute this public data."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will send this item's armored GPG public key to your configured keyserver. The public key may include fingerprints, user IDs such as names and e-mail addresses, subkeys, dates, and revocation status. The keyserver may store and redistribute this public data."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will send this item's armored GPG public key to your configured keyserver. The public key may include fingerprints, user IDs such as names and e-mail addresses, subkeys, dates, and revocation status. The keyserver may store and redistribute this public data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard enviará la clave pública GPG blindada de este elemento al servidor de claves configurado. La clave pública puede incluir huellas digitales, IDs de usuario como nombres y direcciones de correo electrónico, subclaves, fechas y el estado de revocación. El servidor de claves puede almacenar y redistribuir estos datos públicos. Esta subida no solicita correos de verificación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will send this item's armored GPG public key to your configured keyserver. The public key may include fingerprints, user IDs such as names and e-mail addresses, subkeys, dates, and revocation status. The keyserver may store and redistribute this public data."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard enverra la clé publique GPG en armure ASCII de cet élément vers le serveur de clés que vous avez configuré. La clé publique peut inclure des empreintes, des identifiants utilisateur tels que des noms et des adresses e-mail, des sous-clés, des dates et le statut de révocation. Le serveur de clés peut stocker et redistribuer ces données publiques. Ce téléversement ne demande pas d'e-mails de vérification."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will send this item's armored GPG public key to your configured keyserver. The public key may include fingerprints, user IDs such as names and e-mail addresses, subkeys, dates, and revocation status. The keyserver may store and redistribute this public data."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will send this item's armored GPG public key to your configured keyserver. The public key may include fingerprints, user IDs such as names and e-mail addresses, subkeys, dates, and revocation status. The keyserver may store and redistribute this public data."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard invierà la chiave pubblica GPG armored di questo elemento al keyserver configurato. La chiave pubblica può includere impronte digitali, ID utente come nomi e indirizzi e-mail, sottochiavi, date e stato di revoca. Il keyserver può memorizzare e ridistribuire questi dati pubblici. Questo caricamento non richiede e-mail di verifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard は、このアイテムの ASCII アーマー形式の GPG 公開鍵を、設定されたキーサーバーへ送信します。公開鍵には、フィンガープリント、名前やメールアドレスなどのユーザー ID、サブキー、日付、失効状態が含まれる場合があります。キーサーバーはこの公開データを保存し再配布することがあります。このアップロードでは確認メールを要求しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard가 이 항목의 armored GPG 공개 키를 설정된 키 서버로 전송합니다. 공개 키에는 핑거프린트, 이름 및 이메일 주소 같은 사용자 ID, 하위 키, 날짜, 폐기 상태가 포함될 수 있습니다. 키 서버는 이 공개 데이터를 저장하고 재배포할 수 있습니다. 이 업로드는 인증 이메일을 요청하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard vil sende dette elementets ASCII-beskyttede offentlige GPG-nøkkel til den konfigurerte nøkkelserveren. Den offentlige nøkkelen kan inneholde fingeravtrykk, bruker-ID-er som navn og e-postadresser, undernøkler, datoer og tilbakekallingsstatus. Nøkkelserveren kan lagre og videredistribuere disse offentlige dataene. Denne opplastingen ber ikke om verifiserings-e-poster."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard verstuurt de armored GPG publieke sleutel van dit item naar de door jou ingestelde sleutelserver. De publieke sleutel kan vingerafdrukken, gebruikers-ID's zoals namen en e-mailadressen, subsleutels, datums en de intrekkingsstatus bevatten. De sleutelserver kan deze publieke gegevens opslaan en verder verspreiden. Bij deze upload worden geen verificatie-e-mails aangevraagd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard wyśle opancerzony klucz publiczny GPG tego elementu do skonfigurowanego serwera kluczy. Klucz publiczny może zawierać odciski palców, identyfikatory użytkownika, takie jak imiona i adresy e-mail, podklucze, daty oraz status unieważnienia. Serwer kluczy może przechowywać i redystrybuować te dane publiczne. Ten transfer nie powoduje wysłania e-maili weryfikacyjnych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Keyguard enviará a chave pública GPG blindada deste item para o seu servidor de chaves configurado. A chave pública pode incluir impressões digitais, IDs de usuário, como nomes e endereços de e-mail, subchaves, datas e status de revogação. O servidor de chaves pode armazenar e redistribuir esses dados públicos. Este upload não solicita e-mails de verificação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Keyguard enviará a chave pública GPG protegida deste item para o seu servidor de chaves configurado. A chave pública pode incluir impressões digitais, IDs de utilizador como nomes e endereços de e-mail, sub-chaves, datas e estado de revogação. O servidor de chaves pode armazenar e redistribuir estes dados públicos. Este envio não solicita e-mails de verificação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard va trimite cheia publică GPG în format armură a acestui element către serverul de chei configurat. Cheia publică poate include amprente, ID-uri utilizator precum nume și adrese de e-mail, subchei, date și starea de revocare. Serverul de chei poate stoca și redistribui aceste date publice. Această încărcare nu solicită e-mailuri de verificare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard отправит открытый GPG-ключ этой записи в ASCII-броне на настроенный сервер ключей. Открытый ключ может содержать отпечатки, идентификаторы пользователя (например, имена и адреса электронной почты), подключи, даты и статус отзыва. Сервер ключей может хранить и распространять эти открытые данные. При такой загрузке письма для подтверждения не запрашиваются."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard ће послати оклопљени GPG јавни кључ ове ставке на ваш подешени сервер кључева. Јавни кључ може садржати отиске, корисничке ИД-ове као што су имена и адресе е-поште, подкључеве, датуме и статус опозива. Сервер кључева може чувати и даље дистрибуирати ове јавне податке. Ово отпремање не тражи верификационе поруке е-поште."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard skickar det här objektets ASCII-armerade offentliga GPG-nyckel till din konfigurerade nyckelserver. Den offentliga nyckeln kan innehålla fingeravtryck, användar-ID:n såsom namn och e-postadresser, undernycklar, datum och återkallelsestatus. Nyckelservern kan lagra och vidaredistribuera dessa offentliga data. Denna uppladdning begär inga verifierings-e-postmeddelanden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will send this item's armored GPG public key to your configured keyserver. The public key may include fingerprints, user IDs such as names and e-mail addresses, subkeys, dates, and revocation status. The keyserver may store and redistribute this public data."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard надішле відкритий ключ GPG цього запису у форматі ASCII armor на налаштований вами сервер ключів. Відкритий ключ може містити відбитки, ідентифікатори користувача, як-от імена та адреси електронної пошти, підключі, дати та статус відкликання. Сервер ключів може зберігати та поширювати ці публічні дані. Це завантаження не надсилає запитів на листи для підтвердження."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard sẽ gửi khóa công khai GPG dạng armor của mục này đến máy chủ khóa mà bạn đã cấu hình. Khóa công khai có thể bao gồm dấu vân tay, ID người dùng như tên và địa chỉ e-mail, các khóa phụ, ngày tháng và trạng thái thu hồi. Máy chủ khóa có thể lưu trữ và phân phối lại dữ liệu công khai này. Việc tải lên này không yêu cầu gửi e-mail xác minh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard 将把此条目的 ASCII 封装的 GPG 公钥发送到您配置的密钥服务器。公钥可能包含指纹、用户 ID（如姓名和电子邮件地址）、子钥、日期和吊销状态。密钥服务器可能会存储并重新分发这些公开数据。此次上传不会请求验证邮件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will send this item's armored GPG public key to your configured keyserver. The public key may include fingerprints, user IDs such as names and e-mail addresses, subkeys, dates, and revocation status. The keyserver may store and redistribute this public data."
          }
        }
      }
    },
