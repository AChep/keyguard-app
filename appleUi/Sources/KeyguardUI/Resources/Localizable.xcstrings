    "ssh_agent_setup_linux_socket_fallback_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tugval-pad: gebruik dit wanneer XDG_RUNTIME_DIR onbeskikbaar is in jou sessie."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مسار بديل: استخدم هذا عندما لا يكون XDG_RUNTIME_DIR متاحًا في جلستك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fallback path: use this when XDG_RUNTIME_DIR is unavailable in your session."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fallback path: use this when XDG_RUNTIME_DIR is unavailable in your session."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Náhradní cesta: použijte tuto variantu, pokud ve vaší relaci není k dispozici XDG_RUNTIME_DIR."
          }
        },
        "da" : {
