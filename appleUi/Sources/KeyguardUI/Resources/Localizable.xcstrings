        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo no soporta la recuperación de credenciales de usuario a través de la integración con los proveedores de credenciales. Contacte con el fabricante para más información."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laite ei tue käyttäjätunnistetietojen noutamista integroimalla tunnistetietojen tarjoajien kanssa. Ota yhteyttä valmistajaan saadaksesi lisätietoja."
          }
