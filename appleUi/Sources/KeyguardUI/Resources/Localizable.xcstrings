    "addaccount_http_header_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jy kan pasgemaakte HTTP-opskrifte byvoeg wat saam met elke versoek aan die bediener gestuur sal word."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك إضافة رؤوس HTTP مخصصة سيتم إرسالها مع كل طلب إلى الخادم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can add custom HTTP headers that will be sent with every request to the server."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pots afegir capçaleres HTTP que seran enviades amb cada petició al servidor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Můžete přidat vlastní hlavičky HTTP, které budou odeslány s každým požadavkem na server."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Man kan tilføje tilpassede HTTP-headere, som så sendes med hver forespørgsel til serveren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können eigene HTTP-Header hinzufügen, die mit jeder Anfrage an den Server gesendet werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can add custom HTTP headers that will be sent with every request to the server."
