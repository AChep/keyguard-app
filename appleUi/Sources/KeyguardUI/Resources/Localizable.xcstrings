        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses a global Default match detection behavior selected in Settings → Autofill → Default URI match detection. Base domain matching is the default option."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un comportamiento global de detección de coincidencias seleccionado en Ajustes → Autocompletado→ Detección de coincidencias URI predeterminada. El dominio base es la opción predeterminada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses a global Default match detection behavior selected in Settings → Autofill → Default URI match detection. Base domain matching is the default option."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise un comportement global de détection de correspondance par défaut sélectionné dans Paramètres → Remplissage automatique → Détection de correspondance URI par défaut. La correspondance avec le domaine de base est l'option par défaut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses a global Default match detection behavior selected in Settings → Autofill → Default URI match detection. Base domain matching is the default option."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Beállítások → Automatikus kitöltés → Alapértelmezett URI-illesztés felismerése menüpontban kiválasztott globális Alapértelmezett egyezésfelismerési viselkedést használja. Az alapdomain-illesztés az alapértelmezett beállítás."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizza il comportamento Rilevamento corrispondenza URI predefinito impostato in Impostazioni → Compilazione automatica → Rilevamento corrispondenza URI predefinito. L'opzione \"Corrispondenza dominio di base\" è quella predefinita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 → 自動入力 → デフォルトの URI の一致検出で選択されたグローバルなデフォルトの一致検出動作を使用します。ベースドメイン一致がデフォルトのオプションです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 → 자동 완성 → 기본 일치 인식 설정을 사용합니다. 초기값은 기본 도메인 인식입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses a global Default match detection behavior selected in Settings → Autofill → Default URI match detection. Base domain matching is the default option."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt de globale standaard detectie methode die is geselecteerd in Instellingen → Automatisch aanvullen → Standaard overeenkomst detectie. Overeenstemming van het basisdomein is de standaard optie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używa globalnego domyślnego zachowania dopasowywania, wybranego w Ustawieniach → Autouzupełnianie → Domyślne wykrywanie dopasowania URI. Opcją domyślną jest dopasowywanie do domeny podstawowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa um comportamento de detecção padrão selecionado em Configurações → Autopreencher→ Detecção de URI padrão. O domínio base é a opção padrão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa um comportamento de deteção de correspondência padrão selecionado em Configurações → Autofill → Detecção de correspondência de URI padrão. A correspondência de domínio base é a opção padrão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosește o regulă implicită globală aleasă în Setări → Completare automată → Regulă de potrivire URI implicită. Potrivirea domeniului de bază este opțiunea implicită."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использует поведение глобального определения соответствия по умолчанию, выбранное в Настройках → Автозаполнение → Стандартное определение соответствия URI."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses a global Default match detection behavior selected in Settings → Autofill → Default URI match detection. Base domain matching is the default option."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses a global Default match detection behavior selected in Settings → Autofill → Default URI match detection. Base domain matching is the default option."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar → Otomatik Doldurma → Varsayılan URI eşleşme algılaması bölümünde seçilen küresel Varsayılan eşleşme algılama davranışını kullanır. Temel alan adı (Base domain) eşleşmesi varsayılan seçenektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовує глобальний тип виявлення збігів обраний в Налаштування → Автозаповнення → Виявлення збігів за замовчуванням. Основний домен це стандартне налаштування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sử dụng hành vi phát hiện khớp mặc định toàn cầu được chọn trong Thiết đặt → Tự động điền → Phát hiện khớp URI mặc định. Khớp tên miền cơ sở là tùy chọn mặc định."
          }
        },
        "zh-Hans" : {
