            "value" : "Desbloquear una caja fuerte significa almacenar una clave correcta en la RAM de un dispositivo, ganando la capacidad de leer y modificar la caja fuerte cifrada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
