      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard listens on a Windows named pipe. Point Windows OpenSSH at this pipe."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتوفر بيئة عمل وكيل SSH الخاصة بـ Keyguard المكتبي حاليًا على نظام Windows، لذا الإعداد هنا للعلم فقط."
