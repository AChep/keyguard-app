          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will contact your configured GPG keyserver with this key's fingerprint. If a matching public key is found, Keyguard will update the stored public key, key metadata, and keyserver status for this item."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard kontaktiert Ihren konfigurierten GPG-Schlüsselserver mit dem Fingerabdruck dieses Schlüssels. Wenn ein passender öffentlicher Schlüssel gefunden wird, aktualisiert Keyguard den gespeicherten öffentlichen Schlüssel, die Schlüssel-Metadaten und den Schlüsselserver-Status für dieses Element."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will contact your configured GPG keyserver with this key's fingerprint. If a matching public key is found, Keyguard will update the stored public key, key metadata, and keyserver status for this item."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will contact your configured GPG keyserver with this key's fingerprint. If a matching public key is found, Keyguard will update the stored public key, key metadata, and keyserver status for this item."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will contact your configured GPG keyserver with this key's fingerprint. If a matching public key is found, Keyguard will update the stored public key, key metadata, and keyserver status for this item."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will contact your configured GPG keyserver with this key's fingerprint. If a matching public key is found, Keyguard will update the stored public key, key metadata, and keyserver status for this item."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard se pondrá en contacto con el servidor de claves GPG configurado usando la huella digital de esta clave. Si se encuentra una clave pública coincidente, Keyguard actualizará la clave pública almacenada, los metadatos de la clave y el estado del servidor de claves de este elemento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will contact your configured GPG keyserver with this key's fingerprint. If a matching public key is found, Keyguard will update the stored public key, key metadata, and keyserver status for this item."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard contactera le serveur de clés GPG que vous avez configuré avec l'empreinte de cette clé. Si une clé publique correspondante est trouvée, Keyguard mettra à jour la clé publique stockée, les métadonnées de la clé et le statut du serveur de clés pour cet élément."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will contact your configured GPG keyserver with this key's fingerprint. If a matching public key is found, Keyguard will update the stored public key, key metadata, and keyserver status for this item."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will contact your configured GPG keyserver with this key's fingerprint. If a matching public key is found, Keyguard will update the stored public key, key metadata, and keyserver status for this item."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard contatterà il keyserver GPG configurato con l'impronta digitale di questa chiave. Se viene trovata una chiave pubblica corrispondente, Keyguard aggiornerà la chiave pubblica memorizzata, i metadati della chiave e lo stato del keyserver per questo elemento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard は、このキーのフィンガープリントを使用して、設定された GPG キーサーバーに問い合わせます。一致する公開鍵が見つかった場合、このアイテムの保存済み公開鍵、キーのメタデータ、キーサーバーの状態を更新します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard가 이 키의 핑거프린트를 사용하여 설정된 GPG 키 서버에 접속합니다. 일치하는 공개 키를 찾으면 Keyguard가 이 항목의 저장된 공개 키, 키 메타데이터, 키 서버 상태를 업데이트합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard vil kontakte den konfigurerte GPG-nøkkelserveren med fingeravtrykket til denne nøkkelen. Hvis en samsvarende offentlig nøkkel blir funnet, oppdaterer Keyguard den lagrede offentlige nøkkelen, nøkkelmetadataene og nøkkelserverstatusen for dette elementet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard neemt met de vingerafdruk van deze sleutel contact op met de door jou ingestelde GPG-sleutelserver. Als er een overeenkomende publieke sleutel wordt gevonden, werkt Keyguard de opgeslagen publieke sleutel, de sleutelmetadata en de sleutelserverstatus van dit item bij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard skontaktuje się ze skonfigurowanym serwerem kluczy GPG, używając odcisku palca tego klucza. Jeśli zostanie znaleziony pasujący klucz publiczny, Keyguard zaktualizuje przechowywany klucz publiczny, metadane klucza oraz status serwera kluczy dla tego elementu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Keyguard entrará em contato com o servidor de chaves GPG configurado com a impressão digital desta chave. Se uma chave pública correspondente for encontrada, o Keyguard atualizará a chave pública armazenada, os metadados da chave e o status do servidor de chaves para este item."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Keyguard entrará em contacto com o servidor de chaves GPG configurado através da impressão digital desta chave. Se for encontrada uma chave pública correspondente, o Keyguard atualizará a chave pública armazenada, os metadados da chave e o estado do servidor de chaves para este item."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard va contacta serverul de chei GPG configurat folosind amprenta acestei chei. Dacă este găsită o cheie publică potrivită, Keyguard va actualiza cheia publică stocată, metadatele cheii și starea serverului de chei pentru acest element."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard обратится к настроенному серверу ключей GPG, используя отпечаток этого ключа. Если будет найден соответствующий открытый ключ, Keyguard обновит сохранённый открытый ключ, метаданные ключа и статус сервера ключей для этой записи."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard ће контактирати ваш подешени GPG сервер кључева помоћу отиска овог кључа. Ако се пронађе одговарајући јавни кључ, Keyguard ће ажурирати сачувани јавни кључ, метаподатке кључа и статус сервера кључева за ову ставку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard kontaktar din konfigurerade GPG-nyckelserver med den här nyckelns fingeravtryck. Om en matchande offentlig nyckel hittas uppdaterar Keyguard den lagrade offentliga nyckeln, nyckelns metadata och nyckelserverstatusen för det här objektet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will contact your configured GPG keyserver with this key's fingerprint. If a matching public key is found, Keyguard will update the stored public key, key metadata, and keyserver status for this item."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard звернеться до налаштованого вами сервера ключів GPG, використовуючи відбиток цього ключа. Якщо буде знайдено відповідний відкритий ключ, Keyguard оновить збережений відкритий ключ, метадані ключа та статус сервера ключів для цього запису."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard sẽ liên hệ với máy chủ khóa GPG mà bạn đã cấu hình bằng dấu vân tay của khóa này. Nếu tìm thấy khóa công khai khớp, Keyguard sẽ cập nhật khóa công khai đã lưu, siêu dữ liệu khóa và trạng thái máy chủ khóa cho mục này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard 将使用此密钥的指纹联系您配置的 GPG 密钥服务器。如果找到匹配的公钥，Keyguard 将更新此条目存储的公钥、密钥元数据以及密钥服务器状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will contact your configured GPG keyserver with this key's fingerprint. If a matching public key is found, Keyguard will update the stored public key, key metadata, and keyserver status for this item."
          }
        }
      }
    },
