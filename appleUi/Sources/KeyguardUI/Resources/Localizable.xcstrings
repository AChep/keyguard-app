    "addkeepass_use_at_your_own_risk_beta_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeePass-implementering is in beta en is nog nie ten volle versoenbaar met standaard KeePass-kliënte nie. Gebruik op eie risiko. Maak asseblief seker dat jy 'n geverifieerde rugsteun van jou databasis het voordat jy voortgaan."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنفيذ KeePass لا يزال في مرحلة بيتا وقد لا يكون متوافقًا تمامًا مع عملاء KeePass القياسيين بعد. استخدمه على مسؤوليتك الخاصة. يُرجى التأكد من وجود نسخة احتياطية مصدقة من قاعدة بياناتك قبل المتابعة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeePass implementation is in beta and is not yet fully compatible with standard KeePass clients. Use at your own risk. Please ensure you have a verified backup of your database before proceeding."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeePass implementation is in beta and is not yet fully compatible with standard KeePass clients. Use at your own risk. Please ensure you have a verified backup of your database before proceeding."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Implementace KeePass je v beta verzi a není dosud plně kompatibilní se standardními KeePass klienty. Používejte na vlastní nebezpečí. Než budete pokračovat, ujistěte se, že máte ověřenou zálohu své databáze."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De KeePass integratie bevindt zich in bèta en is nog niet volledig compatibel met standaard KeePass-clients. Gebruik op eigen risico. Zorg dat je een geverifieerde back-up van je database hebt voordat je verdergaat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die KeePass-Implementierung befindet sich in der Beta-Phase und ist noch nicht vollständig mit standardmäßigen KeePass-Clients kompatibel. Nutzung auf eigene Gefahr. Bitte stellen Sie sicher, dass Sie über ein funktionierendes Backup Ihrer Datenbank verfügen, bevor Sie fortfahren."
          }
        },
