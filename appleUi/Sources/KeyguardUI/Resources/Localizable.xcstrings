    "generator_email_plus_addressing_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus-adressering beteken enige e-pos gestuur na %1$@ word steeds na jou rekening gestuur. Dit beteken jy kan baie variasies op jou e-posadres hê om aan verskillende mense, werwe, of poslyste te gee. Maak seker dat jou e-posgasheer hierdie opsie ondersteun voordat jy dit gebruik."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus addressing means any email sent to %1$@ is still sent to your account. This means you can have a lot of variations on your email address to give out to different people, sites, or mailing lists. Ensure that your email hosting supports this feature before using it."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus addressing means any email sent to %1$@ is still sent to your account. This means you can have a lot of variations on your email address to give out to different people, sites, or mailing lists. Ensure that your email hosting supports this feature before using it."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els afegits al correu volen dir que qualsevol correu enviat a %1$@ també serà enviat al teu compte. Açò vol dir que pots tenir un gran número de variacions al teu correu electrònic per a donar a cada persona, lloc web, o llista de correu. Assegura't que el teu proveïdor de correu electònic suporta aquesta funció abans de fer-la servir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresa s plusem znamená, že všechny e-maily poslané na adresu %1$@ stále přijdou na váš účet. Znamená to, že můžete mít spoustu variací vaší e-mailové adresy, které můžete dát různým lidem, webům nebo e-mailovým seznamům. Před použitím této funkce se ujistěte, že ji váš poskytovatel e-mailového hostingu podporuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus adressering betyder enhver e-mail sendt til %1$@ sendes stadig til ens konto. Det betyder, at man kan have en masse variationer på sin e-mailadresse at give ud til forskellige folk, websteder eller postlister. Sørg for, at ens e-mail hoster understøtter denne funktion, før man bruger den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus Adressierung bedeutet, dass jede E-Mail, die an %1$@ gesendet wird, immer noch an Ihr Konto gesendet wird. Das bedeutet, dass Sie eine Vielzahl von Variationen an Ihre E-Mail-Adresse haben können, die Sie an verschiedene Personen, Seiten oder Mailinglisten verteilen können. Stellen Sie sicher, dass Ihr E-Mail-Hosting diese Funktion unterstützt, bevor Sie sie verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus addressing means any email sent to %1$@ is still sent to your account. This means you can have a lot of variations on your email address to give out to different people, sites, or mailing lists. Ensure that your email hosting supports this feature before using it."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus addressing means any email sent to %1$@ is still sent to your account. This means you can have a lot of variations on your email address to give out to different people, sites, or mailing lists. Ensure that your email hosting supports this feature before using it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus addressing means any email sent to %1$@ is still sent to your account. This means you can have a lot of variations on your email address to give out to different people, sites, or mailing lists. Ensure that your email hosting supports this feature before using it."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus addressing means any email sent to %1$@ is still sent to your account. This means you can have a lot of variations on your email address to give out to different people, sites, or mailing lists. Ensure that your email hosting supports this feature before using it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un correo electrónico extra significa que cualquier correo electrónico enviado a %1$@ todavía está enviado a tu cuenta. Esto significa que puede tener muchas variaciones en tu dirección de correo electrónico para tener un correo en varios sitios o listas de correo. Asegúrate de que tu alojamiento de correo electrónico soporta esta característica antes de usarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus addressing means any email sent to %1$@ is still sent to your account. This means you can have a lot of variations on your email address to give out to different people, sites, or mailing lists. Ensure that your email hosting supports this feature before using it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une adresse sous-adressé signifie que tout e-mail envoyé à %1$@ est toujours envoyé sur votre compte. Cela signifie que vous pouvez avoir beaucoup de variations sur votre adresse de courriel pour donner à différentes personnes, sites ou listes de diffusion. Assurez-vous que votre hébergement de courriel prend en charge cette fonctionnalité avant de l'utiliser."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus addressing means any email sent to %1$@ is still sent to your account. This means you can have a lot of variations on your email address to give out to different people, sites, or mailing lists. Ensure that your email hosting supports this feature before using it."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A plusz címzés azt jelenti, hogy minden, a %1$@ címre küldött e-mail még mindig a fiókjába érkezik. Ez lehetővé teszi, hogy különböző változatokat használjon az e-mail címéből, amelyeket különböző embereknek, webhelyeknek vagy levelezőlistáknak adhat meg. Mielőtt használná, győződjön meg róla, hogy az e-mail tárhelyszolgáltatója támogatja ezt a funkciót."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'indirizzamento e-mail con segno più (\"+\") fa sì che le email inviate a %1$@ vengano comunque inviate al tuo account. Questo significa che puoi avere molte variazioni del tuo vero indirizzo email da dare a persone, siti o mailing list differenti. Prima dell'utilizzo assicurati che il tuo servizio di hosting email supporti questa funzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プラスメールアドレスとは、%1$@ のようなメールアドレスに送信されたすべてのメールが、あなたのアカウントに送信されることを意味します。これにより、さまざまな人、サイト、メーリングリストに提供するための、メールアドレスのバリエーションを多く持つことができます。使用する前に、メールホスティングがこの機能をサポートしていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플러스 주소를 사용하면 %1$@ 주소로 전송된 모든 이메일이 사용자의 계정으로 전송됩니다. 따라서 각 웹사이트, 메일링 리스트마다 다른 이메일 주소를 사용할 수 있습니다. 사용하기 전에 이메일 호스팅 제공 업체에서 이 기능을 지원하는지 확인해 보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus addressing means any email sent to %1$@ is still sent to your account. This means you can have a lot of variations on your email address to give out to different people, sites, or mailing lists. Ensure that your email hosting supports this feature before using it."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een e-mailadres met plus betekent dat elke e-mail verzonden naar %1$@ nog steeds naar je account wordt verzonden. Dit betekent dat je veel variaties kunt hebben op je e-mailadres om uit te geven aan verschillende personen, sites of mailinglijsten. Zorg ervoor dat de e-mail hosting deze functie ondersteunt voordat je deze gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus addressing means any email sent to %1$@ is still sent to your account. This means you can have a lot of variations on your email address to give out to different people, sites, or mailing lists. Ensure that your email hosting supports this feature before using it."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endereço de e-mail Plus significa que qualquer e-mail enviado para %1$@ ainda é enviado para sua conta. Isso significa que você pode ter várias variações do seu endereço de e-mail para distribuir a diferentes pessoas, sites ou listas de distribuição. Certifique-se de que sua hospedagem de e-mail ofereça suporte a esse recurso antes de usá-lo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endereços de e-mail Plus significa que qualquer email enviado para %1$@ ainda é enviado para a sua conta. Isto significa que você pode ter muitas variações no seu endereço de e-mail para dar a várias pessoas, sites ou listas de discussão. Certifique-se de que o seu provedor de e-mail suporta este recurso antes de usá-lo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus addressing means any email sent to %1$@ is still sent to your account. This means you can have a lot of variations on your email address to give out to different people, sites, or mailing lists. Ensure that your email hosting supports this feature before using it."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плюс адресация означает, что любые сообщения, отправленные на %1$@, по-прежнему отправляются на адрес вашего аккаунта. Это означает, что вы можете иметь много вариантов адреса своей электронной почты, чтобы предоставлять его разным людям, сайтам или спискам рассылки. Перед использованием убедитесь, что хостинг электронной почты поддерживает эту функцию."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus addressing means any email sent to %1$@ is still sent to your account. This means you can have a lot of variations on your email address to give out to different people, sites, or mailing lists. Ensure that your email hosting supports this feature before using it."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus addressing means any email sent to %1$@ is still sent to your account. This means you can have a lot of variations on your email address to give out to different people, sites, or mailing lists. Ensure that your email hosting supports this feature before using it."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artı işaretli adresleme (plus addressing), %1$@ adresine gönderilen herhangi bir e-postanın hesabınıza gönderilmesi anlamına gelir. Bu, farklı kişilere, sitelere veya posta listelerine vermek için e-posta adresinizin birçok varyasyonuna sahip olabileceğiniz anlamına gelir. Bu özelliği kullanmadan önce e-posta barındırıcınızın bunu desteklediğinden emin olun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плюс адресація означає, що будь-які повідомлення, надіслані на %1$@, усе ще надсилаються на ваш обліковий запис. Це означає, що ви можете мати багато варіантів своєї адреси електронної пошти, щоб надавати її різним людям, сайтам або спискам розсилки. Перед використанням переконайтеся, що ваш хостинг електронної пошти підтримує цю функцію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Địa chỉ cộng có nghĩa là mọi email được gửi tới %1$@ vẫn được gửi đến tài khoản của bạn. Điều này có nghĩa là bạn có thể có nhiều biến thể về địa chỉ email của mình để cung cấp cho những người, trang web hoặc danh sách gửi thư khác nhau. Đảm bảo rằng dịch vụ lưu trữ email của bạn hỗ trợ tính năng này trước khi sử dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "附加地址意味着任何发送到 %1$@ 的电子邮件仍会发送到您的账户。这意味着您的电子邮件地址可以有很多变化，可以发送给不同的人、网站或邮件列表。使用前请确保您的电子邮件主机支持此功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "附加地址意味著任何傳送到 %1$@ 的電子郵件仍會發送到您的帳號。這意味著您的電子郵件地址可以有很多變化，可以傳送給不同的人、網站或郵件列表。使用前請確保您的電子郵件主機支援此功能。"
          }
        }
      }
    },
