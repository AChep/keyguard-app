    "gpg_key_expiry_dialog_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expiration is reversible and does not protect a compromised key. Revoke a compromised key instead."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهاء الصلاحية قابل للعكس ولا يحمي مفتاحًا مخترقًا. أبطل المفتاح المخترق بدلاً من ذلك."
          }
        },
        "bn" : {
