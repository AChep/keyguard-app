        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'appareil ne prend pas en charge la récupération des informations d'identification de l'utilisateur via l'intégration avec des fournisseurs d'informations d'identification. Contactez le fabricant pour plus d'informations."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The device doesn't support retrieval of user credentials via integration with credential providers. Contact the manufacturer for more information."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez az eszköz nem támogatja a felhasználói hitelesítő adatok lekérdezését hitelesítő szolgáltatókkal való integrációval. További információért forduljon a gyártóhoz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dispositivo non supporta il recupero delle credenziali utente tramite l'integrazione con i provider di credenziali. Contatta il produttore per maggiori informazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスは資格情報プロバイダーとの統合によるユーザー資格情報の取得をサポートしていません。詳細については製造元にお問い合わせください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기는 통합 기능을 사용하여 자격 증명 공급자에서 사용자 자격 증명을 받아올 수 없습니다. 자세한 사항은 기기 제조사에 문의하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The device doesn't support retrieval of user credentials via integration with credential providers. Contact the manufacturer for more information."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit apparaat heeft geen ondersteuning voor het ophalen van gebruikersgegevens via een integratie met de credential provider. Neem contact op met de fabrikant van het apparaat voor meer informatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje urządzenie nie obsługuje pobierania poświadczeń użytkownika za pośrednictwem zintegrowanych dostawców. Skontaktuj się z producentem sprzętu w celu uzyskania dodatkowych informacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dispositivo não suporta a recuperação de credenciais do usuário através da integração com provedores de credenciais. Contate o fabricante para obter mais informações."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dispositivo não suporta a recuperação de credenciais do utilizador através da integração com provedores de credenciais. Contacte o fabricante para obter mais informações."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The device doesn't support retrieval of user credentials via integration with credential providers. Contact the manufacturer for more information."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устройство не поддерживает интеграцию с поставщиками учетных записей. Свяжитесь с производителем для получения дополнительной информации."
          }
