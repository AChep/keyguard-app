          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ablauf ist umkehrbar und schützt einen kompromittierten Schlüssel nicht. Widerrufen Sie stattdessen einen kompromittierten Schlüssel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expiration is reversible and does not protect a compromised key. Revoke a compromised key instead."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
