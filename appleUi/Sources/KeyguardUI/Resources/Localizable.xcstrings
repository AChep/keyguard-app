    "changepassword_disclaimer_abuse_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tensy jy ongemagtigde toegang vermoed of wanware op die toestel ontdek, is daar geen rede om die wagwoord te verander nie as dit 'n sterk, unieke wagwoord is."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما لم تكن تشك في الوصول غير المصرح به أو تكتشف برامج ضارة على الجهاز، فليست هناك حاجة لتغيير كلمة المرور إذا كانت كلمة مرور قوية وفريدة من نوعها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unless you suspect unauthorized access or discover malware on the device, there is no need to change the password if it is a strong, unique password."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A no ser que sospites d'un accés no autoritzat, o descobreixis programari maliciós al teu dispositiu, no hi ha cap necessitat de canviar la contrasenya si és una forta i única."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud nemáte podezření na neoprávněný přístup nebo v zařízení neobjevíte škodlivý software, není třeba heslo měnit, pokud je silné a jedinečné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medmindre man mistænker uautoriseret adgang eller opdager en malware på enheden, er der ingen grund til at skifte adgangskoden, hvis den ellers er stærk og unik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sei denn, Sie vermuten unbefugten Zugriff oder eine Malware auf dem Gerät zu entdecken, es gibt keine Notwendigkeit, das Passwort zu ändern, wenn es ein starkes und einzigartiges Passwort ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unless you suspect unauthorized access or discover malware on the device, there is no need to change the password if it is a strong, unique password."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unless you suspect unauthorized access or discover malware on the device, there is no need to change the password if it is a strong, unique password."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unless you suspect unauthorised access or discover a malware on the device, there is no need to change the password if it is a strong, unique password."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unless you suspect unauthorized access or discover malware on the device, there is no need to change the password if it is a strong, unique password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A menos que sospeche acceso no autorizado o descubra un malware en el dispositivo, no hay necesidad de cambiar la contraseña más si es una contraseña única y fuerte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ellei epäillä luvatonta käyttöä tai laitteessa havaita haittaohjelmaa, salasanaa ei tarvitse vaihtaa, jos se on vahva ja ainutlaatuinen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauf si vous soupçonnez un accès non autorisé ou si vous découvrez un logiciel malveillant sur l'appareil, il n'est pas nécessaire de changer le mot de passe si c'est un mot de passe fort et unique."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unless you suspect unauthorized access or discover malware on the device, there is no need to change the password if it is a strong, unique password."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hacsak nem gyanít jogosulatlan hozzáférést, vagy nem fedez fel vírust az eszközön, nincs szükség a jelszó megváltoztatására, ha az egy erős, egyedi jelszó."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A meno che non si sospetti l'accesso non autorizzato o la presenza di malware sul dispositivo, non è necessario cambiare la password se è forte e unica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不正アクセスが疑われる場合やデバイスにマルウェアを発見した場合を除いて、強力で一意のパスワードであれば、変更する必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강력한 비밀번호를 웹사이트마다 다르게 사용하고 있다면, 무단 접속이 의심되거나 기기에서 악성 코드가 발견되지 않는 한 비밀번호를 변경할 필요가 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unless you suspect unauthorized access or discover malware on the device, there is no need to change the password if it is a strong, unique password."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zolang u geen onbevoegde toegang vermoedt of malware hebt ontdekt op uw apparaat is het niet nodig om het wachtwoord te wijzigen als u een sterk en uniek wachtwoord gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ile nie masz podejrzeń co do nieautoryzowanego dostępu lub złośliwego oprogramowania na urządzeniu, zmiana unikalnego silnego hasła nie jest wymagana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A menos que você suspeite de acesso não autorizado ou descubra um malware no dispositivo, não há necessidade de alterar a senha se ela for uma senha forte e única."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A menos que suspeite de acesso não autorizado ou descubra malware no dispositivo, não há necessidade de alterar a palavra-passe se esta for forte e exclusiva."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unless you suspect unauthorized access or discover malware on the device, there is no need to change the password if it is a strong, unique password."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы не подозреваете, что к вашему устройству был несанкционированный доступ, или вы не нашли вредоносное программное обеспечение, то не нужно изменять текущий пароль приложения, если он достаточно надежный и уникальный."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unless you suspect unauthorized access or discover malware on the device, there is no need to change the password if it is a strong, unique password."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unless you suspect unauthorized access or discover malware on the device, there is no need to change the password if it is a strong, unique password."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yetkisiz erişimden şüphelenmediğiniz veya cihazınızda kötü amaçlı yazılım tespit etmediğiniz sürece, güçlü ve benzersiz olması koşuluyla parolayı değiştirmenize gerek yoktur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ви не підозрюєте що до вашого пристрою був несанкціонований доступ, або не знайшли шкідливе програмне забезпечення, то не треба змінювати поточний пароль застосунку, якщо він достатньо надійний та унікальний."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trừ khi bạn nghi ngờ có sự truy cập trái phép hoặc phát hiện phần mềm độc hại trên thiết bị, không cần phải thay đổi mật khẩu nếu đó là mật khẩu mạnh, duy nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非你怀疑有未经授权的访问或在设备上发现了恶意软件，否则如果密码强大且唯一则没有必要更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非你懷疑有未經授權的訪問或在裝置上發現了惡意軟體，否則如果密碼強大且唯一則沒有必要更改。"
          }
        }
      }
    },
    "changepassword_disclaimer_local_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die toepwagwoord word nooit op die toestel gestoor of oor die netwerk gestuur nie. Dit word gebruik om 'n geheime sleutel te genereer wat gebruik word om die plaaslike data te enkodeer."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتم تخزين كلمة مرور التطبيق مطلقًا على الجهاز ولا يتم إرسالها عبر الشبكة. يتم استخدامه لإنشاء مفتاح سري يستخدم لتشفير البيانات المحلية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App password never gets stored on the device nor sent over the network. It is used to generate a secret key that is used to encrypt the local data."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contrasenya d'aplicació mai es desa al dispositiu ni s'envia a través de la xarxa. Es fa servir per a generar un secret que s'utilitza per a encriptar les dades locals."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heslo aplikace se nikdy neukládá do zařízení ani není posíláno přes síť. Je používáno k vygenerování tajného klíče, kterým jsou zašifrována lokální data."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-adgangskoden gemmes aldrig på enheden eller sendes over netværket. Den bruges generering af en hemmelig nøgle til brug for kryptering af lokale data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-Passwort wird nie auf dem Gerät gespeichert oder über das Netzwerk versendet. Es wird verwendet, um einen geheimen Schlüssel zu generieren, der zur Verschlüsselung der lokalen Daten verwendet wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App password never gets stored on the device nor sent over the network. It is used to generate a secret key that is used to encrypt the local data."
          }
        },
        "en" : {
          "stringUnit" : {
