    "addkeepass_header_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoor al jou wagwoorde in 'n enkele, hoogs-geënkripteerde KDBX-lêer wat direk op jou toestel gestoor is. Jy het volle beheer oor jou data. Stoor dit op jou rekenaar, 'n USB-aandrywer, of sinkroniseer dit self deur 'n diens soos Syncthing, Google Drive of Dropbox te gebruik."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظ جميع كلمات المرور الخاصة بك في ملف KDBX واحد وعالي التشفير يخزن مباشرة على جهازك. لديك سيطرة كاملة على بياناتك. يمكنك تخزينه على حاسوبك، أو محرك USB، أو مزامنته بنفسك باستخدام خدمة مثل Syncthing، أو Google Drive، أو Dropbox."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save all your passwords in a single, highly-encrypted KDBX file stored directly on your device. You have complete control over your data. Store it on your computer, a USB drive, or sync it yourself using a service like Syncthing, Google Drive or Dropbox."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save all your passwords in a single, highly-encrypted KDBX file stored directly on your device. You have complete control over your data. Store it on your computer, a USB drive, or sync it yourself using a service like Syncthing, Google Drive or Dropbox."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložte si všechna svá hesla do jediného, vysoce zabezpečeného souboru KDBX, který je uložen přímo ve vašem zařízení. Nad svými daty máte naprostou kontrolu. Můžete je uložit v počítači, na USB disku nebo si je sami synchronizovat pomocí služeb jako Syncthing, Google Drive nebo Dropbox."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem alle dine adgangskoder i en enkelt, stærkt krypteret KDBX-fil, der lagres direkte på din enhed. Du har fuld kontrol over dine data. Gem den på din computer, et USB-stik, eller synkroniser den selv ved hjælp af en tjeneste som Syncthing, Google Drive eller Dropbox."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere all deine Passwörter in einer einzelnen, hoch-sicheren KDBX Datei direkt auf deinem Gerät. Du hast die komplette Kontrolle über deine Daten. Speichere sie auf deinem Computer, einem USB-Stick, oder synchronisiere sie selber mithilfe von Services wie Syncthing, Google Drive oder Dropbox."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save all your passwords in a single, highly-encrypted KDBX file stored directly on your device. You have complete control over your data. Store it on your computer, a USB drive, or sync it yourself using a service like Syncthing, Google Drive or Dropbox."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save all your passwords in a single, highly-encrypted KDBX file stored directly on your device. You have complete control over your data. Store it on your computer, a USB drive, or sync it yourself using a service like Syncthing, Google Drive or Dropbox."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save all your passwords in a single, highly-encrypted KDBX file stored directly on your device. You have complete control over your data. Store it on your computer, a USB drive, or sync it yourself using a service like Syncthing, Google Drive or Dropbox."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save all your passwords in a single, highly-encrypted KDBX file stored directly on your device. You have complete control over your data. Store it on your computer, a USB drive, or sync it yourself using a service like Syncthing, Google Drive or Dropbox."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda todas tus contraseñas en un solo archivo KDBX altamente cifrado almacenado directamente en tu dispositivo. Tienes control completo sobre tus datos. Almacenalo en tu ordenador, en una unidad USB, o sincronízalo tú mismo usando un servicio como Syncthing, Google Drive o Dropbox."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save all your passwords in a single, highly-encrypted KDBX file stored directly on your device. You have complete control over your data. Store it on your computer, a USB drive, or sync it yourself using a service like Syncthing, Google Drive or Dropbox."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez tous vos mots de passe dans un seul fichier KDBX hautement crypté stocké directement sur votre appareil. Vous avez un contrôle total sur vos données. Stockez-les sur votre ordinateur, une clé USB ou synchronisez-les vous-même à l'aide d'un service tel que Syncthing, Google Drive ou Dropbox."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save all your passwords in a single, highly-encrypted KDBX file stored directly on your device. You have complete control over your data. Store it on your computer, a USB drive, or sync it yourself using a service like Syncthing, Google Drive or Dropbox."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentsen minden jelszót egyetlen, magasan titkosított KDBX fájlba, amelyet közvetlenül a készülékén tárol. Ön teljes mértékben uralja az adatait. Tárolja azokat a számítógépén, egy USB meghajtón, vagy szinkronizálja saját maga egy olyan szolgáltatás segítségével, mint a Syncthing, a Google Drive vagy a Dropbox."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva tutte le tue password in un unico file KDBX altamente cifrato memorizzato direttamente sul tuo dispositivo. Hai il controllo completo sui tuoi dati. Conservalo sul tuo computer, un'unità USB o sincronizzalo usando un servizio come Syncthing, Google Drive o Dropbox."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのパスワードを強力に暗号化された1つのKDBXファイルに保存し、デバイス上に直接保管します。データはあなた自身が完全に管理できます。コンピュータやUSBドライブに保存したり、Syncthing、Google ドライブ、Dropboxなどのサービスを使用して自分で同期したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 비밀번호를 강력하게 암호화된 단일 KDBX 파일에 저장하여 기기에 직접 보관하세요. 데이터는 온전히 사용자가 관리합니다. 컴퓨터나 USB 드라이브에 저장하거나 Syncthing, Google 드라이브, Dropbox와 같은 서비스를 통해 직접 동기화하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save all your passwords in a single, highly-encrypted KDBX file stored directly on your device. You have complete control over your data. Store it on your computer, a USB drive, or sync it yourself using a service like Syncthing, Google Drive or Dropbox."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save all your passwords in a single, highly-encrypted KDBX file stored directly on your device. You have complete control over your data. Store it on your computer, a USB drive, or sync it yourself using a service like Syncthing, Google Drive or Dropbox."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save all your passwords in a single, highly-encrypted KDBX file stored directly on your device. You have complete control over your data. Store it on your computer, a USB drive, or sync it yourself using a service like Syncthing, Google Drive or Dropbox."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve todas as suas senhas em um único arquivo KDBX altamente criptografado, armazenado diretamente no seu dispositivo. Você tem controle total sobre seus dados. Armazene-o em seu computador, em uma unidade USB ou sincronize-o usando um serviço como Syncthing, Google Drive ou Dropbox."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde todas as suas palavras-passe num único ficheiro KDBX altamente encriptado, armazenado diretamente no seu dispositivo. Tem controlo total sobre os seus dados. Armazene-os no seu computador, numa pen USB ou sincronize-os você mesmo utilizando um serviço de cloud como o Google Drive ou o Dropbox."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save all your passwords in a single, highly-encrypted KDBX file stored directly on your device. You have complete control over your data. Store it on your computer, a USB drive, or sync it yourself using a service like Syncthing, Google Drive or Dropbox."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняйте все свои пароли в едином, надежно зашифрованном файле KDBX, который хранится прямо на вашем устройстве. Вы полностью контролируете свои данные. Храните их на компьютере, USB-накопителе или самостоятельно синхронизируйте с помощью таких сервисов, как Syncthing, Google Диск или Dropbox."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save all your passwords in a single, highly-encrypted KDBX file stored directly on your device. You have complete control over your data. Store it on your computer, a USB drive, or sync it yourself using a service like Syncthing, Google Drive or Dropbox."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save all your passwords in a single, highly-encrypted KDBX file stored directly on your device. You have complete control over your data. Store it on your computer, a USB drive, or sync it yourself using a service like Syncthing, Google Drive or Dropbox."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm parolalarınızı doğrudan cihazınızda depolanan tek, yüksek düzeyde şifrelenmiş bir KDBX dosyasına kaydedin. Verileriniz üzerinde tam kontrole sahipsiniz. Bilgisayarınızda, USB sürücünüzde saklayın veya Syncthing, Google Drive veya Dropbox gibi bir hizmeti kullanarak kendiniz eşitleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігайте всі ваші паролі в єдиному, надійно зашифрованому KDBX-файлі безпосередньо на вашому пристрої. Ви маєте повний контроль над своїми даними. Зберігайте файл на комп'ютері, USB-накопичувачі або синхронізуйте його самостійно, використовуючи хмарний сервіс, як-от Google Drive чи Dropbox."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save all your passwords in a single, highly-encrypted KDBX file stored directly on your device. You have complete control over your data. Store it on your computer, a USB drive, or sync it yourself using a service like Syncthing, Google Drive or Dropbox."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将所有密码保存在一个高度加密的 KDBX 文件中，该文件直接存储在您的设备上。您可以完全掌控自己的数据。您可以将数据存储在电脑、U 盘上，或使用 Google Drive 或 Dropbox 等云服务自行同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將您所有密碼直接儲存在一個高度加密的 KDBX 檔案到您的裝置。您可以完全掌控自己的資料。您可以將資料儲存在電腦、USB 儲存裝置或使用 Google 雲端硬碟或是 Dropbox 等雲端服務自行同步。"
          }
        }
      }
    },
