        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups speichern Snapshots Ihres Tresors an einem von Ihnen gewählten Ort. Keyguard erstellt sie bei Änderungen am Tresor. Sie können jederzeit auch manuell einen Snapshot erstellen."
          }
        },
