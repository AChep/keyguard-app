    "pref_item_automatic_backups_disable_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This only turns off future automatic backups. It clears the local folder, password, and attachment choice from Keyguard. The existing backup repository and files in that folder are not deleted."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي هذا فقط إلى إيقاف النسخ الاحتياطي التلقائي المستقبلي. يمسح المجلد المحلي وكلمة المرور وخيار المرفقات من Keyguard. لا يُحذف مستودع النسخ الاحتياطي الحالي والملفات الموجودة في ذلك المجلد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This only turns off future automatic backups. It clears the local folder, password, and attachment choice from Keyguard. The existing backup repository and files in that folder are not deleted."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This only turns off future automatic backups. It clears the local folder, password, and attachment choice from Keyguard. The existing backup repository and files in that folder are not deleted."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This only turns off future automatic backups. It clears the local folder, password, and attachment choice from Keyguard. The existing backup repository and files in that folder are not deleted."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This only turns off future automatic backups. It clears the local folder, password, and attachment choice from Keyguard. The existing backup repository and files in that folder are not deleted."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden nur zukünftige automatische Backups deaktiviert. Keyguard entfernt den lokalen Ordner, das Passwort und die Auswahl für Anhänge aus seinen Einstellungen. Das vorhandene Backup-Repository und die Dateien in diesem Ordner werden nicht gelöscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This only turns off future automatic backups. It clears the local folder, password, and attachment choice from Keyguard. The existing backup repository and files in that folder are not deleted."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This only turns off future automatic backups. It clears the local folder, password, and attachment choice from Keyguard. The existing backup repository and files in that folder are not deleted."
          }
        },
        "en-GB" : {
          "stringUnit" : {
