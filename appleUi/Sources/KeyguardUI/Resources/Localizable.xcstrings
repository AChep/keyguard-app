    "pref_item_automatic_backups_setup_logic" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The backup repository stores metadata, snapshots, and optional attachment files as separate ZIP archives. Specify the backup password to encrypt the archives using AES-256 encryption."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يخزّن مستودع النسخ الاحتياطي البيانات الوصفية واللقطات وملفات المرفقات الاختيارية كأرشيفات ZIP منفصلة. حدّد كلمة مرور النسخ الاحتياطي لتشفير الأرشيفات باستخدام تشفير AES-256."
          }
        },
        "bn" : {
          "stringUnit" : {
