        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En utpekt tilbakekalling kan ikke verifiseres fordi tilbakekallerens offentlige nøkkel er utilgjengelig. Importer den og prøv igjen."
