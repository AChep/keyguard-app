        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The calling app is not on the privileged list and can not request authentication on behalf of the other apps."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çağıran uygulama ayrıcalıklı listede değil ve diğer uygulamalar adına kimlik doğrulama isteyemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застосунок, що надіслав запит, відсутній у списку привілейованих і не може запитувати автентифікацію від імені інших застосунків."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The calling app is not on the privileged list and can not request authentication on behalf of the other apps."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发起调用的应用程序不在特权列表中，因此不能代表其他应用程序请求身份验证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼叫的應用程式不在特權列表內，而且無法代表其他應用程式請求身份認證。"
          }
        }
      }
    },
    "error_credential_calling_app_not_privileged_add_as_privileged_app_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deur 'n toep te vertrou, laat dit toe om credentials vir enige diens aan te vra. 'n Kwaadwillige toep kan dit gebruik om te probeer om jou aanmeldinligting te steel."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الثقة في تطبيق ما تسمح له بطلب بيانات الاعتماد لأي خدمة. قد يستخدم تطبيق خبيث هذا لمحاولة سرقة بيانات الاعتماد الخاصة بك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trusting an app allows it to request credentials for any service. A malicious app could use this to try to steal your credentials."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trusting an app allows it to request credentials for any service. A malicious app could use this to try to steal your credentials."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trusting an app allows it to request credentials for any service. A malicious app could use this to try to steal your credentials."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Door een app te vertrouwen, kan deze om inloggegevens voor elke dienst vragen. Een kwaadaardige app zou dit kunnen gebruiken om je inloggegevens te stelen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie einer App vertrauen, kann diese Anmeldedaten für einen beliebigen Dienst anfordern. Eine böswillige App könnte dies nutzen, um zu versuchen, Ihre Anmeldedaten zu stehlen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
