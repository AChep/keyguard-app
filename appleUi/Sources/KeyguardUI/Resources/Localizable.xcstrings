    "watchtower_item_vulnerable_accounts_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werwe wat deur 'n databreuk geraak is sedert jy laas 'n wagwoord verander het. Verander jou wagwoord om jou rekening veilig te hou."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المواقع التي تأثرت بخرق البيانات منذ آخر مرة قمت فيها بتغيير كلمة المرور. قم بتغيير كلمة المرور الخاصة بك للحفاظ على أمان حسابك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sites that were affected by a data breach since you last changed a password. Change your password to keep your account safe."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llocs web que van ser afectats per una filtracions de dades després de l'última vegada que vas canviar la contrasenya. Canvia-la per a mantenir el teu compte assegurat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weby ovlivněné únikem dat od poslední změny vašeho hesla. Změňte si své heslo, aby váš účet zůstal v bezpečí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websteder påvirket af et databrud, siden man sidst ændrede en adgangskode. Skift adgangskoden for at holde kontoen sikker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seiten, die von einem Datenleck betroffen waren, seit Sie zuletzt ein Passwort geändert haben. Ändern Sie Ihr Passwort, um Ihr Konto sicher zu halten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sites that were affected by a data breach since you last changed a password. Change your password to keep your account safe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sites that were affected by a data breach since you last changed a password. Change your password to keep your account safe."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sites that were affected by a data breach since you last changed a password. Change your password to keep your account safe."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sites that were affected by a data breach since you last changed a password. Change your password to keep your account safe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitios que se vieron afectados por una filtración de datos desde la última vez que cambiaste una contraseña. Cambia tu contraseña para mantener tu cuenta segura."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sivustot, joihin on vaikuttanut tietomurto salasanan viimeisen vaihdon jälkeen. Vaihda salasanasi pitääksesi tilisi turvassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sites qui ont été affectés par une violation des données depuis votre dernière modification d'un mot de passe. Changez votre mot de passe pour garder votre compte en sécurité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sites that were affected by a data breach since you last changed a password. Change your password to keep your account safe."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olyan webhelyek, amelyeket az utolsó jelszómódosítás óta adatszivárgás érintett. Fiókja biztonságának megőrzése érdekében változtassa meg jelszavát."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siti che sono stati affetti da una violazione di dati dall'ultima modifica di una password. Cambia la password per mantenere il tuo account sicuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードを最後に変更してから、データ漏洩の影響を受けたサイトです。アカウントの安全性を保つために、パスワードを変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비밀번호를 마지막으로 변경한 뒤에 데이터가 유출된 사이트입니다. 계정을 안전하게 유지하기 위해 비밀번호를 변경하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sites that were affected by a data breach since you last changed a password. Change your password to keep your account safe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites die getroffen zijn door datalekken sinds je voor het laatst je wachtwoord hebt gewijzigd. Wijzig je wachtwoord om je account veilig te houden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sites that were affected by a data breach since you last changed a password. Change your password to keep your account safe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sites que foram afetados por um vazamento de dados desde a última vez que você alterou a senha. Altere sua senha para manter sua conta segura."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sites que foram afetados por uma violação de dados desde a última vez que foi alterada a palavra-passe. Alterar palavra-passe para manter a conta segura."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Website-uri afectate de o breșă de date de când ți-ai actualizat ultima oară parola. Evită riscurile și schimbă parola contului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сайты, на которых произошла утечка данных с момента последней смены пароля. Измените пароль, чтобы сохранить свою учетную запись в безопасности."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sites that were affected by a data breach since you last changed a password. Change your password to keep your account safe."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Webbplatser som drabbats av dataintrång sedan du senast ändrade ditt lösenord. Ändra ditt lösenord för att hålla ditt konto säkert."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parolanızı en son değiştirdiğinizden beri veri ihlalinden etkilenen siteler. Hesabınızı güvende tutmak için parolanızı değiştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сайти, які постраждали від витоку даних після вашої останньої зміни пароля. Змініть пароль, щоб убезпечити ваші облікові записи."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các trang web bị ảnh hưởng do vi phạm dữ liệu kể từ lần cuối bạn thay đổi mật khẩu. Thay đổi mật khẩu để giữ an toàn cho tài khoản của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自您上次修改密码以来受数据泄露影响的站点，更改您的密码以保证账户安全。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自您上次修改密碼以來受資料洩露影響的站點，更改您的密碼以保證帳號安全。"
          }
        }
      }
    },
