          "stringUnit" : {
            "state" : "translated",
            "value" : "Elemente de tip Cheie GPG care sunt revocate, expirate, deteriorate sau cărora le lipsește material utilizabil de semnare sau decriptare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи GPG-ключей, которые отозваны, просрочены, повреждены или не содержат пригодного материала для подписания или расшифровки."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ставке GPG кључева које су опозване, истекле, неисправно обликоване или којима недостаје употребљив материјал за потписивање или дешифровање."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPG-nyckelobjekt som är återkallade, utgångna, felaktigt utformade eller saknar användbart signerings- eller dekrypteringsmaterial."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPG key items that are revoked, expired, malformed, or missing usable signing or decryption material."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи GPG-ключів, які відкликано, прострочено, мають хибний формат або в яких відсутній придатний матеріал для підпису чи розшифрування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các mục khóa GPG đã bị thu hồi, hết hạn, lỗi định dạng, hoặc thiếu dữ liệu ký hay giải mã có thể dùng được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已吊销、已过期、格式损坏或缺失可用签名/解密材料的 GPG 密钥条目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPG key items that are revoked, expired, malformed, or missing usable signing or decryption material."
          }
        }
      }
    },
