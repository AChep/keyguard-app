          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データ漏洩で公開されたパスワード。このようなパスワードはすぐに変更すべきです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유출 데이터베이스에 포함된 비밀번호입니다. 유출된 비밀번호는 지금 당장 변경해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
