    "watchtower_item_duplicate_websites_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items wat een of meer URI's het wat dieselfde webwerwe dek nadat passingsopsporing toegepas is."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العناصر التي تحتوي على معرف URI واحد أو أكثر يغطي نفس مواقع الويب بعد تطبيق اكتشاف المطابقة."
          }
        },
        "bn" : {
