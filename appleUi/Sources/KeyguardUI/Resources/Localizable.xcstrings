    "pref_item_autofill_privileged_apps_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevoorregte toeps kan aanmeldversoeke namens ander dienste rig"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التطبيقات ذات الامتيازات يمكنها تقديم طلبات بيانات الاعتماد نيابة عن خدمات أخرى"
          }
        },
        "bn" : {
          "stringUnit" : {
