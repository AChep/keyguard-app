          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份功能将密码库快照保存至您指定的位置。Keyguard 在密码库发生变更时自动创建快照，您也可随时手动触发。"
          }
