    "exportaccount_attachments_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kluis sal ontsluit gehou word tydens die uitvoerproses. Daar word in die kluis se data na die aanhangsels verwys. Die aanhangsels word nooit in 'n ongeënkripteerde vorm in die proses gestoor nie."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم إبقاء Vault مفتوحًا أثناء عملية التصدير. تتم الإشارة إلى المرفقات في بيانات المخزن. لا يتم تخزين المرفقات أبدًا في شكل غير مشفر أثناء هذه العملية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vault will be kept unlocked during the export process. The attachments are referenced in the vault's data. The attachments are never stored in an unencrypted form in the process."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La caixa forta es mantindrà desbloquejada durant el procés d'exportació. Els adjunts estan referenciats a les dades de la caixa forta. Els adjunts mai es guarden de manera desencriptada durant el procés."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trezor zůstane během procesu exportu odemčený. Na přílohy se odkazuje v datech trezoru. Přílohy se v procesu nikdy neukládají v nezašifrované podobě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boksen oplåses under eksportprocessen. Der henvises til vedhæftningerne i boksens data. Vedhæftningerne gemmes aldrig i ukrypteret form under processen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Tresor wird während des Exportprozesses entsperrt bleiben. Die Anhänge werden in den Daten des Tresors referenziert. Die Anhänge werden niemals in einer unverschlüsselt gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vault will be kept unlocked during the export process. The attachments are referenced in the vault's data. The attachments are never stored in an unencrypted form in the process."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vault will be kept unlocked during the export process. The attachments are referenced in the vault's data. The attachments are never stored in an unencrypted form in the process."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vault will be kept unlocked during the export process. The attachments are referenced in the vault's data. The attachments are never stored in an unencrypted form in the process."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vault will be kept unlocked during the export process. The attachments are referenced in the vault's data. The attachments are never stored in an unencrypted form in the process."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La caja fuerte se mantendrá desbloqueada durante el proceso de exportación. Los archivos adjuntos son referenciados en los datos de la caja fuerte. Los archivos adjuntos nunca se almacenan en un formulario sin cifrar en el proceso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vault will be kept unlocked during the export process. The attachments are referenced in the vault's data. The attachments are never stored in an unencrypted form in the process."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le coffre-fort restera déverrouillé pendant le processus d'exportation. Les pièces jointes sont référencées dans les données du coffre-fort. Les pièces jointes ne sont jamais stockées en clair au cours du processus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vault will be kept unlocked during the export process. The attachments are referenced in the vault's data. The attachments are never stored in an unencrypted form in the process."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A széf az exportálási folyamat során nyitva marad. A mellékletek a széf adatainál vannak hivatkozva. A mellékletek soha nincsenek titkosítatlan formában tárolva a folyamat során."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il caveau sarà mantenuto sbloccato durante l'esportazione. Gli allegati sono richiamati nei dati della cassaforte e in ogni caso in questo processo non vengono mai memorizzati in forma non crittografata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エクスポートのプロセスを実行中は、保管庫のロックは解除されたままになります。添付ファイルは保管庫のデータが参照されます。プロセスを実行中に添付ファイルが暗号化されていない状態で保存されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관함은 내보내기 진행 중에 잠금 해제 상태로 유지됩니다. 첨부 파일은 보관함 데이터에 포함되며, 내보내기 과정에서 암호화되지 않은 형식으로는 저장되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vault will be kept unlocked during the export process. The attachments are referenced in the vault's data. The attachments are never stored in an unencrypted form in the process."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kluis zal ontgrendeld blijven tijdens het exportproces. De bijlagen worden gerefereerd in de gegevens van de kluis. De bijlagen worden nooit opgeslagen in een niet-versleuteld formaat tijdens het proces."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sejf pozostanie odblokowany podczas procesu eksportowania. Załączniki są powiązane z danymi w sejfie. Załączniki nigdy nie są zapisywane w nieszyfrowanej formie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cofre será mantido desbloqueado durante o processo de exportação. Os anexos são referenciados nos dados do cofre. Os anexos nunca são armazenados em um formulário não criptografado no processo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cofre será mantido desbloqueado durante o processo de exportação. Os anexos são referenciados nos dados do cofre. Os anexos nunca são armazenados sem encriptação durante o processo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vault will be kept unlocked during the export process. The attachments are referenced in the vault's data. The attachments are never stored in an unencrypted form in the process."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранилище будет разблокировано пока экспорт не закончится. Данные хранилища включают в себя информацию об экспортированных файлах. Файлы в процессе экспорта не сохраняются в не зашифрованном формате."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vault will be kept unlocked during the export process. The attachments are referenced in the vault's data. The attachments are never stored in an unencrypted form in the process."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vault will be kept unlocked during the export process. The attachments are referenced in the vault's data. The attachments are never stored in an unencrypted form in the process."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dışa aktarma işlemi sırasında kasa açık (kilitsiz) tutulacaktır. Ekler kasanın verilerinde referans gösterilir. Süreç içerisinde ekler hiçbir zaman şifrelenmemiş formda saklanmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сховище буде розблоковано поки експорт не завершиться. Дані сховища включають інформацію про експортовані файли. Файли в процесі експорту ніколи не зберігаються у не зашифрованому форматі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kho sẽ được giữ mở khóa trong quá trình xuất. Các tệp đính kèm được tham chiếu trong dữ liệu của kho. Các tệp đính kèm không bao giờ được lưu trữ ở dạng không được mã hóa trong quá trình này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码库将在导出过程中保持解锁。\n附件将会在导出的密码库数据中被引用。\n在此过程中附件永远不会以未加密的形式存储。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密碼庫將在匯出過程中保持解鎖。\n附件將會在匯出的密碼庫資料中被引用。\n在此過程中附件永遠不會以未加密的形式儲存。"
          }
        }
      }
    },
