          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingesteld kunnen gebruikers deze Send niet meer bekijken zodra het maximale aantal bezoekers is bereikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If set, users will no longer be able to access this item after the maximum access count is reached."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se configurado, usuários não poderão mais acessar este item se o número máximo de acessos for atingido."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se definido, os utilizadores deixarão de poder aceder a este envio quando a contagem máxima de acessos for atingida."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă ai configurat, utilizatorii nu vor mai putea deschide partajarea odată ce numărul maxim de accesări va fi atins."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, пользователи больше не будут иметь доступа к элементу после того, как достигнуто максимальное количество доступа"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If set, users will no longer be able to access this item after the maximum access count is reached."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If set, users will no longer be able to access this item after the maximum access count is reached."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlandığında, maksimum erişim sayısına ulaşıldıktan sonra kullanıcılar artık bu ögeye erişemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо встановлено, користувачі більше не зможуть отримати доступ до цього відправлення після досягнення максимальної кількості відвідувань."
          }
