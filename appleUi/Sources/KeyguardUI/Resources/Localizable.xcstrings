    "addsend_auth_emails_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontvangers sal gevra word om 'n eenmalige e-posverifikasie te voltooi nadat die skakel oopgemaak is."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُطلب من المستلمين إكمال تحقق بريد إلكتروني لمرة واحدة بعد فتح الرابط."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recipients will be asked to complete a one-time email verification after opening the link."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recipients will be asked to complete a one-time email verification after opening the link."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po otevření odkazu budou příjemci požádáni o dokončení jednorázového ověření e-mailu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontvangers worden gevraagd om een eenmalige e-mailverificatie te voltooien na het openen van de link."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
