          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe a été identifié dans des violations de données connues. Veuillez le modifier immédiatement pour protéger votre sécurité en ligne"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The password has been identified in known data breaches. Please change it immediately to protect your online security"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jelszót ismert adatszivárgások során azonosították. Kérjük, azonnal módosítsa online biztonságának védelme érdekében"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La password è stata identificata in violazioni di dati conosciute. Si prega di modificarla immediatamente per proteggere la tua sicurezza online"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパスワードは、既知のデータ漏洩で確認されています。オンラインセキュリティを保護するために、すぐにパスワードを変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유출 데이터베이스에 포함된 비밀번호입니다. 온라인 보안을 유지하기 위해 지금 비밀번호를 변경하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The password has been identified in known data breaches. Please change it immediately to protect your online security"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het wachtwoord is gevonden in bekende datalekken. Wijzig uw wachtword zo snel mogelijk om uw online gegevens te beschermen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasło zostało zidentyfikowane w znanych naruszeniach danych. Zmień je natychmiast, aby chronić bezpieczeństwo online"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A senha foi identificada em vazamentos de dados conhecidos. Altere-a imediatamente para proteger sua segurança on-line"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A palavra-passe foi identificada em violações de dados conhecidas. Por favor, altere-a imediatamente para proteger a sua segurança on-line"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procedeul de verificare relevă prezența parolei în scurgerile de date publice și din această cauză securitatea contului online asociat rămâne compromisă. Este necesar să o modifici cât de repede posibil"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пароль обнаружен в известных утечках данных. Пожалуйста, измените его немедленно, чтобы защитить свою безопасность в Интернете"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The password has been identified in known data breaches. Please change it immediately to protect your online security"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The password has been identified in known data breaches. Please change it immediately to protect your online security"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu parolanın bilinen veri ihlallerinde yer aldığı tespit edilmiştir. Çevrimiçi güvenliğinizi korumak için lütfen hemen değiştirin"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пароль ідентифіковано у відомих витоках даних. Будь ласка, негайно змініть його для захисту вашої онлайн-безпеки"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mật khẩu này đã được tìm thấy trong các dữ liệu bị rò rỉ. Vui lòng đổi mật khẩu ngay lập tức để bảo vệ an toàn trực tuyến của bạn"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码存在于已知的数据泄露中，请立即更改以保护你的网络安全"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密碼存在於已知的資料洩露中，請立即更改以保護你的網路安全"
          }
        }
      }
