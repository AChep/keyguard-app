    "datasafety_local_unlocking_vault" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om 'n Kluis te ontsluit beteken om 'n korrekte Sleutel in 'n toestel se RAM te stoor, wat 'n vermoë bied om geënkripteerde Kluis te lees en te wysig."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعني فتح Vault تخزين المفتاح الصحيح في ذاكرة الوصول العشوائي (RAM) الخاصة بالجهاز، واكتساب القدرة على قراءة Vault المشفر وتعديله."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlocking a Vault means storing a correct Key in a device's RAM, gaining an ability to read and modify encrypted Vault."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloquejar una caixa forta vol dir desar una clau correcta a la RAM del dispositiu, guanyant l'habilitat de llegir i modificar la caixa forta encriptada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odemknutí trezoru znamená uložení správného klíče v operační paměti zařízení, čímž získáte schopnost zobrazit a upravovat obsah šifrovaného trezoru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oplåsning af en boks betyder lagring af en korrekt nøgle i en enheds RAM, og derved kunne læse og ændre en krypteret boks."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Entsperren eines Tresors bedeutet, dass ein korrekter Schlüssel im Arbeitsspeicher eines Geräts gespeichert wird, wodurch die Fähigkeit erlangt wird, verschlüsselte Tresore zu lesen und zu ändern."
          }
        },
        "el" : {
