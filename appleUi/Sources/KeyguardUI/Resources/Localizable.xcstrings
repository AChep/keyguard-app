    "watchtower_item_incomplete_items_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Help jou om ontbrekende of onvolledige data in jou kluis te identifiseer. Dit kan verwys na identiteite met ontbrekende name of aanmeldings sonder gebruikersname."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يساعدك على تحديد البيانات المفقودة أو غير الكاملة في مخزنك. يمكن أن يشير هذا إلى الهويات ذات الأسماء المفقودة أو عمليات تسجيل الدخول بدون أسماء المستخدمين."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helps you identify missing or incomplete data in your vault. This can refer to identities with missing names or logins without usernames."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuda a identificar dades que falten o incompletes a la teua caixa forta. Això pot dur a identitats sense nom o inicis de sessió sense nom d'usuari."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomůže vám najít chybějící nebo nekompletní data ve vašem trezoru. Může se jednat o identity s chybějícími jmény nebo o přihlášení bez uživatelských jmen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bidrager til, at man får identificeret manglende eller ufuldstændige data i sin boks. Dette kan være identiteter med manglende navne eller logins uden brugernavne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hilft dabei, fehlende oder unvollständige Daten im Tresor zu identifizieren. Dies kann sich auf Identitäten mit fehlenden Namen oder Anmeldungen ohne Benutzernamen beziehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helps you identify missing or incomplete data in your vault. This can refer to identities with missing names or logins without usernames."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helps you identify missing or incomplete data in your vault. This can refer to identities with missing names or logins without usernames."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helps you identify missing or incomplete data in your vault. This can refer to identities with missing names or logins without usernames."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helps you identify missing or incomplete data in your vault. This can refer to identities with missing names or logins without usernames."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te ayuda a identificar datos faltantes o incompletos en tu caja fuerte. Esto puede referirse a identidades con nombres faltantes o inicios de sesión sin nombres de usuario."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auttaa sinua tunnistamaan puuttuvat tai puutteelliset tiedot holvissasi. Tämä voi viitata identiteetteihin, joista puuttuu nimiä, tai kirjautumisiin ilman käyttäjätunnuksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous aide à identifier les données manquantes ou incomplètes dans votre coffre. Cela peut se référer à des identités avec des noms manquants ou des identifiants sans nom d'utilisateur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helps you identify missing or incomplete data in your vault. This can refer to identities with missing names or logins without usernames."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segít azonosítani a tárolóban hiányzó vagy hiányos adatokat. Ez utalhat hiányzó névvel rendelkező személyazonosságokra vagy felhasználónév nélküli bejelentkezésekre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aiuta a identificare dati mancanti o incompleti nella cassaforte. Questo potrebbe riferirsi a identità con nomi mancanti o login senza nomi utente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保管庫内の不足または不完全なデータを識別するのに役立ちます。これには、名前が欠落している ID や、ユーザー名が欠落しているログインが含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관함에 있는 불완전한 데이터입니다. 이름이 없거나 사용자 이름이 없는 로그인 항목일 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helps you identify missing or incomplete data in your vault. This can refer to identities with missing names or logins without usernames."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helpt u ontbrekende of onvolledige gegevens in uw kluis te identificeren. Dit kan verwijzen naar identiteiten met ontbrekende namen of logins zonder gebruikersnamen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomaga w identyfikacji brakujących lub niekompletnych danych w sejfie. Może to dotyczyć tożsamości bez nazwisk lub danych logowania bez zdefiniowanej nazwy użytkownika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuda a identificar dados ausentes ou incompletos em seu cofre. Isso pode se referir a identificações com nomes ausentes ou logins sem nomes de usuário."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuda a identificar dados ausentes ou incompletos no seu cofre. Isso pode se referir a identidades com nomes ou credenciais ausentes sem nomes de utilizador."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghid optim ca să identifici datele incomplete sau lipsă din seif. De exemplu la o intrare de logare căreia îi lipsește numele de utilizator aferent."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помогает найти недостающие или неполные данные в вашем хранилище. Это могут быть записи без названий или имен пользователей."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helps you identify missing or incomplete data in your vault. This can refer to identities with missing names or logins without usernames."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helps you identify missing or incomplete data in your vault. This can refer to identities with missing names or logins without usernames."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasanızdaki eksik verileri belirlemenize yardımcı olur. Bu durum isimleri eksik kimlikleri veya kullanıcı adları olmayan hesapları kapsayabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Допомагає вам знайти відсутні або неповні дані у вашому сховищі. Це можуть бути записи без назв або імен користувачів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giúp bạn xác định dữ liệu bị thiếu hoặc không đầy đủ trong kho của bạn. Điều này có thể đề cập đến danh tính bị thiếu tên hoặc thông tin đăng nhập không có tên người dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帮助您识别密码库中丢失或不完整的数据，可能是没有名字或没有用户名的项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "幫助您識別密碼庫中丟失或不完整的資料，可能是沒有名字或沒有使用者名稱的專案。"
          }
        }
      }
    },
