        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Репозиторій резервних копій зберігає метадані, знімки та необов'язкові файли вкладень як окремі ZIP-архіви. Вкажіть пароль резервної копії, щоб шифрувати архіви за допомогою шифрування AES-256."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The backup repository stores metadata, snapshots, and optional attachment files as separate ZIP archives. Specify the backup password to encrypt the archives using AES-256 encryption."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份仓库以独立 ZIP 压缩包的形式存储元数据、快照及可选的附件文件。请设置备份密码，以便使用 AES-256 加密算法对压缩包进行加密。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The backup repository stores metadata, snapshots, and optional attachment files as separate ZIP archives. Specify the backup password to encrypt the archives using AES-256 encryption."
          }
        }
      }
    },
