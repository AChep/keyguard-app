        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os backups salvam snapshots do cofre em um local de sua escolha. O Keyguard os cria nas alterações do cofre, e você pode acionar um snapshot manualmente a qualquer momento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cópias de segurança guardam instantâneos do cofre num local à sua escolha. O Keyguard cria-os quando o cofre é alterado, e pode acionar um instantâneo manualmente a qualquer momento."
          }
        },
        "ro" : {
