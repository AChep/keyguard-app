          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expiration is reversible and does not protect a compromised key. Revoke a compromised key instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La caducidad es reversible y no protege una clave comprometida. En su lugar, revoque una clave comprometida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expiration is reversible and does not protect a compromised key. Revoke a compromised key instead."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'expiration est réversible et ne protège pas une clé compromise. Révoquez plutôt une clé compromise."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expiration is reversible and does not protect a compromised key. Revoke a compromised key instead."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expiration is reversible and does not protect a compromised key. Revoke a compromised key instead."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La scadenza è reversibile e non protegge una chiave compromessa. Revoca invece una chiave compromessa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効期限の変更は元に戻せますが、漏洩したキーを保護するものではありません。漏洩したキーは失効させてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "만료는 되돌릴 수 있으며 유출된 키를 보호하지 못합니다. 유출된 키는 대신 폐기하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utløp kan reverseres og beskytter ikke en kompromittert nøkkel. Tilbakekall en kompromittert nøkkel i stedet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een vervaldatum is omkeerbaar en beschermt een gecompromitteerde sleutel niet. Trek in plaats daarvan een gecompromitteerde sleutel in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygaśnięcie jest odwracalne i nie chroni skompromitowanego klucza. Zamiast tego unieważnij skompromitowany klucz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A expiração é reversível e não protege uma chave comprometida. Em vez disso, revogue uma chave comprometida."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A expiração é reversível e não protege uma chave comprometida. Em vez disso, revogue a chave comprometida."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expirarea este reversibilă și nu protejează o cheie compromisă. În schimb, revocă o cheie compromisă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Истечение срока действия обратимо и не защищает скомпрометированный ключ. Вместо этого отзовите скомпрометированный ключ."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Истек је реверзибилан и не штити компромитовани кључ. Уместо тога опозовите компромитовани кључ."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att låta nyckeln gå ut är reversibelt och skyddar inte en komprometterad nyckel. Återkalla en komprometterad nyckel i stället."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expiration is reversible and does not protect a compromised key. Revoke a compromised key instead."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зміна терміну дії є зворотною й не захищає скомпрометований ключ. Натомість відкличте скомпрометований ключ."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc đặt ngày hết hạn có thể đảo ngược và không bảo vệ được một khóa đã bị xâm phạm. Thay vào đó, hãy thu hồi khóa bị xâm phạm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置过期时间是可逆的，且无法保护已泄露的密钥。如果密钥已泄露，请将其吊销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expiration is reversible and does not protect a compromised key. Revoke a compromised key instead."
          }
        }
      }
    },
