          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amennyiben be van állítva, az elem elérhetetlen lesz, amint eléri a meghatározott hozzáférések számát."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se impostato, gli utenti non saranno più in grado di accedere a questo elemento dopo che il numero massimo di accessi verrà raggiunto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定されている場合、最大アクセス数に達した後にユーザーはこのアイテムにアクセスできなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
