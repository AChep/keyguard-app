    "ciphers_action_refresh_gpg_public_key_confirmation_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will contact your configured GPG keyserver with this key's fingerprint. If a matching public key is found, Keyguard will update the stored public key, key metadata, and keyserver status for this item."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتصل Keyguard بخادم مفاتيح GPG المُعدّ لديك باستخدام بصمة هذا المفتاح. إذا عُثر على مفتاح عام مطابق، فسيقوم Keyguard بتحديث المفتاح العام المخزّن وبيانات المفتاح الوصفية وحالة خادم المفاتيح لهذا العنصر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyguard will contact your configured GPG keyserver with this key's fingerprint. If a matching public key is found, Keyguard will update the stored public key, key metadata, and keyserver status for this item."
          }
        },
        "ca" : {
