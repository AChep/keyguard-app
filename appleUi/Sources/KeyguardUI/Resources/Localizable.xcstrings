        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A biztonsági mentések a választott helyre mentik a széf pillanatképeit. A Keyguard a széf megváltozásakor hozza létre őket, és bármikor manuálisan is készíthet pillanatképet."
          }
