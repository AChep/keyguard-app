          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If enabled, the item is stored outside of the vault, allowing to completely hide the autofill suggestions even if the vault is locked"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po włączeniu element będzie przechowywany na zewnątrz sejfu, pozwalając na całkowite zablokowanie jego odkrycia jako podpowiedzi przy zamkniętym sejfie"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ativado, o item é armazenado fora do cofre, permitindo ocultar completamente as sugestões de preenchimento automático mesmo se o cofre estiver bloqueado"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ativada, a opção permite armazenar o item fora do cofre, ocultando completamente as sugestões de preenchimento automático, mesmo que o cofre esteja trancado"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă activezi opțiunea, elementul va fi stocat și în afara seifului, permițând ascunderea completă a sugestiilor de completare automată pentru anumite adrese chiar și atunci când seiful este blocat"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, элемент сохраняется вне хранилища, что позволяет полностью скрыть предложения автозаполнения, даже когда хранилище заблокировано"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If enabled, the item is stored outside of the vault, allowing to completely hide the autofill suggestions even if the vault is locked"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If enabled, the item is stored outside of the vault, allowing to completely hide the autofill suggestions even if the vault is locked"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinleştirilirse, öge kasanın dışında saklanır ve kasa kilitli olsa bile otomatik doldurma önerilerini tamamen gizlemenize olanak tanır"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо увімкнено, запис зберігається поза сховищем, що дозволяє повністю приховати пропозиції автозаповнення, навіть якщо сховище заблоковано"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If enabled, the item is stored outside of the vault, allowing to completely hide the autofill suggestions even if the vault is locked"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果启用，该条目将存储在密码库之外，即使密码库被锁定，也可以完全隐藏自动填充建议"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果啟用，該項目將儲存在密碼庫之外，即使密碼庫被鎖定也可以完全隱藏自動填入建議"
          }
        }
      }
    },
