            "state" : "translated",
            "value" : "Passwords that have been exposed in data breaches. Such passwords should be changed immediately."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwords that have been exposed in data breaches. Such passwords should be changed immediately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las contraseñas que han sido vulneradas en las filtraciones de datos. Deben ser modificadas inmediatamente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salasanat, jotka ovat paljastuneet tietomurroissa. Tällaiset salasanat tulisi vaihtaa välittömästi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mots de passe qui ont été exposés dans des violations de données. Ces mots de passe devraient être modifiés immédiatement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwords that have been exposed in data breaches. Such passwords should be changed immediately."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az adatszivárgások során nyilvánosságra került jelszavak. Az ilyen jelszavakat azonnal meg kell változtatni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
