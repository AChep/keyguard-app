    "pref_item_automatic_backups_setup_intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups save vault snapshots to a location you choose. Keyguard creates them on vault changes, and you can trigger a snapshot manually anytime."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ النسخ الاحتياطي لقطات للخزنة في موقع تختاره. ينشئها Keyguard عند تغيّر الخزنة، ويمكنك تشغيل لقطة يدويًا في أي وقت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups save vault snapshots to a location you choose. Keyguard creates them on vault changes, and you can trigger a snapshot manually anytime."
          }
        },
        "ca" : {
