        }
      }
    },
    "datasafety_local_encryption_algorithm_outro" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Salt and Hash are then stored locally on a device, to later generate a master key to unlock the vault."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم بعد ذلك تخزين الملح والتجزئة محليًا على الجهاز، ليتم لاحقًا إنشاء مفتاح رئيسي لفتح القبو."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Salt and Hash are then stored locally on a device, to later generate a master key to unlock the vault."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sal i el hash es guarden localment al dispositiu, per a fer-se servir més tard per a generar una clau mestra i desbloquejar la caixa forta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salt a Hash jsou pak uloženy lokálně v zařízení, aby bylo možné později vygenerovat hlavní klíč k odemknutí trezoru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salt og Hash gemmes dernæst lokalt på en enhed for senere at generere en hovednøgle til at oplåse boksen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Salt und der Hash werden dann lokal auf einem Gerät gespeichert, um später einen Masterschlüssel zum Entsperren des Tresors zu generieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Salt and Hash are then stored locally on a device, to later generate a master key to unlock the vault."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Salt and Hash are then stored locally on a device, to later generate a master key to unlock the vault."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Salt and the Hash is then stored locally on a device, to later generate a master key to unlock the vault."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Salt and Hash are then stored locally on a device, to later generate a master key to unlock the vault."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sal y el Hash se almacenan localmente en un dispositivo, para luego generar una llave maestra para desbloquear la caja fuerte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suola ja tiiviste tallennetaan sitten paikallisesti laitteelle, jotta myöhemmin voidaan luoda pääavain holvin avaamiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Salt et le Hash sont ensuite stockés localement sur un appareil, pour générer plus tard une clé principale pour déverrouiller le coffre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Salt and Hash are then stored locally on a device, to later generate a master key to unlock the vault."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Só és az Ellenőrzőösszeg ezután helyileg egy eszközön tárolódik, hogy később generáljon egy mesterkulcsot a széf feloldásához."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il salt e l'hash vengono poi memorizzati localmente su un dispositivo, per poi generare una chiave principale per sbloccare la cassaforte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソルトとハッシュは、後で保管庫をロック解除するマスターキーを生成するため、デバイス上に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 후 솔트와 해시는 기기에 오프라인으로 저장되며, 나중에 보관함 잠금을 해제하기 위한 마스터 키를 생성합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Salt and Hash are then stored locally on a device, to later generate a master key to unlock the vault."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Salt en de Hash worden vervolgens lokaal opgeslagen op je apparaat, om vervolgens een hoofdsleutel mee te genereren waarmee de kluis ontgrendeld kan worden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Salt and Hash are then stored locally on a device, to later generate a master key to unlock the vault."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Salt e o Hash são armazenados localmente em um dispositivo, para gerar posteriormente uma chave mestra para desbloquear o cofre."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O segredo Salt e o Hash são armazenados localmente no dispositivo, para mais tarde gerar uma chave mestra para desbloquear o cofre."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Salt and Hash are then stored locally on a device, to later generate a master key to unlock the vault."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После этого соль и хэш сохраняются локально на устройстве, для последующей генерации мастер-ключа для разблокировки хранилища."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Salt and Hash are then stored locally on a device, to later generate a master key to unlock the vault."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Salt and Hash are then stored locally on a device, to later generate a master key to unlock the vault."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salt ve Hash, daha sonra kasayı açmak için bir ana (master) anahtar oluşturmak üzere bir cihazda yerel olarak saklanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після цього сіль та хеш записуються локально на пристрій, щоб пізніше згенерувати майстер-ключ для розблокування сховища."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau đó, Salt và Hash được lưu trữ cục bộ trên thiết bị, sau đó tạo khóa chính để mở khóa kho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "然后将盐和哈希值保存在本地设备上，以便日后生成主密钥来解锁密码库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "然後將鹽和雜湊值儲存在本地裝置上，以便日後生成主金鑰來解鎖密碼庫。"
          }
        }
      }
    },
