    "account_action_tfa_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vereis aanmelding met nog 'n toestel soos 'n sekuriteitsleutel, verifikasie-toep, SMS of e-pos"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب التحقق من تسجيل الدخول باستخدام جهاز آخر مثل مفتاح الأمان أو تطبيق المصادقة أو الرسائل القصيرة أو البريد الإلكتروني"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Require login verification with another device such as a security key, authenticator app, SMS or email"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requereix verificació d'inici de sessió amb un altre dispositiu com una clau de seguretat, aplicació d'autenticació, SMS o correu electrònic"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požadovat ověření přihlášení jiným zařízením, jako bezpečnostní klíče, autentizační aplikace, SMS nebo e-mail"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kræv login-bekræftelse med en anden enhed, såsom en sikkerhedsnøgle, godkendelses-app, SMS eller e-mail"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfordere die Überprüfung der Anmeldung mit einem anderen Gerät wie einem Sicherheitsschlüssel, einer Authentifizierungs-App, einer SMS oder einer E-Mail"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Require login verification with another device such as a security key, authenticator app, SMS or email"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Require login verification with another device such as a security key, authenticator app, SMS or email"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Require login verification with another device such as a security key, authenticator app, SMS or email"
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Require login verification with another device such as a security key, authenticator app, SMS or email"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requiere verificación de inicio de sesión con otro dispositivo como una clave de seguridad, aplicación de autenticación, SMS o correo electrónico"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Require login verification with another device such as a security key, authenticator app, SMS or email"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exiger une vérification de connexion avec un autre appareil comme une clé de sécurité, une application d'authentification, un SMS ou un e-mail"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Require login verification with another device such as a security key, authenticator app, SMS or email"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más eszközzel, például biztonsági kulccsal, hitelesítő alkalmazással, SMS-el vagy e-maillel történő bejelentkezési ellenőrzés megkövetelése"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiedi la verifica del login con un altro dispositivo, come una chiave di sicurezza, un'app di autenticazione, un SMS o un'e-mail"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログインする際にセキュリティキー、認証アプリ、SMS、メールなど、別のデバイスによる認証を必要とします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보안 키, 인증 앱, SMS, 이메일 등 다른 기기를 통한 로그인 인증을 요청합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Require login verification with another device such as a security key, authenticator app, SMS or email"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vereist inlogverificatie met een ander apparaat zoals een beveiligingssleutel, authenticatie-app, SMS of e-mail"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymagaj weryfikacji logowania na innym urządzeniu, takim jak klucz bezpieczeństwa, aplikacja uwierzytelniająca, SMS lub e-mail"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exigir verificação de login com outro dispositivo, como uma chave de segurança, aplicativo de autenticação, SMS ou e-mail"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requer verificação de início de sessão com outro dispositivo, como uma chave de segurança, aplicativo de autenticação, SMS ou e-mail"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicită verificarea conectării cu un alt dispozitiv, cum ar fi o cheie de securitate, o aplicație de autentificare, un SMS sau un e-mail"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Требовать подтверждения входа с помощью другого устройства, например ключа безопасности, приложения для аутентификации, SMS или электронной почты"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Require login verification with another device such as a security key, authenticator app, SMS or email"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Require login verification with another device such as a security key, authenticator app, SMS or email"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güvenlik anahtarı, kimlik doğrulayıcı uygulama, SMS veya e-posta gibi başka bir cihazla giriş doğrulaması zorunlu tutun"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимагати підтвердження авторизації за допомогою іншого методу, наприклад ключа безпеки, застосунку автентифікації, SMS або електронного листа"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yêu cầu xác minh đăng nhập bằng thiết bị khác như khóa bảo mật, ứng dụng xác thực, SMS hoặc email"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要使用另一个设备进行登录验证，如安全密钥、身份验证器应用、短信或电子邮件"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要使用另一個裝置進行登入驗證，如安全金鑰、身份驗證器應用、簡訊或電子郵件"
          }
        }
      }
    },
