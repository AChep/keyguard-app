    "pref_item_autofill_respect_autofill_disabled_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neem kennis dat daar webwerwe is wat daarvoor bekend is om outovul vir wagwoordvelde af te skakel. Daarbenewens ignoreer sommige blaaiers die outovul-gedeaktiveerde vlag."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لاحظ أن بعض مواقع الويب تشتهر بتعطيل الملء التلقائي لحقل كلمة المرور، كما تشتهر بعض المتصفحات بتجاهل علامة تعطيل الملء التلقائي"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note that some websites are known for disabling autofill for password fields. Additionally, some browsers are known for ignoring the autofill-disabled flag."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tingues en compte que algunes pàgines web tendeixen a deshabilitar l'emplenament automàtic per a camps de contrasenya, i alguns navegadors ignoren la bandera"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Některé webové stránky jsou známé tím, že vypínají automatické vyplňování pole hesla, stejně jako tím, že některé prohlížeče ignorují příznak vypnutého automatického vyplňování"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bemærk, at nogle websteder er kendte for at deaktivere autofyld for adgangskodefelter, samt at nogle webbrowsere er kendte for at ignorere autofyld deaktiveret-flaget"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beachten Sie, dass einige Webseiten dafür berüchtigt sind, Autofill für ein Passwortfeld zu deaktivieren sowie einige Browser dafür berüchtigt sind, die Deaktiviert-Markierung für Autofill zu ignorieren"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note that some websites are known for disabling autofill for password fields. Additionally, some browsers are known for ignoring the autofill-disabled flag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note that some websites are known for disabling autofill for password fields. Additionally, some browsers are known for ignoring the autofill-disabled flag."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note that some websites are notorious for disabling autofill for a password field as well as some browsers are notorious for ignoring the autofill disabled flag"
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note that some websites are known for disabling autofill for password fields. Additionally, some browsers are known for ignoring the autofill-disabled flag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toma en cuenta que algunos sitios web es difícil desactivar el autorrellenado para un campo de contraseña, así como algunos navegadores son difíciles para ignorar la bandera se autorrellenado desactivado"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huomaa, että jotkut verkkosivustot tunnetaan automaattisen täytön poistamisesta salasanakentistä. Lisäksi jotkut selaimet tunnetaan automaattisen täytön poiskytketyn lipun ohittamisesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notez que certains sites Web sont notoires pour désactiver le remplissage automatique pour un champ de mot de passe ainsi que certains navigateurs sont connus pour ignorer le paramètre de saisie automatique désactivé"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note that some websites are known for disabling autofill for password fields. Additionally, some browsers are known for ignoring the autofill-disabled flag."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megjegyzés: Néhány weboldal hírhedt arról, hogy letiltja az automatikus kitöltést a jelszómezőknél, valamint néhány böngésző hírhedt arról, hogy figyelmen kívül hagyja az automatikus kitöltés letiltási jelzést"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si noti che alcuni siti web sono noti per la disabilitazione del riempimento automatico per un campo di password così come alcuni browser sono noti per ignorare il flag di riempimento automatico disabilitato"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部のウェブサイトではパスワードフィールドの自動入力が無効化されており、一部のブラウザでは自動入力無効化フラグが無視されることに注意してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 웹사이트는 비밀번호 필드의 자동 완성을 꺼 두는 경우도 있습니다. 마찬가지로 일부 브라우저는 자동 완성 사용 안 함 플래그를 무시하는 경우가 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note that some websites are known for disabling autofill for password fields. Additionally, some browsers are known for ignoring the autofill-disabled flag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd er rekening mee dat sommige websites automatisch invullen uitschakelen voor een wachtwoordveld en dat ook sommige browsers deze optie negeren"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Należy mieć na uwadze, że niektóre serwisy internetowe wyłączają autouzupełnianie na swoich polach wpisywania haseł. Oprócz tego nie wszystkie z powszechnie stosowanych przeglądarek biorą w procesach komunikujących te flagi zablokowania pod uwagę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observe que alguns sites são conhecidos por desativar o preenchimento automático de um campo de senha, assim como alguns navegadores são conhecidos por ignorar o sinalizador de desativação do preenchimento automático"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note que alguns sites são conhecidos por desativar o preenchimento automático para um campo de palavra-passe, bem como alguns navegadores são conhecidos por ignorar o preenchimento automático desabilitado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note that some websites are known for disabling autofill for password fields. Additionally, some browsers are known for ignoring the autofill-disabled flag."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обратите внимание, что некоторые сайты отключают автозаполнение поля пароля, а некоторые браузеры известны тем, что игнорируют флаг отключения автозаполнения"
