          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trusting an app allows it to request credentials for any service. A malicious app could use this to try to steal your credentials."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trusting an app allows it to request credentials for any service. A malicious app could use this to try to steal your credentials."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trusting an app allows it to request credentials for any service. A malicious app could use this to try to steal your credentials."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confiar en una aplicación le permite solicitar credenciales para cualquier servicio. Una aplicación maliciosa podría usarla para intentar robar sus credenciales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trusting an app allows it to request credentials for any service. A malicious app could use this to try to steal your credentials."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser une application lui permet de demander des identifiants pour n'importe quel service. Une application malveillante pourrait utiliser cette fonctionnalité pour tenter de voler vos identifiants."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trusting an app allows it to request credentials for any service. A malicious app could use this to try to steal your credentials."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy alkalmazás megbízhatónak jelölése lehetővé teszi számára, hogy bármely szolgáltatáshoz hitelesítő adatokat kérjen. Egy rosszindulatú alkalmazás ezt felhasználhatja a hitelesítő adatok ellopására."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se consideri affidabile un'app questa potrà richiedere le credenziali per qualsiasi servizio. Un'app dannosa potrebbe sfruttare questa funzionalità per cercare di rubare le tue credenziali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを信頼すると、任意のサービスに対する認証情報をリクエストできるようになります。悪意のあるアプリがこれを悪用して認証情報を盗む可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 신뢰하면 모든 서비스에 대한 인증 정보를 요청할 수 있습니다. 악성 앱이 이를 악용하여 사용자의 인증 정보를 탈취할 위험이 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trusting an app allows it to request credentials for any service. A malicious app could use this to try to steal your credentials."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trusting an app allows it to request credentials for any service. A malicious app could use this to try to steal your credentials."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ufanie aplikacji pozwala jej na wywoływanie żądań dotyczących danych uwierzytelniających z wszystkich serwisów. Nieuczciwa aplikacja może spróbować użyć tych mechanizmów w celu kradzieży twoich danych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confiar em um aplicativo permite solicitar credenciais para qualquer serviço. Um aplicativo malicioso pode usar isso para tentar roubar suas credenciais."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confiar numa aplicação permite que esta solicite credenciais para qualquer serviço. Uma aplicação maliciosa pode usar isso para tentar roubar as suas credenciais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă ai încredere într-o aplicație, îi permiți să solicite credențiale pentru orice serviciu. O aplicație malițioasă ar putea folosi acest lucru pentru a fura credențiale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доверие к приложению позволяет ему запрашивать учетные данные для любых сервисов. Вредоносное приложение может воспользоваться этим, чтобы похитить ваши учетные данные."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trusting an app allows it to request credentials for any service. A malicious app could use this to try to steal your credentials."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trusting an app allows it to request credentials for any service. A malicious app could use this to try to steal your credentials."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir uygulamaya güvenmek, o uygulamanın herhangi bir hizmet için kimlik bilgisi talep etmesine izin verir. Kötü niyetli bir uygulama bunu kimlik bilgilerinizi çalmak için kullanabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволяє йому запитувати облікові дані для будь-якого сервісу. Зловмисний застосунок може використати це для викрадення ваших облікових даних."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trusting an app allows it to request credentials for any service. A malicious app could use this to try to steal your credentials."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信任某个应用就意味着它有权请求任何服务的凭据。恶意应用可能会利用这一点来窃取您的凭据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信任應用程式允許它請求任何服務的憑據。惡意應用程式可能會利用此漏洞試圖且取您的憑據。"
          }
        }
      }
    },
