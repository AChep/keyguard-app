    "post_notifications_permission_banner_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staan kennisgewingtoestemming toe sodat Keyguard eenmalige wagwoorde kan wys tydens outovul & meer."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منح إذن الإشعار للسماح ل Keyguard بإظهار كلمات المرور لمرة واحدة عند التعبئة التلقائية & أكثر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grant the notification permission to allow Keyguard to show one-time passwords when autofilling & more."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dona permís a Keyguard per a mostrar notificacions i així poder mostrar contrasenyes d'un sol ús en emplenar automàticament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udělte oprávnění k notifikacím, aby Keyguard zobrazoval OTP kódy při automatickém vyplňování & více."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tildel notifikationstilladelse for at tillade Keyguard at vise engangskoder ved autofyldning mv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erteilen Sie die Benachrichtigungsberechtigung um Keyguard zu erlauben, beim automatischen Ausfüllen Einmalkennwörter anzuzeigen und mehr."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grant the notification permission to allow Keyguard to show one-time passwords when autofilling & more."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grant the notification permission to allow Keyguard to show one-time passwords when autofilling & more."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grant the notification permission to allow Keyguard to show one-time passwords when autofilling & more."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grant the notification permission to allow Keyguard to show one-time passwords when autofilling & more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otorgar el permiso de notificación para permitir que Keyguard muestre contraseñas de un solo uso al autocompletar y más."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grant the notification permission to allow Keyguard to show one-time passwords when autofilling & more."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez les notifications pour permettre à Keyguard d'afficher les codes à usage unique lors du remplissage automatique &."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grant the notification permission to allow Keyguard to show one-time passwords when autofilling & more."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adja meg az értesítési engedélyt, hogy engedélyezze a Keyguard számára az egyszer használatos jelszavak automatikus kitöltéskor történő megjelenítését és még sok mást."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concedi l'autorizzazione alle notifiche per consentire a Keyguard di mostrare la password monouso durante la compilazione automatica e altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知の許可を付与することで Keyguard が自動入力時にワンタイムパスワードを表示するなどの機能を利用できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 완성 등 다양한 상황에서 앱이 OTP 코드를 표시할 수 있도록 알림 권한을 허용해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grant the notification permission to allow Keyguard to show one-time passwords when autofilling & more."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta notificaties toe om Keyguard tijdelijke toegangscodes te tonen in een notificatie tijdens het automatisch aanvullen van account gegevens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyznaj uprawnienia do powiadomień, aby umożliwić urządzeniom do wyświetlania jednorazowych haseł podczas automatycznego wypełniania & więcej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conceda a permissão de notificações para permitir que o teclado exiba senhas de uso único quando preencher automaticamente & mais."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conceder permissão de notificações para permitir que o teclado exiba códigos de uso único quando preencher automaticamente & mais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acordă permisiunea de a trimite notificări pentru a permite aplicației Keyguard să îți afișeze parole cu o singură utilizare pe parcursul completării automate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предоставить разрешение на отображение уведомлений, чтобы разрешить Keyguard показывать одноразовые пароли при автозаполнении."
