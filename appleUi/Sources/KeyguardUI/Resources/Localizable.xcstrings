    "pref_item_credential_provider_no_feature_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die toestel ondersteun nie herwinning van gebruiker-geloofsbriewe d.m.v. integrasie met geloofsbriefverskaffers nie. Kontak die vervaardiger vir meer inligting."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يدعم الجهاز استرداد بيانات اعتماد المستخدم عبر التكامل مع موفري بيانات الاعتماد. اتصل بالشركة المصنعة لمزيد من المعلومات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The device doesn't support retrieval of user credentials via integration with credential providers. Contact the manufacturer for more information."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositiu no suporta l'obtenció de credencials a través de la integració amb proveïdors de credencials. Contacta amb el fabricant per a més informació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zařízení nepodporuje načítání uživatelských údajů prostřednictvím integrace s poskytovateli údajů. Další informace získáte od výrobce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enheden understøtter ikke hentning af brugeroplysninger via integration med legitimationsoplysningsleverandører. Kontakt producenten for mere information."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät unterstützt die Abfrage von Benutzeranmeldedaten nicht über die Integration mit Anmeldeanbietern. Kontaktieren Sie den Hersteller für weitere Informationen."
          }
        },
        "el" : {
