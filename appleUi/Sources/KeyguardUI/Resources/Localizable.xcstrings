        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można zweryfikować wyznaczonego unieważnienia, ponieważ klucz publiczny unieważniającego jest niedostępny. Zaimportuj go i spróbuj ponownie."
