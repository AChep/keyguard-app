    "pref_item_automatic_backups_details_321_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep at least three copies of your vault data: your active vault and two backups. Store those copies in at least two independent places or storage types, and keep one copy off this device or off-site. A synced folder is useful, but it should not be your only backup because deletions, corruption, and unwanted changes can sync too."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتفظ بثلاث نسخ على الأقل من بيانات خزنتك: خزنتك النشطة ونسختان احتياطيتان. خزّن هذه النسخ في مكانين مستقلين على الأقل أو نوعي تخزين مختلفين، واحتفظ بنسخة واحدة خارج هذا الجهاز أو خارج الموقع. المجلد المتزامن مفيد، لكن لا ينبغي أن يكون نسختك الاحتياطية الوحيدة لأن الحذف والتلف والتغييرات غير المرغوبة قد تتزامن أيضًا."
          }
        },
