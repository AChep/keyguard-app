        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the same GNUPGHOME when Git signs commits. Keep the config local to one repository, or change --local to --global."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the same GNUPGHOME when Git signs commits. Keep the config local to one repository, or change --local to --global."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie dasselbe GNUPGHOME, wenn Git Commits signiert. Halten Sie die Konfiguration lokal in einem Repository oder ändern Sie --local zu --global."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the same GNUPGHOME when Git signs commits. Keep the config local to one repository, or change --local to --global."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the same GNUPGHOME when Git signs commits. Keep the config local to one repository, or change --local to --global."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the same GNUPGHOME when Git signs commits. Keep the config local to one repository, or change --local to --global."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the same GNUPGHOME when Git signs commits. Keep the config local to one repository, or change --local to --global."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use el mismo GNUPGHOME cuando Git firme commits. Mantenga la configuración local para un solo repositorio o cambie --local por --global."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the same GNUPGHOME when Git signs commits. Keep the config local to one repository, or change --local to --global."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le même GNUPGHOME lorsque Git signe des commits. Gardez la configuration locale à un seul dépôt, ou remplacez --local par --global."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the same GNUPGHOME when Git signs commits. Keep the config local to one repository, or change --local to --global."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the same GNUPGHOME when Git signs commits. Keep the config local to one repository, or change --local to --global."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizza lo stesso GNUPGHOME quando Git firma i commit. Mantieni la configurazione locale a un singolo repository oppure cambia --local in --global."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git がコミットに署名する際も同じ GNUPGHOME を使用します。設定は 1 つのリポジトリにローカルなまま保つか、--local を --global に変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git이 커밋에 서명할 때도 같은 GNUPGHOME을 사용하세요. 설정을 하나의 저장소에만 적용하려면 로컬로 두고, 전역으로 적용하려면 --local을 --global로 바꾸세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk samme GNUPGHOME når Git signerer commits. Hold konfigurasjonen lokal til ett repositorium, eller endre --local til --global."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik dezelfde GNUPGHOME wanneer Git commits ondertekent. Houd de configuratie lokaal voor één repository, of wijzig --local in --global."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używaj tego samego GNUPGHOME, gdy Git podpisuje commity. Zachowaj konfigurację lokalnie dla jednego repozytorium lub zmień --local na --global."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o mesmo GNUPGHOME quando o Git assinar commits. Mantenha a configuração local em um repositório ou altere --local para --global."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilize o mesmo GNUPGHOME quando o Git assina commits. Mantenha a configuração local para um repositório ou altere --local para --global."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosește același GNUPGHOME atunci când Git semnează commit-uri. Păstrează configurația locală pentru un singur depozit sau schimbă --local în --global."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте тот же GNUPGHOME, когда Git подписывает коммиты. Оставьте конфигурацию локальной для одного репозитория или замените --local на --global."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Користите исти GNUPGHOME када Git потписује комитове. Држите конфигурацију локалном за једно спремиште или промените --local у --global."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd samma GNUPGHOME när Git signerar commits. Håll konfigurationen lokal för ett enskilt repository, eller ändra --local till --global."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the same GNUPGHOME when Git signs commits. Keep the config local to one repository, or change --local to --global."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте той самий GNUPGHOME, коли Git підписує коміти. Зберігайте конфігурацію локальною для одного репозиторію або змініть --local на --global."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sử dụng cùng GNUPGHOME khi Git ký các commit. Giữ cấu hình cục bộ cho một repository, hoặc đổi --local thành --global."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Git 签名提交时使用相同的 GNUPGHOME。您可以将配置保留在当前仓库，也可以将 --local 改为 --global 全局生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the same GNUPGHOME when Git signs commits. Keep the config local to one repository, or change --local to --global."
          }
        }
      }
