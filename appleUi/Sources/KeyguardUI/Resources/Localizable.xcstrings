    "error_credential_calling_app_not_privileged" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die toep wat roep is nie gelys as bevoorreg nie en kan nie verifikasie namens ander toeps aanvra nie."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التطبيق المتصل ليس في قائمة التطبيقات ذات الامتيازات ولا يمكنه طلب المصادقة نيابة عن التطبيقات الأخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The calling app is not on the privileged list and can not request authentication on behalf of the other apps."
          }
