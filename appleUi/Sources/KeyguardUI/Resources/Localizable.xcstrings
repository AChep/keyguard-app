    "pref_item_gpg_agent_local_storage_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the GPG agent is on, Keyguard keeps an unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تشغيل وكيل GPG، يحتفظ Keyguard بنسخة غير مشفّرة من المفاتيح العامة على القرص حتى يتمكن العملاء من عرض المفاتيح أثناء قفل الخزنة. لا تُكشف المفاتيح الخاصة أبدًا؛ ولا تُخزَّن أسماء المفاتيح إلا إذا فعّلت الخيار المقابل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the GPG agent is on, Keyguard keeps an unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the GPG agent is on, Keyguard keeps an unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the GPG agent is on, Keyguard keeps an unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the GPG agent is on, Keyguard keeps an unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn der GPG-Agent aktiviert ist, bewahrt Keyguard eine unverschlüsselte Kopie der öffentlichen Schlüssel auf der Festplatte auf, damit Clients die Schlüssel auflisten können, während der Tresor gesperrt ist. Private Schlüssel werden niemals offengelegt; Schlüsselnamen werden nur gespeichert, wenn Sie die entsprechende Option aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the GPG agent is on, Keyguard keeps an unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the GPG agent is on, Keyguard keeps an unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the GPG agent is on, Keyguard keeps an unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the GPG agent is on, Keyguard keeps an unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el agente GPG está activo, Keyguard mantiene en el disco una copia sin cifrar de las claves públicas para que los clientes puedan listar las claves mientras la caja fuerte está bloqueada. Las claves privadas nunca se exponen; los nombres de las claves se almacenan solo si activa la opción correspondiente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the GPG agent is on, Keyguard keeps an unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque l'agent GPG est activé, Keyguard conserve une copie non chiffrée des clés publiques sur le disque afin que les clients puissent lister les clés lorsque le coffre-fort est verrouillé. Les clés privées ne sont jamais exposées ; les noms des clés ne sont stockés que si vous activez l'option correspondante."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the GPG agent is on, Keyguard keeps an unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the GPG agent is on, Keyguard keeps an unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando l'agente GPG è attivo, Keyguard conserva una copia non crittografata delle chiavi pubbliche su disco, così i client possono elencare le chiavi mentre la cassaforte è bloccata. Le chiavi private non vengono mai esposte; i nomi delle chiavi vengono memorizzati solo se abiliti l'opzione corrispondente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPGエージェントが有効な場合、保管庫がロックされていてもクライアントがキーを一覧表示できるように、Keyguard は公開鍵の暗号化されていないコピーをディスク上に保持します。秘密鍵は一切公開されません。キー名は、対応するオプションを有効にした場合にのみ保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPG 에이전트가 켜져 있으면 Keyguard는 보관함이 잠긴 상태에서도 클라이언트가 키 목록을 조회할 수 있도록 공개 키의 암호화되지 않은 사본을 디스크에 보관합니다. 개인 키는 절대 노출되지 않으며, 키 이름은 해당 옵션을 켠 경우에만 저장됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når GPG-agenten er på, beholder Keyguard en ukryptert kopi av de offentlige nøklene på disk slik at klienter kan liste nøkler mens hvelvet er låst. Private nøkler blir aldri eksponert; nøkkelnavn lagres bare hvis du aktiverer det tilsvarende alternativet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer de GPG agent is ingeschakeld, bewaart Keyguard een niet-versleutelde kopie van de publieke sleutels op schijf, zodat clients de sleutels kunnen weergeven terwijl de kluis vergrendeld is. Privé sleutels worden nooit blootgesteld; sleutelnamen worden alleen opgeslagen als je de bijbehorende optie inschakelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy agent GPG jest włączony, Keyguard przechowuje niezaszyfrowaną kopię kluczy publicznych na dysku, aby klienci mogli wyświetlać klucze, gdy sejf jest zablokowany. Klucze prywatne nigdy nie są ujawniane; nazwy kluczy są przechowywane tylko wtedy, gdy włączysz odpowiednią opcję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o agente GPG está ativado, o Keyguard mantém uma cópia não criptografada das chaves públicas no disco para que os clientes possam listar as chaves enquanto o cofre está bloqueado. As chaves privadas nunca são expostas; os nomes das teclas são armazenados somente se você ativar a opção correspondente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o agente GPG está ativado, o Keyguard mantém uma cópia não encriptada das chaves públicas no disco para que os clientes possam listar as chaves mesmo com o cofre bloqueado. As chaves privadas nunca são expostas, os nomes das chaves são armazenados apenas se ativar a opção correspondente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când agentul GPG este activ, Keyguard păstrează pe disc o copie necriptată a cheilor publice, astfel încât clienții să poată lista cheile cât timp seiful este blocat. Cheile private nu sunt niciodată expuse; numele cheilor sunt stocate doar dacă activezi opțiunea corespunzătoare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда GPG-агент включён, Keyguard хранит на диске незашифрованную копию открытых ключей, чтобы клиенты могли получать список ключей, пока хранилище заблокировано. Закрытые ключи никогда не раскрываются; названия ключей хранятся только если вы включите соответствующую опцию."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Када је GPG агент укључен, Keyguard чува нешифровану копију јавних кључева на диску тако да клијенти могу да излистају кључеве док је трезор закључан. Приватни кључеви никада нису изложени; имена кључева се чувају само ако омогућите одговарајућу опцију."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När GPG agent är på behåller Keyguard en okrypterad kopia av de offentliga nycklarna på disken så att klienter kan lista nycklar medan valvet är låst. Privata nycklar exponeras aldrig; nyckelnamn lagras endast om du aktiverar motsvarande alternativ."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the GPG agent is on, Keyguard keeps an unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли GPG-агент увімкнено, Keyguard зберігає незашифровану копію відкритих ключів на диску, щоб клієнти могли отримувати список ключів, поки сховище заблоковане. Секретні ключі ніколи не розкриваються; назви ключів зберігаються лише якщо ви ввімкнете відповідну опцію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi GPG agent được bật, Keyguard giữ một bản sao chưa mã hóa của các khóa công khai trên đĩa để các client có thể liệt kê khóa trong khi kho đang bị khóa. Các khóa riêng tư không bao giờ bị lộ; tên khóa chỉ được lưu nếu bạn bật tùy chọn tương ứng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 GPG 代理开启时，Keyguard 会在磁盘上保存公钥的未加密副本，以便客户端在密码库锁定期间列出密钥。私钥绝不会泄露；只有在您启用相应选项后，才会存储密钥名称。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the GPG agent is on, Keyguard keeps an unencrypted copy of the public keys on disk so clients can list keys while the vault is locked. Private keys are never exposed; key names are stored only if you enable the corresponding option."
          }
        }
      }
    },
