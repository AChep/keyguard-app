    "generator_pin_code_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byna een uit elke 10 mense gebruik dieselfde vier-syfer-PIN. Genereer PINs om algemene variante te vermy."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم واحد من كل 10 أشخاص تقريبًا نفس رقم PIN المكون من أربعة أرقام. قم بتوليد أرقام PIN لتجنب الأرقام الشائعة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almost one in 10 people use the same four-digit PIN. Generate PINs to avoid common variants."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almost one in 10 people use the same four-digit PIN. Generate PINs to avoid common variants."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alespoň jeden z 10 lidí používá stejný čtyř číselný PIN. Generujte PINy, aby jste se vyhli běžným variantám."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Næsten én ud af 10 personer bruger den samme firecifrede PIN. Generér PIN-koder for at undgå almindelige varianter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast jede zehnte Person verwendet dieselbe vierstellige PIN. Generieren Sie PINs, um gängige Varianten zu vermeiden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almost one in 10 people use the same four-digit PIN. Generate PINs to avoid common variants."
