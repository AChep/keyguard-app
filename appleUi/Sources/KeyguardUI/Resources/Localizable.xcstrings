        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mật khẩu ứng dụng không bao giờ được lưu trữ trên thiết bị cũng như không được gửi qua mạng. Nó được sử dụng để tạo khóa bí mật dùng để mã hóa dữ liệu cục bộ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用专用密码不会存储在设备上，更不会上传到服务器。它仅用于生成密钥以加密本地数据。"
