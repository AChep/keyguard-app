    "pref_item_ssh_agent_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifieer jou Git- en SSH-kliënte sonder dat daardie kliënte ooit jou private sleutel kan lees"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بمصادقة عملاء Git و SSH الخاصين بك دون تمكين هؤلاء العملاء من قراءة مفتاحك الخاص"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authenticate your Git and SSH clients without those clients ever being able to read your private key"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authenticate your Git and SSH clients without those clients ever being able to read your private key"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autentizujte své klienty systému Git a SSH prostřednictvím svých soukromých klíčů bez rizik jejich prozrazení"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authenticeer uw Git en SSH clients zonder dat die clients uw privésleutel kunnen lezen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentifizieren Sie Ihre Git- und SSH-Clients, ohne dass diese jemals Ihren privaten Schlüssel lesen können"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
