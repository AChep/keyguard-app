        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genbrug ikke samme adgangskode på flere websteder. Generér unikke adgangskoder for forbedret sikkerhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
