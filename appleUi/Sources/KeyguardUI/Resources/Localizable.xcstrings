    "pref_item_automatic_backups_details_repository_structure_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encrypted repositories use ZIP AES-256. Open repo.zip and the latest readable indexes/*.zip with the backup password; the index points to each snapshots/*.zip and blobs/**/*.zip archive and stores its ZIP password as encryption.keyBase64. If no backup password was set, these files are regular ZIP archives."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم المستودعات المشفّرة ZIP AES-256. افتح repo.zip وأحدث ملفات indexes/*.zip القابلة للقراءة باستخدام كلمة مرور النسخ الاحتياطي؛ يشير الفهرس إلى كل أرشيف snapshots/*.zip وblobs/**/*.zip ويخزّن كلمة مرور ZIP الخاصة به باسم encryption.keyBase64. إذا لم تُعيَّن كلمة مرور للنسخ الاحتياطي، فستكون هذه الملفات أرشيفات ZIP عادية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encrypted repositories use ZIP AES-256. Open repo.zip and the latest readable indexes/*.zip with the backup password; the index points to each snapshots/*.zip and blobs/**/*.zip archive and stores its ZIP password as encryption.keyBase64. If no backup password was set, these files are regular ZIP archives."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encrypted repositories use ZIP AES-256. Open repo.zip and the latest readable indexes/*.zip with the backup password; the index points to each snapshots/*.zip and blobs/**/*.zip archive and stores its ZIP password as encryption.keyBase64. If no backup password was set, these files are regular ZIP archives."
