    "backup_disclaimer_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om seker te maak jou data is veilig, volg die 3-2-1 Rugsteunreël: hou drie kopieë van jou kluis op twee verskillende soorte media, en bêre een kopie op 'n veilige plek opsyself."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لضمان عدم ضياعها أبدًا، اتبع قاعدة النسخ الاحتياطي 3-2-1: احتفظ بثلاث نسخ من قبوك على وسيطي تخزين مختلفين، واحتفظ بنسخة واحدة في مكان منفصل وآمن."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি যেন কখনো হারিয়ে না যায় তা নিশ্চিত করতে ৩-২-১ ব্যাকআপ নিয়ম মেনে চলুন: দুটো ভিন্ন মিডিয়ায় আপনার ভল্টের তিনটি কপি এবং একটি কপি আলাদা ও নিরাপদ স্থানে রাখুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ensure it's never lost, adopt the 3-2-1 Backup Rule: maintain three copies of your vault on two different media types, and keep one copy in a separate, secure location."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abyste předešli jejich ztrátě, dodržujte pravidlo zálohování 3-2-1: udržujte tři kopie svého trezoru na dvou různých datových nosičích a jednu kopii uchovávejte na odděleném a bezpečném místě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de 3-2-1 Back-upregel toe om verlies van je kluis te voorkomen: bewaar drie kopieën op twee verschillende mediatypen en bewaar één kopie op een afzonderlijke, veilige locatie."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um sicherzugehen, dass nicht verloren geht, nutze die 3-2-1 Backup Regel: behalte drei Kopien deines Tresors auf zwei verschiedenen Medien Typen, und behalte eine Kopie an einem anderen sicheren Ort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ensure it's never lost, adopt the 3-2-1 Backup Rule: maintain three copies of your vault on two different media types, and keep one copy in a separate, secure location."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ensure it's never lost, adopt the 3-2-1 Backup Rule: maintain three copies of your vault on two different media types, and keep one copy in a separate, secure location."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ensure it's never lost, adopt the 3-2-1 Backup Rule: maintain three copies of your vault on two different media types, and keep one copy in a separate, secure location."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ensure it's never lost, adopt the 3-2-1 Backup Rule: maintain three copies of your vault on two different media types, and keep one copy in a separate, secure location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para asegurar que nunca se pierdan, adopta la regla de copia de seguridad de 3-2-1: mantén tres copias de tu caja fuerte en dos tipos de medios diferentes, y guarda una copia en una ubicación segura y separada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ensure it's never lost, adopt the 3-2-1 Backup Rule: maintain three copies of your vault on two different media types, and keep one copy in a separate, secure location."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour vous assurer de ne jamais les perdre, adoptez la règle de sauvegarde 3-2-1 : conservez trois copies de votre coffre-fort sur deux types de supports différents et conservez une copie dans un endroit séparé et sécurisé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ensure it's never lost, adopt the 3-2-1 Backup Rule: maintain three copies of your vault on two different media types, and keep one copy in a separate, secure location."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hogy soha ne vesszenek el, alkalmazza a 3-2-1 biztonsági mentési szabályt: őrizzen meg három másolatot a széfből két különböző típusú adathordozón, és egy másolatot tartson egy külön, biztonságos helyen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per garantire che non sia mai perso, adotta la regola di backup 3-2-1: mantieni tre copie della tua cassaforte su due tipi di supporto differenti e tieni una copia in un luogo separato e sicuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ensure it's never lost, adopt the 3-2-1 Backup Rule: maintain three copies of your vault on two different media types, and keep one copy in a separate, secure location."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ensure it's never lost, adopt the 3-2-1 Backup Rule: maintain three copies of your vault on two different media types, and keep one copy in a separate, secure location."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ensure it's never lost, adopt the 3-2-1 Backup Rule: maintain three copies of your vault on two different media types, and keep one copy in a separate, secure location."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om ervoor te zorgen dat uw kluis nooit verloren gaat, keur de 3-2-1 reservekopieregel aan: behoud drie kopieën van uw kluis op twee verschillende mediatypes en houd één kopie op een afzonderlijke, veilige locatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby upewnić się, że nigdy ich nie utracisz, przyjmij zasadę kopii zapasowych 3-2-1: zachowaj trzy kopie swojego sejfu na dwóch różnych nośnikach danych, i przechowuj jedną kopię w oddzielnym, bezpiecznym miejscu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para garantir que ele nunca seja perdido, adote a regra de backup 3-2-1: mantenha três cópias do seu cofre em dois tipos de mídia diferentes, e manter uma cópia em um local separado e seguro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para garantir que nunca se perde, adote a regra de cópia de segurança 3-2-1: guarde três cópias do seu cofre em dois tipos de suportes diferentes e guarde uma cópia num local separado e seguro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru a nu le pierde niciodată, folosește regula de backup 3-2-1: păstrează trei copii ale seifului pe două tipuri diferite de suporturi media și păstrează o copie într-un loc separat, sigur."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы не потерять данные, придерживайтесь правила 3-2-1: храните три копии хранилища на двух разных типах носителей и одну копию — в отдельном, безопасном месте."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ensure it's never lost, adopt the 3-2-1 Backup Rule: maintain three copies of your vault on two different media types, and keep one copy in a separate, secure location."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ensure it's never lost, adopt the 3-2-1 Backup Rule: maintain three copies of your vault on two different media types, and keep one copy in a separate, secure location."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiçbir zaman kaybolmadığından emin olmak için 3-2-1 Yedekleme Kuralını benimseyin: Kasanızın iki farklı ortam türünde üç kopyasını tutun ve bir kopyasını ayrı, güvenli bir konumda saklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб ніколи їх не втратити, дотримуйтесь правила резервного копіювання 3-2-1: зберігайте три копії вашого сховища на двох різних типах носіїв, а одну копію тримайте в окремому, безпечному місці."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ensure it's never lost, adopt the 3-2-1 Backup Rule: maintain three copies of your vault on two different media types, and keep one copy in a separate, secure location."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了确保数据永不丢失，请遵循 3-2-1 备份规则：在两种不同的介质上保留三份密码库数据副本，并将一份副本存放在单独的安全位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為了確保資料永不遺失，請遵循 3-2-1 備份規則：在兩種不同的儲存媒體上保留三份資料副本，並將其中一份存放在異地且安全的空間。"
          }
        }
      }
    },
