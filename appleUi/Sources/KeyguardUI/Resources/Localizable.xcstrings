        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu được đặt, người dùng sẽ không thể truy cập mục này nữa sau khi đạt đến số lượng truy cập tối đa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置后，当达到最大访问次数时用户将不再能够访问此条目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定後，當達到最大訪問次數時使用者將不再能夠訪問此條目。"
          }
        }
      }
    },
