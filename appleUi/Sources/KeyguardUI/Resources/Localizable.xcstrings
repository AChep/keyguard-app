    "ssh_agent_setup_intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel 'n SSH-kliënt in om te koppel aan Keyguard se SSH-agent, sodat dit met jou goedgekeurde sleutels kan verifieer of teken sonder om private sleuteldata bloot te stel."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بإعداد عميل SSH للاتصال بوكيل SSH الخاص بـ Keyguard للسماح له بإجراء المصادقة أو التوقيع باستخدام مفاتيحك المعتمدة دون كشف بيانات المفتاح الخاص."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setup an SSH client to connect to Keyguard's SSH agent to let it perform authentication or signing with your approved keys without exposing private key material."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setup an SSH client to connect to Keyguard's SSH agent to let it perform authentication or signing with your approved keys without exposing private key material."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavte SSH klienta pro připojení k SSH agentovi aplikace Keyguard, aby se přes něj mohla provádět autentizace nebo podepisování vámi schválenými klíči, bez obnažení privátního materiálu klíče."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel een SSH client in om verbinding te maken met de SSH agent van Keyguard voor authenticatie of ondertekening met je goedgekeurde sleutels, zonder je privésleutelmateriaal prijs te geven."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richten Sie einen SSH-Client ein, um sich mit dem SSH-Agenten von Keyguard zu verbinden, damit dieser sich mit Ihren genehmigten Schlüsseln authentifizieren oder Daten signieren kann, ohne privates Schlüsselmaterial offenzulegen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setup an SSH client to connect to Keyguard's SSH agent to let it perform authentication or signing with your approved keys without exposing private key material."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setup an SSH client to connect to Keyguard's SSH agent to let it perform authentication or signing with your approved keys without exposing private key material."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setup an SSH client to connect to Keyguard's SSH agent to let it perform authentication or signing with your approved keys without exposing private key material."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setup an SSH client to connect to Keyguard's SSH agent to let it perform authentication or signing with your approved keys without exposing private key material."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure un cliente SSH para conectarse al agente SSH de Keyguard, lo que le permitirá realizar autenticaciones o firmas con sus claves aprobadas sin exponer material de clave privada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setup an SSH client to connect to Keyguard's SSH agent to let it perform authentication or signing with your approved keys without exposing private key material."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurez un client SSH pour vous connecter à l'agent SSH de Keyguard afin de lui permettre d'effectuer l'authentification ou la signature avec vos clés approuvées sans exposer de matériel de clé privée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setup an SSH client to connect to Keyguard's SSH agent to let it perform authentication or signing with your approved keys without exposing private key material."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Állítson be egy SSH klienst, hogy csatlakozzon a Keyguard SSH ügynökéhez, és lehetővé tegye a hitelesítést vagy az aláírást a jóváhagyott kulcsokkal anélkül, hogy felfedné a privát kulcsot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura un client SSH per la connessione all'agente SSH di Keyguard in modo da consentirgli di eseguire l'autenticazione o la firma con le tue chiavi approvate senza esporre il materiale chiave privato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSHクライアントをKeyguardのSSHエージェントに接続して設定すると、秘密鍵の情報を外部に公開することなく、承認済みキーで認証や署名を行うことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 클라이언트에서 Keyguard의 SSH 에이전트에 연결할 수 있게 설정합니다. 개인 키를 노출시키지 않고 로그인 또는 인증이 가능합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setup an SSH client to connect to Keyguard's SSH agent to let it perform authentication or signing with your approved keys without exposing private key material."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setup an SSH client to connect to Keyguard's SSH agent to let it perform authentication or signing with your approved keys without exposing private key material."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skonfiguruj klienta SSH tak, aby nawiązywał połączenie z agentem SSH Keyguard, umożliwiając mu przeprowadzanie uwierzytelniania lub podpisywania wybranymi na to kluczami, bez ujawniania ich prywatnej części."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure um cliente SSH para se conectar ao agente SSH do Keyguard para permitir que ele execute autenticação ou assinatura com suas chaves aprovadas sem expor o material da chave privada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure um cliente SSH para se ligar ao agente SSH do Keyguard, permitindo-lhe executar a autenticação ou a assinatura com as suas chaves aprovadas sem expor o material da chave privada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setup an SSH client to connect to Keyguard's SSH agent to let it perform authentication or signing with your approved keys without exposing private key material."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте SSH-клиент для подключения к SSH-агенту Keyguard, чтобы он мог выполнять аутентификацию или подписание вашими одобренными ключами без раскрытия материалов закрытого ключа."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setup an SSH client to connect to Keyguard's SSH agent to let it perform authentication or signing with your approved keys without exposing private key material."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setup an SSH client to connect to Keyguard's SSH agent to let it perform authentication or signing with your approved keys without exposing private key material."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özel anahtar materyalini ifşa etmeden onaylanmış anahtarlarınızla kimlik doğrulama veya imzalama yapabilmesi için Keyguard'ın SSH aracısına bağlanacak bir SSH istemcisi kurun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаштуйте SSH-клієнт для підключення до SSH-агента Keyguard, щоб він міг виконувати автентифікацію або підписування вашими затвердженими ключами без розкриття даних закритого ключа."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setup an SSH client to connect to Keyguard's SSH agent to let it perform authentication or signing with your approved keys without exposing private key material."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配置 SSH 客户端以连接至 Keyguard 的 SSH 代理，使其能使用您授权的密钥进行身份验证或签名操作，且不会暴露私钥材料。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setup an SSH client to connect to Keyguard's SSH agent to let it perform authentication or signing with your approved keys without exposing private key material."
          }
        }
      }
    },
