    "ciphers_action_trash_confirmation_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items wat vir meer as 30 dae in die asblik is, sal outomaties uitgevee word."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف العناصر التي ظلت في سلة المهملات لأكثر من 30 يومًا تلقائيًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যেসব আইটেম ময়লার ঝুড়িতে ৩০ দিনের বেশি সময় ধরে আছে সেগুলো স্বয়ংক্রিয়ভাবে ডিলেট হয়ে যাবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els elements que porten més de 30 dies a la paperera se suprimiran automàticament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Položky, které budou v koši více než 30 dní, se automaticky smažou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emner, som har været i papirkurven i flere end 30 dage, slettes automatisk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einträge, die länger als 30 Tage im Papierkorb waren, werden automatisch gelöscht."
