    "pref_item_automatic_backups_details_retention_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retention is bucketed, so the history is not just the last snapshots in order. Keyguard keeps the newest snapshot, then prefers daily checkpoints from the last week and weekly checkpoints across the last month; any remaining slots go to the newest available snapshots."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاحتفاظ مُقسَّم إلى فئات، لذا ليس السجل مجرد آخر اللقطات بالترتيب. يحتفظ Keyguard بأحدث لقطة، ثم يفضّل نقاط تحقق يومية من الأسبوع الأخير ونقاط تحقق أسبوعية خلال الشهر الأخير؛ وتُخصَّص أي خانات متبقية لأحدث اللقطات المتاحة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retention is bucketed, so the history is not just the last snapshots in order. Keyguard keeps the newest snapshot, then prefers daily checkpoints from the last week and weekly checkpoints across the last month; any remaining slots go to the newest available snapshots."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retention is bucketed, so the history is not just the last snapshots in order. Keyguard keeps the newest snapshot, then prefers daily checkpoints from the last week and weekly checkpoints across the last month; any remaining slots go to the newest available snapshots."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retention is bucketed, so the history is not just the last snapshots in order. Keyguard keeps the newest snapshot, then prefers daily checkpoints from the last week and weekly checkpoints across the last month; any remaining slots go to the newest available snapshots."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retention is bucketed, so the history is not just the last snapshots in order. Keyguard keeps the newest snapshot, then prefers daily checkpoints from the last week and weekly checkpoints across the last month; any remaining slots go to the newest available snapshots."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufbewahrung wird nach Zeiträumen gestaffelt; der Verlauf besteht also nicht einfach aus den letzten aufeinanderfolgenden Snapshots. Keyguard behält den neuesten Snapshot und bevorzugt anschließend tägliche Sicherungspunkte aus der letzten Woche sowie wöchentliche Sicherungspunkte aus dem letzten Monat. Verbleibende Plätze werden mit den neuesten verfügbaren Snapshots gefüllt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retention is bucketed, so the history is not just the last snapshots in order. Keyguard keeps the newest snapshot, then prefers daily checkpoints from the last week and weekly checkpoints across the last month; any remaining slots go to the newest available snapshots."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retention is bucketed, so the history is not just the last snapshots in order. Keyguard keeps the newest snapshot, then prefers daily checkpoints from the last week and weekly checkpoints across the last month; any remaining slots go to the newest available snapshots."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retention is bucketed, so the history is not just the last snapshots in order. Keyguard keeps the newest snapshot, then prefers daily checkpoints from the last week and weekly checkpoints across the last month; any remaining slots go to the newest available snapshots."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retention is bucketed, so the history is not just the last snapshots in order. Keyguard keeps the newest snapshot, then prefers daily checkpoints from the last week and weekly checkpoints across the last month; any remaining slots go to the newest available snapshots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retention is bucketed, so the history is not just the last snapshots in order. Keyguard keeps the newest snapshot, then prefers daily checkpoints from the last week and weekly checkpoints across the last month; any remaining slots go to the newest available snapshots."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retention is bucketed, so the history is not just the last snapshots in order. Keyguard keeps the newest snapshot, then prefers daily checkpoints from the last week and weekly checkpoints across the last month; any remaining slots go to the newest available snapshots."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conservation des données est organisée par tranches ; l'historique ne se limite donc pas à une simple liste chronologique des derniers instantanés. Keyguard conserve l'instantané le plus récent, puis privilégie les points de contrôle quotidiens de la semaine écoulée et les points de contrôle hebdomadaires du mois écoulé ; les emplacements restants sont attribués aux instantanés disponibles les plus récents."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retention is bucketed, so the history is not just the last snapshots in order. Keyguard keeps the newest snapshot, then prefers daily checkpoints from the last week and weekly checkpoints across the last month; any remaining slots go to the newest available snapshots."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A megőrzés kategóriákba van sorolva, így az előzmények nem csak a legutóbbi pillanatképek sorrendben. A Keyguard megtartja a legújabb pillanatképet, majd előnyben részesíti a napi mentéseket az elmúlt hétről és a heti mentéseket az elmúlt hónapból; a fennmaradó helyek a legújabb elérhető pillanatképeket kapják."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retention is bucketed, so the history is not just the last snapshots in order. Keyguard keeps the newest snapshot, then prefers daily checkpoints from the last week and weekly checkpoints across the last month; any remaining slots go to the newest available snapshots."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retention is bucketed, so the history is not just the last snapshots in order. Keyguard keeps the newest snapshot, then prefers daily checkpoints from the last week and weekly checkpoints across the last month; any remaining slots go to the newest available snapshots."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retention is bucketed, so the history is not just the last snapshots in order. Keyguard keeps the newest snapshot, then prefers daily checkpoints from the last week and weekly checkpoints across the last month; any remaining slots go to the newest available snapshots."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retention is bucketed, so the history is not just the last snapshots in order. Keyguard keeps the newest snapshot, then prefers daily checkpoints from the last week and weekly checkpoints across the last month; any remaining slots go to the newest available snapshots."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retention is bucketed, so the history is not just the last snapshots in order. Keyguard keeps the newest snapshot, then prefers daily checkpoints from the last week and weekly checkpoints across the last month; any remaining slots go to the newest available snapshots."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retention is bucketed, so the history is not just the last snapshots in order. Keyguard keeps the newest snapshot, then prefers daily checkpoints from the last week and weekly checkpoints across the last month; any remaining slots go to the newest available snapshots."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A retenção é segmentada por intervalos, portanto o histórico não é apenas os últimos snapshots em ordem. O Keyguard mantém o snapshot mais recente, depois prioriza checkpoints diários da última semana e checkpoints semanais do último mês; os slots restantes são preenchidos com os snapshots mais recentes disponíveis."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A retenção é categorizada, pelo que o histórico não se limita aos últimos instantâneos por ordem. O Keyguard mantém o instantâneo mais recente e em seguida, prioriza os pontos de verificação diários da última semana e os pontos de verificação semanais do último mês, quaisquer espaços restantes são preenchidos com os instantâneos mais recentes disponíveis."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retention is bucketed, so the history is not just the last snapshots in order. Keyguard keeps the newest snapshot, then prefers daily checkpoints from the last week and weekly checkpoints across the last month; any remaining slots go to the newest available snapshots."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранение распределяется по группам, поэтому история — это не просто последние снимки по порядку. Keyguard сохраняет самый новый снимок, затем отдаёт предпочтение ежедневным контрольным точкам за последнюю неделю и еженедельным за последний месяц; все оставшиеся места занимают самые новые из доступных снимков."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retention is bucketed, so the history is not just the last snapshots in order. Keyguard keeps the newest snapshot, then prefers daily checkpoints from the last week and weekly checkpoints across the last month; any remaining slots go to the newest available snapshots."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retention is bucketed, so the history is not just the last snapshots in order. Keyguard keeps the newest snapshot, then prefers daily checkpoints from the last week and weekly checkpoints across the last month; any remaining slots go to the newest available snapshots."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retention is bucketed, so the history is not just the last snapshots in order. Keyguard keeps the newest snapshot, then prefers daily checkpoints from the last week and weekly checkpoints across the last month; any remaining slots go to the newest available snapshots."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігання групується за періодами, тож історія — це не просто останні знімки поспіль. Keyguard зберігає найновіший знімок, потім надає перевагу щоденним контрольним точкам за останній тиждень та щотижневим контрольним точкам за останній місяць; усі інші місця займають найновіші доступні знімки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retention is bucketed, so the history is not just the last snapshots in order. Keyguard keeps the newest snapshot, then prefers daily checkpoints from the last week and weekly checkpoints across the last month; any remaining slots go to the newest available snapshots."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留策略采用分桶机制，因此历史记录并非简单地按顺序保留最新快照。Keyguard 保留最新快照，同时优先保留过去一周的每日检查点和过去一个月的每周检查点；剩余槽位则分配给最新的可用快照。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retention is bucketed, so the history is not just the last snapshots in order. Keyguard keeps the newest snapshot, then prefers daily checkpoints from the last week and weekly checkpoints across the last month; any remaining slots go to the newest available snapshots."
          }
        }
      }
    },
