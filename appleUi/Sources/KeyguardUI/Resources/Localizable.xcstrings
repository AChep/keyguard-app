    "pref_item_autofill_service_xiaomi_permission_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige Xiaomi-toestelle vereis dat jy die \"Wys opspringvensters terwyl die toep in die agtergrond loop\" toestemming handmatig toelaat. Maak asseblief die instellings oop en verifieer dat dit toegestaan word."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب بعض أجهزة Xiaomi منك السماح يدويًا بإذن \"عرض النوافذ المنبثقة أثناء التشغيل في الخلفية\". يرجى فتح الإعدادات والتحقق من منحها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some Xiaomi devices require you to manually allow the \"Display pop-up windows while running in the background\" permission. Please open the settings and verify that it is granted."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns dispositius de Xiaomi necessiten que habilites manualment el permís per a \"Mostrar finestres emergents durant l'execució en segon pla\". Per favor, obre la configuració i comprova que és correcta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Některá zařízení Xiaomi vyžadují ruční povolení oprávnění „Zobrazovat vyskakovací okna při běhu na pozadí“. Otevřete nastavení a ověřte, zda je povoleno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visse Xiaomi-enheder kræver, at man manuelt tildeler tilladelsen \"Vis pop op-vinduer under baggrundsoperation\". Åbn indstillingerne og bekræft, at den er tildelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Xiaomi Geräte verlangen, dass Sie manuell die Berechtigung \"Popup-Fenster während Sie im Hintergrund laufen\" erlauben. Bitte öffnen Sie die Einstellungen und stellen Sie sicher, dass sie gewährt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some Xiaomi devices require you to manually allow the \"Display pop-up windows while running in the background\" permission. Please open the settings and verify that it is granted."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some Xiaomi devices require you to manually allow the \"Display pop-up windows while running in the background\" permission. Please open the settings and verify that it is granted."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some Xiaomi devices require you to manually allow the \"Display pop-up windows while running in the background\" permission. Please open the settings and verify that it is granted."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some Xiaomi devices require you to manually allow the \"Display pop-up windows while running in the background\" permission. Please open the settings and verify that it is granted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos dispositivos Xiaomi requieren que permita manualmente el permiso \"Mostrar ventanas emergentes mientras se ejecuta en segundo plano\". Por favor, abra la configuración y verifique que esté permitido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jotkin Xiaomi-laitteet vaativat sinua manuaalisesti sallimaan \"Näytä ponnahdusikkunat taustalla\"-luvan. Avaa asetukset ja varmista, että se on myönnetty."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains appareils Xiaomi exigent que vous autorisiez manuellement la permission \"Afficher les fenêtres pop-up lors de l'exécution en arrière-plan\". Veuillez ouvrir les paramètres et vérifier qu'ils sont accordés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some Xiaomi devices require you to manually allow the \"Display pop-up windows while running in the background\" permission. Please open the settings and verify that it is granted."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyes Xiaomi eszközökön manuálisan engedélyezni kell a \"Felugró ablakok megjelenítése a háttérben futás közben\" engedélyt. Kérjük, nyissa meg a beállításokat, és ellenőrizze, hogy az engedély meg van-e adva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni dispositivi Xiaomi richiedono di consentire manualmente il permesso \"mostra finestre popup quando attive in background\". Si prega di aprire le impostazioni e verificare che sia concesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部の Xiaomi デバイスでは、「バックグラウンドで実行中にポップアップウィンドウを表示する」権限を手動で許可する必要があります。 設定を開き、許可されていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 샤오미 기기는 \"백그라운드에서 실행되는 동안 팝업창 표시\" 권한을 직접 허용해야 할 수 있습니다. 시스템 설정에서 권한이 허용되어 있는지 확인해 보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some Xiaomi devices require you to manually allow the \"Display pop-up windows while running in the background\" permission. Please open the settings and verify that it is granted."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor sommige Xiaomi apparaten moet je handmatig de toestemming \"Toon pop-upvensters weergeven wanneer ze in de achtergrond draaien\" toestaan. Open de instellingen en controleer of deze verleend zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some Xiaomi devices require you to manually allow the \"Display pop-up windows while running in the background\" permission. Please open the settings and verify that it is granted."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns dispositivos Xiaomi exigem que você autorize manualmente a permissão \"Exibir janelas pop-up durante a execução em segundo plano\". Abra as configurações e verifique se ela foi concedida."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns dispositivos Xiaomi requerem que permita manualmente a permissão \"Mostrar janelas pop-up enquanto estiver executando em segundo plano\". Abra as configurações e verifique se está concedida."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some Xiaomi devices require you to manually allow the \"Display pop-up windows while running in the background\" permission. Please open the settings and verify that it is granted."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые устройства Xiaomi требуют разрешения \"Отображать всплывающие окна в фоновом режиме\". Откройте настройки и убедитесь, что оно предоставлено."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some Xiaomi devices require you to manually allow the \"Display pop-up windows while running in the background\" permission. Please open the settings and verify that it is granted."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some Xiaomi devices require you to manually allow the \"Display pop-up windows while running in the background\" permission. Please open the settings and verify that it is granted."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bazı Xiaomi cihazları, \"Arka planda çalışırken açılır pencereleri göster\" iznine manuel olarak izin vermenizi gerektirir. Lütfen ayarları açın ve bu iznin verildiğini doğrulayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деякі пристрої Xiaomi вимагають ручного надання дозволу \"Показувати вікна під час роботи на задньому плані\". Будь ласка, відкрийте налаштування та переконайтеся, що дозвіл надано."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một số thiết bị Xiaomi yêu cầu bạn phải cấp quyền \"Hiển thị cửa sổ bật lên khi chạy ở chế độ nền\" theo cách thủ công. Vui lòng mở cài đặt và xác minh rằng nó đã được cấp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一些 Xiaomi 设备要求您手动允许“在后台运行时显示弹出窗口”权限。 请打开设置并确认它已被授予。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一些 Xiaomi 裝置要求您手動允許「在後臺執行時顯示彈出視窗」權限。 請開啟設定並確認它已被授予。"
          }
        }
      }
    },
