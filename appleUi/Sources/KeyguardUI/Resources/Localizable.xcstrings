    "watchtower_item_pwned_passwords_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wagwoorde wat in databreuke blootgelê is. Sulke wagwoorde moet onmiddellik verander word."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كلمات المرور التي تم الكشف عنها في خروقات البيانات. يجب تغيير كلمات المرور هذه على الفور."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwords that have been exposed in data breaches. Such passwords should be changed immediately."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrasenyes que han sigut filtrades en bases de dades. Aquestes contrasenyes haurien de ser canviades immediatament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesla, která byla odhalena při úniku dat. Taková hesla je třeba okamžitě změnit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgangskoder afsløret via datasikkerhedsbrud. Sådanne adgangskoder bør ændres øjeblikkeligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Datenlecks aufgedeckte Passwörter sollten unverzüglich geändert werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwords that have been exposed in data breaches. Such passwords should be changed immediately."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwords that have been exposed in data breaches. Such passwords should be changed immediately."
          }
        },
