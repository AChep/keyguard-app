    "watchtower_item_unsecure_websites_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verander die URL's wat die HTTP-protokol gebruik om die HTTPS-protokol te gebruik, aangesien laasgenoemde die mees gevorderde enkripsie beskikbaar benut."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتغيير عناوين URL التي تستخدم بروتوكول HTTP لاستخدام بروتوكول HTTPS، حيث يستخدم الأخير التشفير الأكثر تقدمًا المتاح."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change the URLs that use HTTP protocol to use HTTPS protocol, as the latter utilizes the most advanced encryption available."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia les URL que fan servir HTTP en comptes d'HTTPS, ja que aquest últim fa servir els algoritmes d'encriptació més segurs possibles."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Změňte adresy používající protokol HTTP tak, aby používaly protokol HTTPS, který používá nejpokročilejší dostupné šifrování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skift URL'er, som bruger HTTP-protokollen til at bruge HTTPS-protokollen, da sidstnævnte benytter den mest avancerede kryptering til rådighed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändere die URLs, die HTTP-Protokoll verwenden dazu das HTTPS-Protokoll zu verwenden, da letztere die fortschrittlichste Verschlüsselung verwendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change the URLs that use HTTP protocol to use HTTPS protocol, as the latter utilizes the most advanced encryption available."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change the URLs that use HTTP protocol to use HTTPS protocol, as the latter utilizes the most advanced encryption available."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change the URLs that use HTTP protocol to use HTTPS protocol, as the latter utilises the most advanced encryption available."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change the URLs that use HTTP protocol to use HTTPS protocol, as the latter utilizes the most advanced encryption available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia las URLs que usan el protocolo HTTP para usar el protocolo HTTPS, ya que este último usa el cifrado más avanzado disponible."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihda HTTP-protokollaa käyttävät URL-osoitteet HTTPS-protokollaan, koska jälkimmäinen käyttää edistyneintä saatavilla olevaa salausta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changez les URL qui utilisent le protocole HTTP pour utiliser le protocole HTTPS, car celui-ci utilise le cryptage le plus avancé disponible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change the URLs that use HTTP protocol to use HTTPS protocol, as the latter utilizes the most advanced encryption available."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Módosítsa a HTTP protokollt használó URL-címeket HTTPS protokoll használatára, mivel az utóbbi az elérhető legfejlettebb titkosítást használja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifica gli URL che utilizzano il protocollo HTTP per utilizzare HTTPS, in quanto quest'ultimo utilizza la crittografia più avanzata disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP プロトコルを使用している URL を、より高度な暗号化を利用した HTTPS プロトコルを使用するように変更します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP 프로토콜을 사용하는 URL을 HTTPS로 변경하세요. HTTPS 프로토콜은 가장 강력한 암호화를 사용할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change the URLs that use HTTP protocol to use HTTPS protocol, as the latter utilizes the most advanced encryption available."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wijzig de URL's die het HTTP-protocol gebruiken om het HTTPS-protocol te gebruiken, dit zorgt ervoor dat de meest geavanceerde beschikbare versleuteling wordt gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change the URLs that use HTTP protocol to use HTTPS protocol, as the latter utilizes the most advanced encryption available."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altere as URLs que utilizam o protocolo HTTP para usarem o protocolo HTTPS, pois este último utiliza a criptografia mais avançada disponível."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterar os endereços que usam o protocolo HTTP para usar o protocolo HTTPS, já que este utiliza a mais avançada criptografia disponível."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustează linkurile pentru a direcționa prin protocol HTTPS în loc de HTTP simplu, beneficiind de un grad avansat de criptare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Измените URL-адреса, использующие протокол HTTP, на протокол HTTPS, поскольку последний использует самое современное шифрование."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change the URLs that use HTTP protocol to use HTTPS protocol, as the latter utilizes the most advanced encryption available."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change the URLs that use HTTP protocol to use HTTPS protocol, as the latter utilizes the most advanced encryption available."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP protokolünü kullanan URL'leri, mevcut en gelişmiş şifrelemeyi kullandığı için HTTPS protokolünü kullanacak şekilde değiştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Змініть протокол URL-адрес з HTTP на HTTPS, оскільки останній використовує найкраще шифрування з доступного."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thay đổi các URL sử dụng giao thức HTTP để sử dụng giao thức HTTPS, vì giao thức sau sử dụng mã hóa tiên tiến nhất hiện có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改 HTTP 为 HTTPS 协议，因为后者更为安全"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改 HTTP 為 HTTPS 協議，因為後者更為安全"
