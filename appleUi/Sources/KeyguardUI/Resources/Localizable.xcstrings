        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở khóa một kho có nghĩa là lưu trữ một Chìa khóa chính xác trong RAM của thiết bị, có được khả năng đọc và sửa đổi Kho đã mã hóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解锁密码库意味着在设备的内存中存储正确的密钥，从而获得读取和修改加密密码库的能力。"
          }
        },
        "zh-Hant" : {
