    "watchtower_item_reused_passwords_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moenie dieselfde wagwoord op verskeie webwerwe gebruik nie. Genereer unieke wagwoorde om sekuriteit te verbeter."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تستخدم نفس كلمة المرور على مواقع ويب متعددة. قم بإنشاء كلمات مرور فريدة لتحسين الأمان."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
