          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto restaurará el orden y la visibilidad de navegación predeterminados. Los filtros personalizados no se eliminan, pero sus elementos de navegación se quitarán."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will restore the default navigation order and visibility. Custom filters are not deleted, but their navigation items will be removed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela restaurera l'ordre et la visibilité de navigation par défaut. Les filtres personnalisés ne sont pas supprimés, mais leurs éléments de navigation seront retirés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will restore the default navigation order and visibility. Custom filters are not deleted, but their navigation items will be removed."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will restore the default navigation order and visibility. Custom filters are not deleted, but their navigation items will be removed."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno ripristinati l'ordine e la visibilità di navigazione predefiniti. I filtri personalizzati non vengono eliminati, ma i relativi elementi di navigazione verranno rimossi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ナビゲーションの順序と表示状態を既定に戻します。カスタムフィルターは削除されませんが、そのナビゲーションアイテムは削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 탐색 순서와 표시 여부를 복원합니다. 사용자 지정 필터는 삭제되지 않지만, 해당 탐색 항목은 제거됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette gjenoppretter standard navigasjonsrekkefølge og synlighet. Egendefinerte filtre slettes ikke, men navigasjonselementene deres fjernes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee worden de standaard navigatievolgorde en -zichtbaarheid hersteld. Aangepaste filters worden niet verwijderd, maar de bijbehorende navigatie-items worden wel verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to przywrócenie domyślnej kolejności i widoczności nawigacji. Filtry niestandardowe nie zostaną usunięte, ale ich elementy nawigacji zostaną usunięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto irá restaurar a ordem e visibilidade de navegação padrão. Filtros personalizados não são excluídos, mas seus itens de navegação serão removidos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto irá restaurar a ordem e a visibilidade da navegação padrão. Os filtros personalizados não serão eliminados, mas os seus itens de navegação serão removidos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceasta va restaura ordinea și vizibilitatea implicite ale navigării. Filtrele personalizate nu sunt șterse, dar elementele lor de navigare vor fi eliminate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это восстановит порядок и видимость навигации по умолчанию. Пользовательские фильтры не удаляются, но их элементы навигации будут удалены."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ово ће вратити подразумевани редослед и видљивост навигације. Прилагођени филтери се не бришу, али ће њихове навигационе ставке бити уклоњене."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta återställer standardordningen och synligheten för navigeringen. Anpassade filter raderas inte, men deras navigeringsobjekt tas bort."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will restore the default navigation order and visibility. Custom filters are not deleted, but their navigation items will be removed."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це відновить типовий порядок і видимість навігації. Користувацькі фільтри не видаляються, але їхні елементи навігації буде вилучено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ khôi phục thứ tự và khả năng hiển thị điều hướng mặc định. Các bộ lọc tùy chỉnh không bị xóa, nhưng các mục điều hướng của chúng sẽ bị loại bỏ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将恢复默认的导航顺序和可见性。自定义过滤器不会被删除，但它们的导航项将被移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will restore the default navigation order and visibility. Custom filters are not deleted, but their navigation items will be removed."
          }
        }
      }
