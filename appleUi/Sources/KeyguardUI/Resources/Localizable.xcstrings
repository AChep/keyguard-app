    "pref_item_persist_vault_key_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die stoor van 'n kluissleutel op 'n skyf is 'n sekuriteitsrisiko. As die toestel se interne berging gekompromitteer is, sal die aanvaller toegang tot die plaaslike kluisdata verkry."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعد تخزين مفتاح قبو على القرص بمثابة خطر أمني. إذا تم اختراق وحدة التخزين الداخلية للجهاز، فسيتمكن المهاجم من الوصول إلى بيانات المخزن المحلي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storing a vault key on a disk is a security risk. If the device's internal storage is compromised, the attacker will gain access to the local vault data."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desar la clau de la caixa forta a un disc és un risc de seguretat. Si l'emmagatzematge del dispositiu es compromet, l'atacant tindrà accés a les dades."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložení klíče trezoru na disk představuje bezpečnostní riziko. Pokud dojde k narušení vnitřního úložiště, získá útočník přístup k místním datům trezoru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagring af boks-nøglen på disk er en sikkerhedsrisiko. Kompromitteres enhedens interne lagerplads, vil angriberen opnå adgang til de lokale boks-data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Speicherung eines Tresorschlüssels auf dem internen Speicher ist ein Sicherheitsrisiko. Wenn der interne Speicher des Geräts kompromittiert ist, erhält der Angreifer Zugriff auf die lokalen Tresor Daten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storing a vault key on a disk is a security risk. If the device's internal storage is compromised, the attacker will gain access to the local vault data."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storing a vault key on a disk is a security risk. If the device's internal storage is compromised, the attacker will gain access to the local vault data."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storing a vault key on a disk is a security risk. If the device's internal storage is compromised, the attacker will gain access to the local vault data."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storing a vault key on a disk is a security risk. If the device's internal storage is compromised, the attacker will gain access to the local vault data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almacenar la clave en el almacenamiento es un riesgo de seguridad, Si el almacenamiento interno es comprometido, el atacante tendrá acceso a la clave local."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holvin avaimen tallentaminen levylle on turvallisuusriski. Jos laitteen sisäinen tallennustila vaarantuu, hyökkääjä saa pääsyn paikallisiin holvitietoihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stocker une clé de coffre-fort sur un disque représente un risque de sécurité. Si la mémoire interne de l'appareil est compromise, l'attaquant aura accès aux données du coffre local."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storing a vault key on a disk is a security risk. If the device's internal storage is compromised, the attacker will gain access to the local vault data."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A trezorkulcs tárhelyen történő tárolása biztonsági kockázatot jelent. Ha az eszköz belső tárhelye veszélybe kerül, a támadó hozzáférhet a helyi széf adataihoz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiviare una chiave di cassaforte sul disco è un rischio per la sicurezza. Se la memoria interna del dispositivo è compromessa, l'attaccante otterrà l'accesso ai dati della cassaforte locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスに保管庫のキーを保存することはセキュリティリスクとなります。デバイスの内部ストレージが侵害された場合、攻撃者はローカルの保管庫のデータにアクセスすることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관함 키를 기기에 저장하면 보안에 취약합니다. 기기의 내부 저장소가 손상되면 공격자가 로컬 보관함 데이터에 접근할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storing a vault key on a disk is a security risk. If the device's internal storage is compromised, the attacker will gain access to the local vault data."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het opslaan van de kluissleutel op een schijf zorgt voor een veiligheidsrisico. Als de interne opslag van het apparaat gecompromitteerd is zal de aanvaller toegang krijgen tot de lokale kluisgegevens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storing a vault key on a disk is a security risk. If the device's internal storage is compromised, the attacker will gain access to the local vault data."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Armazenar uma chave de cofre em um disco é um risco à segurança. Se o armazenamento interno do dispositivo for comprometido, o invasor obterá acesso aos dados do cofre local."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Armazenar uma chave de cofre no disco é um risco de segurança. Se o armazenamento interno do dispositivo for comprometido, o invasor terá acesso aos dados do cofre local."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storing a vault key on a disk is a security risk. If the device's internal storage is compromised, the attacker will gain access to the local vault data."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранение ключа хранилища на диске представляет собой угрозу безопасности. Если внутреннее хранилище устройства скомпрометировано, злоумышленник получит доступ к локальным данным хранилища."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storing a vault key on a disk is a security risk. If the device's internal storage is compromised, the attacker will gain access to the local vault data."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storing a vault key on a disk is a security risk. If the device's internal storage is compromised, the attacker will gain access to the local vault data."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasa anahtarını diskte saklamak bir güvenlik riskidir. Eğer cihazın dahili depolaması ihlal edilirse, saldırgan yerel kasa verilerine erişim elde edecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігання ключа сховища на диску становить загрозу безпеці. Якщо внутрішнє сховище пристрою скомпрометовано, зловмисник отримає доступ до даних локального сховища."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc lưu trữ chìa khóa kho trên đĩa là một rủi ro bảo mật. Nếu bộ nhớ trong của thiết bị bị xâm phạm, kẻ tấn công sẽ có quyền truy cập vào dữ liệu kho cục bộ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在磁盘上存储密码库密钥存在安全风险。如果设备的内部存储被入侵，攻击者就能访问本地密码库数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在磁碟上儲存密碼庫金鑰存在安全風險。如果裝置的內部儲存被入侵，攻擊者就能訪問本地密碼庫資料。"
          }
        }
      }
    },
