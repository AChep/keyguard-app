    "passwordleak_occurrences_found_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die wagwoord is in bekende datalekkasies geïdentifiseer. Verander dit asseblief onmiddellik om jou aanlyn sekuriteit te beskerm"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم التعرف على كلمة المرور في خروقات البيانات المعروفة. يرجى تغييره على الفور لحماية أمنك على الإنترنت"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The password has been identified in known data breaches. Please change it immediately to protect your online security"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contrasenya ha sigut identificada a la llista de filtracions. Per favor, canvia-la immediatament per a protegir la teva seguretat en línia"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heslo bylo identifikováno ve známých únicích dat. Okamžitě si jej prosím změňte, abyste ochránili svou online bezpečnost"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgangskoden er blevet identificeret i kendte datalæk. Skift den med det samme for at beskytte online-sikkerheden"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
