    "pref_item_allow_screenshots_text_off" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versteek die inhoud van die toep wanneer jy tussen onlangse toeps wissel en verbied dat 'n skerm vasgelê word"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إخفاء محتوى التطبيق عند التبديل بين التطبيقات الحديثة ومنع التقاط الشاشة"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hide the content of the app when switching between recent apps and forbid capturing a screen"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amaga el contingut de l'aplicació quan es canviï entre aplicacions recents, i prohibeix fer captures de pantalla"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrýt obsah této aplikace při přepínání mezi nedávnými aplikacemi a zakázat zachycení obrazovky"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjul indholdet af appen, når der skiftes mellem seneste apps og forbyd skærmoptagelse"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Inhalt der App ausblenden, wenn zwischen den letzten Apps gewechselt wird und verbietet das Erfassen des Bildschirms"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hide the content of the app when switching between recent apps and forbid capturing a screen"
          }
