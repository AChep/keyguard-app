import kotlin.time.Instant;
import kotlin.Boolean;

CREATE TABLE watchtowerThreat (
  cipherId TEXT NOT NULL,
  type INTEGER NOT NULL,
  value TEXT,
  threat INTEGER AS Boolean NOT NULL,
  reportedAt INTEGER AS Instant NOT NULL,
  version TEXT NOT NULL,
  read INTEGER AS Boolean NOT NULL,
  cipherDataRevCounter INTEGER NOT NULL DEFAULT -1,
  PRIMARY KEY (cipherId, type),
  FOREIGN KEY (cipherId) REFERENCES cipher(cipherId) ON DELETE CASCADE
);

CREATE INDEX idx_watchtowerThreat_threat_reportedAt ON watchtowerThreat(threat, reportedAt DESC);
CREATE INDEX idx_watchtowerThreat_type_version ON watchtowerThreat(type, version);

upsert {
  UPDATE watchtowerThreat
  SET
    value = :value,
    threat = :threat,
    reportedAt = :reportedAt,
    version = :version,
    cipherDataRevCounter = :cipherDataRevCounter,
    read = CASE
      WHEN value != :value OR threat != :threat THEN 0
      ELSE read
    END
  WHERE
    (
      value != :value OR
      version != :version OR
      threat != :threat OR
      reportedAt != :reportedAt OR
      cipherDataRevCounter != :cipherDataRevCounter
    ) AND
    cipherId = :cipherId AND
    type = :type AND
    EXISTS (
      SELECT 1
      FROM cipher c
      WHERE
        c.cipherId = :cipherId AND
        c.dataRevCounter = :cipherDataRevCounter
    );

  INSERT OR IGNORE INTO watchtowerThreat(
    cipherId,
    type,
    value,
    threat,
    reportedAt,
    version,
    read,
    cipherDataRevCounter
  )
  SELECT :cipherId, :type, :value, :threat, :reportedAt, :version, 0, :cipherDataRevCounter
  FROM cipher c
  WHERE
    c.cipherId = :cipherId AND
    c.dataRevCounter = :cipherDataRevCounter;
}

markAllAsNotRead {
  UPDATE watchtowerThreat
  SET
    read = 0
  WHERE
    read > 0;
}

markAllAsRead {
  UPDATE watchtowerThreat
  SET
    read = 1
  WHERE
    read < 1;
}

markAsRead {
  UPDATE watchtowerThreat
  SET
    read = 1
  WHERE
    cipherId = :cipherId AND
    read < 1;
}

getThreats:
SELECT watchtowerThreat.*, cipher.accountId AS accountId
FROM watchtowerThreat
LEFT JOIN cipher ON cipher.cipherId = watchtowerThreat.cipherId
WHERE
  watchtowerThreat.threat > 0
ORDER BY watchtowerThreat.reportedAt DESC;

getPendingCipherKeys:
SELECT
  c.cipherId,
  c.dataRevCounter
FROM
  cipher c
LEFT JOIN watchtowerThreat t ON
  c.cipherId = t.cipherId AND
  t.type = :type AND
  t.version = :version
WHERE
  t.cipherId IS NULL OR
  c.dataRevCounter != t.cipherDataRevCounter
ORDER BY c.cipherId
LIMIT :limit;

hasPendingCiphers:
SELECT EXISTS (
  SELECT 1
  FROM cipher c
  LEFT JOIN watchtowerThreat t ON
    c.cipherId = t.cipherId AND
    t.type = :type AND
    t.version = :version
  WHERE
    t.cipherId IS NULL OR
    c.dataRevCounter != t.cipherDataRevCounter
) AS hasPending;

deleteAll:
DELETE FROM watchtowerThreat;
