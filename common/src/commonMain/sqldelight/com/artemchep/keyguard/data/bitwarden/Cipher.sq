import com.artemchep.keyguard.core.store.bitwarden.BitwardenCipher;
import kotlin.time.Instant;

CREATE TABLE cipher (
  cipherId TEXT NOT NULL PRIMARY KEY,
  accountId TEXT NOT NULL,
  folderId TEXT,
  data TEXT AS BitwardenCipher NOT NULL,
  updatedAt INTEGER AS Instant,
  dataRevCounter INTEGER NOT NULL DEFAULT 0,
  FOREIGN KEY (accountId) REFERENCES account(accountId) ON DELETE CASCADE
);

CREATE INDEX idx_cipher_accountId ON cipher(accountId);
CREATE INDEX idx_cipher_folderId ON cipher(folderId);

insert {
  UPDATE cipher
  SET
    folderId = :folderId,
    data = :data,
    updatedAt = :updatedAt,
    dataRevCounter = dataRevCounter + 1
  WHERE
    accountId = :accountId AND
    cipherId = :cipherId;

  INSERT OR IGNORE INTO cipher(cipherId, accountId, folderId, data, updatedAt)
  VALUES (:cipherId, :accountId, :folderId, :data, :updatedAt);
}

get:
SELECT *
FROM cipher;

getIds:
SELECT cipherId
FROM cipher;

getCipherSnapshots:
SELECT
  cipherId,
  data,
  dataRevCounter
FROM cipher;

getCipherSnapshotKeys:
SELECT
  cipherId,
  dataRevCounter
FROM cipher
ORDER BY cipherId;

getCipherSnapshotsByIds:
SELECT
  cipherId,
  data,
  dataRevCounter
FROM cipher
WHERE cipherId IN :cipherIds
ORDER BY cipherId;

getByCipherId:
SELECT *
FROM cipher
WHERE
    cipherId == :cipherId;

getByAccountId:
SELECT *
FROM cipher
WHERE
    accountId == :accountId;

getByFolderId:
SELECT *
FROM cipher
WHERE
    folderId == :folderId;

deleteAll:
DELETE FROM cipher;

deleteByCipherId:
DELETE FROM cipher
WHERE
    cipherId == :cipherId;

deleteByAccountIds:
DELETE FROM cipher
WHERE
    accountId IN :accountId;
