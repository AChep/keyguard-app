-- The credential-transfer picker entry registered for each account.
--
-- `entryId` is the id Keyguard registers an `ExportEntry` under, and the platform
-- hands it back on an inbound export request. It is treated as a SECRET: it is
-- the check that proves a request originated from a registration Keyguard made,
-- and it is the real security boundary of the export activity (the calling
-- package can be spoofed via FLAG_ACTIVITY_FORWARD_RESULT; this cannot). It must
-- also stay STABLE, so it is minted once per account and never rewritten.
--
-- Unlike `account`, rows are NEVER pruned — not when an account is hidden, and
-- not when it is deleted. That is deliberate: the platform may still hold a
-- registration naming an id whose account has since become unavailable, and
-- keeping the row is what lets such a pick resolve to a known-but-unavailable
-- account and render an explanation, instead of the bare "unknown caller"
-- rejection an absent row produces. Retaining it is safe — the id is an opaque
-- uuid carrying no identity, it is no longer advertised to the platform once the
-- account stops being registered, and a re-added account is a new `accountId`
-- (a fresh uuid), so a dead row can never resurrect anything. Growth is bounded
-- by accounts-ever-added.
CREATE TABLE credentialExchangeExportEntry (
  accountId TEXT NOT NULL PRIMARY KEY,
  entryId TEXT NOT NULL
);

-- Mints an entry id only when the account has none. Deliberately INSERT OR
-- IGNORE with no accompanying UPDATE: an existing `entryId` must survive every
-- sync, because rotating it silently invalidates the registration the platform
-- is holding.
insert:
INSERT OR IGNORE INTO credentialExchangeExportEntry(accountId, entryId)
VALUES (:accountId, :entryId);

get:
SELECT *
FROM credentialExchangeExportEntry
ORDER BY accountId ASC;

-- The exact snapshot that may be advertised to the platform. Joining from the
-- visible account mirror guarantees that hidden/deleted accounts are excluded,
-- while the inner join guarantees that every returned account has a persisted,
-- stable entry id.
getRegistrations:
SELECT
  account.accountId,
  account.name,
  account.email,
  account.host,
  credentialExchangeExportEntry.entryId
FROM account
INNER JOIN credentialExchangeExportEntry
  ON credentialExchangeExportEntry.accountId = account.accountId
ORDER BY account.name ASC, account.email ASC, account.accountId ASC;

getByEntryId:
SELECT *
FROM credentialExchangeExportEntry
WHERE entryId = :entryId;

-- Only for a full reset; there is no per-account delete on purpose (see above).
deleteAll:
DELETE FROM credentialExchangeExportEntry;
