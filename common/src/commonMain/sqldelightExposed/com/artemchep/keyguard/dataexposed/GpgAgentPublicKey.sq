import kotlin.Boolean;

CREATE TABLE gpgAgentPublicKey (
  keygrip TEXT NOT NULL PRIMARY KEY,
  fingerprint TEXT NOT NULL,
  algorithm TEXT NOT NULL,
  canSign INTEGER AS Boolean NOT NULL,
  canDecrypt INTEGER AS Boolean NOT NULL DEFAULT 0,
  publicKeyArmored TEXT,
  name TEXT
);

insert:
INSERT OR REPLACE INTO gpgAgentPublicKey(
  keygrip,
  fingerprint,
  algorithm,
  canSign,
  canDecrypt,
  publicKeyArmored,
  name
)
VALUES (:keygrip, :fingerprint, :algorithm, :canSign, :canDecrypt, :publicKeyArmored, :name);

get:
SELECT *
FROM gpgAgentPublicKey
ORDER BY fingerprint ASC, keygrip ASC;

getByKeygrip:
SELECT *
FROM gpgAgentPublicKey
WHERE keygrip = :keygrip;

deleteAll:
DELETE FROM gpgAgentPublicKey;

clearNames:
UPDATE gpgAgentPublicKey
SET name = NULL;
