CREATE TABLE gpgCertificationAuthority (
  accountId TEXT NOT NULL,
  cipherId TEXT NOT NULL,
  publicKeyArmored TEXT NOT NULL,
  primaryFingerprint TEXT NOT NULL,
  PRIMARY KEY (accountId, cipherId, primaryFingerprint)
);

insert:
INSERT OR REPLACE INTO gpgCertificationAuthority(
  accountId,
  cipherId,
  publicKeyArmored,
  primaryFingerprint
)
VALUES (
  :accountId,
  :cipherId,
  :publicKeyArmored,
  :primaryFingerprint
);

get:
SELECT *
FROM gpgCertificationAuthority
ORDER BY primaryFingerprint ASC, accountId ASC, cipherId ASC;

deleteAll:
DELETE FROM gpgCertificationAuthority;
