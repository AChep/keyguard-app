import kotlin.Boolean;

CREATE TABLE sshAgentPublicKey (
  accountId TEXT NOT NULL,
  cipherId TEXT NOT NULL,
  publicKey TEXT NOT NULL,
  publicKeyBlobSha256 TEXT NOT NULL,
  keyType TEXT NOT NULL,
  fingerprint TEXT NOT NULL,
  canSign INTEGER AS Boolean NOT NULL,
  name TEXT,
  PRIMARY KEY (accountId, cipherId)
);

insert:
INSERT OR REPLACE INTO sshAgentPublicKey(
  accountId,
  cipherId,
  publicKey,
  publicKeyBlobSha256,
  keyType,
  fingerprint,
  canSign,
  name
)
VALUES (
  :accountId,
  :cipherId,
  :publicKey,
  :publicKeyBlobSha256,
  :keyType,
  :fingerprint,
  :canSign,
  :name
);

get:
SELECT *
FROM sshAgentPublicKey
ORDER BY keyType ASC, fingerprint ASC, publicKeyBlobSha256 ASC, accountId ASC, cipherId ASC;

getByPublicKeyBlobSha256:
SELECT *
FROM sshAgentPublicKey
WHERE publicKeyBlobSha256 = :publicKeyBlobSha256
ORDER BY accountId ASC, cipherId ASC;

deleteAll:
DELETE FROM sshAgentPublicKey;

clearNames:
UPDATE sshAgentPublicKey
SET name = NULL;
