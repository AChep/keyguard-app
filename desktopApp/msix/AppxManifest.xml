<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest template. The placeholders wrapped in "at" signs are replaced by the
  `prepare*Msix*` Gradle tasks in desktopApp/build.gradle.kts, see the
  desktopApp/msix/README.md for the list of the properties.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop6 rescap">

  <Identity
    Name="@IDENTITY_NAME@"
    Publisher="@PUBLISHER@"
    Version="@VERSION@"
    ProcessorArchitecture="@PROCESSOR_ARCHITECTURE@" />

  <Properties>
    <DisplayName>Keyguard App</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Description>Secure password manager that's also nice to use</Description>
    <Logo>Assets\StoreLogo.png</Logo>
    <!--
      Keep the vault in %LOCALAPPDATA%\ArtemChepurnyi\keyguard, shared with
      the MSI install and kept on uninstall, instead of the package-private
      LocalCache directory. Requires the 'unvirtualizedResources' capability
      and Windows 10 version 1903 or later.
    -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Keyguard" Executable="Keyguard.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Keyguard"
        Description="Secure password manager that's also nice to use"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
