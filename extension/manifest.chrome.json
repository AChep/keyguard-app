{
  "manifest_version": 3,
  "name": "Keyguard Autofill",
  "version": "0.1.0",
  "description": "Autofill credentials from the Keyguard desktop app into websites.",
  "permissions": ["storage", "tabs", "activeTab", "scripting", "nativeMessaging", "contextMenus", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "48": "icons/lock-48.png",
    "96": "icons/lock-96.png",
    "128": "icons/lock-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Keyguard Autofill",
    "default_icon": {
      "16": "icons/lock-16.png",
      "32": "icons/lock-32.png",
      "48": "icons/lock-48.png",
      "96": "icons/lock-96.png",
      "128": "icons/lock-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "autofill": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space"
      },
      "description": "Autofill credentials (single match) or open popup (multiple)"
    }
  }
}
