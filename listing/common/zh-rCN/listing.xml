<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="listing_summary">管理密码</string>
    <string name="listing_summary_long">轻松管理密码</string>
    <string name="listing_description_title">Keyguard 是一款安全易用的密码管理器，支持离线使用，并可与 Bitwarden® 和 KeePass (KDBX) 同步。</string>
    <string name="listing_description_disclaimer_bitwarden_legal">可与任何 Bitwarden® 系统配合使用。本产品与 Bitwarden 项目或 Bitwarden 公司无关。Bitwarden® 是 Bitwarden 公司的注册商标。</string>
    <!-- A heading above the list of the most used features -->
    <string name="listing_description_section_essentials">常用功能</string>
    <!-- A heading above the list of the security features -->
    <string name="listing_description_section_security">安全</string>
    <!-- A heading above the list of the features for syncing, moving and backing up a vault -->
    <string name="listing_description_section_data">您的数据</string>
    <!-- A heading above the list of the features for advanced users -->
    <string name="listing_description_section_tools">高级工具</string>
    <!-- Android only. A list item that starts with the name of the feature -->
    <string name="listing_description_highlight_autofill_android">自动填充：在应用和浏览器中填入用户名和密码，并在登录时保存新的登录信息。</string>
    <!-- Android only. A list item that starts with the name of the feature -->
    <string name="listing_description_highlight_passkeys_android">通行密钥：创建通行密钥，用于在应用、浏览器和附近的电脑上登录。</string>
    <!-- A list item that starts with the name of the feature. TOTP, HOTP, Steam and mOTP are the names of the code formats -->
    <string name="listing_description_highlight_totp">一次性密码：在登录条目中保存身份验证器密钥，获取 TOTP、HOTP、Steam 和 mOTP 验证码。</string>
    <string name="listing_description_highlight_generator">生成器：生成密码、口令、用户名、电子邮件别名，以及 SSH 和 GPG 密钥，支持自定义词表。</string>
    <string name="listing_description_highlight_search">搜索：使用短语、排除条件和字段限定符查找条目，并保存常用筛选条件。</string>
    <!-- Desktop only. A list item that starts with the name of the feature -->
    <string name="listing_description_highlight_quick_search_desktop">快速搜索：在任意应用中通过全局快捷键查找条目，并复制其字段值。</string>
    <string name="listing_description_highlight_watchtower">Watchtower：检测密码泄露、密码重复使用、弱密码、账户泄露、未启用双因素认证、不安全的网站，以及重复或即将过期的条目。</string>
    <!-- A list item that starts with the name of the feature. The app password is the password that unlocks Keyguard -->
    <string name="listing_description_highlight_unlock">解锁：使用应用密码解锁，或使用生物识别、YubiKey 或安全密钥等更快捷的方式。</string>
    <string name="listing_description_highlight_ssh_agent">SSH 代理：使用 SSH 密钥向服务器和 Git 托管平台进行身份验证，密钥始终留在密码库内。</string>
    <string name="listing_description_highlight_gpg_agent">GPG 代理和工具：在其他应用或 Keyguard 中签名和解密，GPG 密钥始终留在密码库内。</string>
    <!-- Desktop only. A list item that starts with the name of the feature. Coding agents are AI tools that write code -->
    <string name="listing_description_highlight_environments_desktop">环境（测试版）：将 API 密钥等环境变量保存在密码库中，并传递给本地工具和编程智能体。</string>
    <string name="listing_description_highlight_multiple_accounts">多账户：登录多个 Bitwarden 和 KeePass 账户，在同一个密码库中查看各账户的条目。</string>
    <!-- A list item that starts with the name of the feature. The server is a Bitwarden server that the user hosts -->
    <string name="listing_description_highlight_self_hosted">自托管服务器：通过单点登录、客户端证书和自定义 HTTP 请求头连接到自己的服务器。</string>
    <string name="listing_description_highlight_offline">离线：无网络连接也能查看密码库、新增或编辑条目。更改会在下次同步时逐字段合并。</string>
    <!-- A list item that starts with the name of the feature -->
    <string name="listing_description_highlight_import">导入：从浏览器和其他密码管理器迁移密码。</string>
    <!-- Android only. A list item that starts with the name of the feature -->
    <string name="listing_description_highlight_credential_exchange_android">凭据交换：在 Keyguard 与设备上的其他应用之间直接迁移密码和通行密钥。</string>
    <string name="listing_description_highlight_export">导出：将条目及其附件保存为加密 ZIP 压缩包或 KeePass 数据库。</string>
    <string name="listing_description_highlight_backup">备份：将密码库快照按版本保存到文件夹、WebDAV 服务器或兼容 S3 的存储中。</string>
    <string name="listing_description_highlight_attachment_preview">附件：将文件上传到密码库，无需保存到磁盘即可预览图片、文本和 ZIP 压缩包。</string>
    <!-- A list item that starts with the name of the feature. A send is a Bitwarden feature for sharing text or a file -->
    <string name="listing_description_highlight_sends">Sends：通过会过期的链接分享文本或文件，可选密码或访问次数限制。</string>
    <!-- Android only. A list item that starts with the name of the platform -->
    <string name="listing_description_highlight_wear_os_android">Wear OS：在手表上查看条目和一次性密码，并登录手表应用。</string>
    <!-- A list item that starts with the name of the feature -->
    <string name="listing_description_highlight_linked_devices">关联设备（测试版）：在设备之间直接同步应用设置，如电子邮件转发器和词表。</string>
    <string name="listing_description_highlight_other">高级功能：批量操作、字段占位符和 URL 覆盖。</string>
    <string name="listing_description_highlight_design">界面：采用 Material You 设计，提供浅色、深色和纯黑主题。</string>
    <!-- Android only. A sentence shown below the lists of features -->
    <string name="listing_description_platforms_android">Keyguard 也提供 Linux、macOS 和 Windows 版本。</string>
    <!-- Android only. A label shown before the link to the source code of the app -->
    <string name="listing_description_source_code_android">源代码：</string>
    <!-- Android only. A heading above the list of Android permissions and what the app uses each of them for -->
    <string name="listing_description_permissions_android">应用如何使用所声明的权限</string>
    <!-- Android only. A list item that starts with the name of an Android permission, do not translate the name -->
    <string name="listing_description_permission_query_all_packages_android">QUERY_ALL_PACKAGES：将应用关联到条目时列出已安装的应用，并显示关联应用的名称和图标。</string>
