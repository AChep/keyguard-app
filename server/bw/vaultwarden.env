# Bitwarden-compatible test server for Keyguard: Vaultwarden, API only.
#
# Single source of truth for the image pin and the server settings. Read by
# server/bw/bw (manual runs, as a `docker run --env-file`) and by
# integration/bitwardenE2eTest (Testcontainers).
# Plain KEY=VALUE lines; a line starting with `#` is a comment, and values are
# not quoted. Every key is passed to the container as an environment variable;
# only VAULTWARDEN_IMAGE has no effect there.
#
# DOMAIN is added at launch because it carries the host port.

# Multi-arch index digest, identical on docker.io/vaultwarden/server.
# Bump: docker buildx imagetools inspect ghcr.io/dani-garcia/vaultwarden:<tag>
VAULTWARDEN_IMAGE=ghcr.io/dani-garcia/vaultwarden:1.37.4-alpine@sha256:19ea2b669945d842dadc3d500f2d6a795866a003330f59a47b9634658bae98bb

# /data is a tmpfs, so the SQLite database lives in RAM and dies with the container.
# Skips the persistent-volume check. Not an in-memory SQLite database: Vaultwarden
# migrates on a connection that it drops before the pool opens.
I_REALLY_WANT_VOLATILE_STORAGE=true
# API only. Manual runs may override this to register accounts in a browser.
WEB_VAULT_ENABLED=false
# Accounts register over the API; no SMTP, so no verification mail.
SIGNUPS_ALLOWED=true
SIGNUPS_VERIFY=false
# Opens the /admin JSON API for test cleanup. The server listens on loopback only.
DISABLE_ADMIN_TOKEN=true
# No outbound traffic from the container.
DISABLE_ICON_DOWNLOAD=true
PUSH_ENABLED=false
# Live sync notifications at /notifications/hub on the same port.
ENABLE_WEBSOCKET=true
# Server-side hashing of the client's master password hash; the minimum, for fast logins.
PASSWORD_ITERATIONS=100000
# Every request arrives from one gateway address, so the per-IP limits must not trip.
LOGIN_RATELIMIT_MAX_BURST=1000
UNAUTHENTICATED_RATELIMIT_MAX_BURST=1000
LOG_LEVEL=info
