# Public build-time configuration. Never put Paddle API/webhook secrets here.
# Checkout stays unavailable until explicitly enabled with valid configuration.
PUBLIC_PURCHASE_ENABLED=false
PUBLIC_PADDLE_ENVIRONMENT=sandbox
PUBLIC_PADDLE_CLIENT_TOKEN=
# Price shown on the page; must match the backend's PADDLE_PRICE_ID.
# Price preview works even while PUBLIC_PURCHASE_ENABLED=false.
PUBLIC_PADDLE_PRICE_ID=
PUBLIC_LICENSE_API_URL=https://license.keyguard.dev

# Required HTTPS links to owner-approved policies before production is enabled.
# Leave empty until the policy text and its public location have been approved.
PUBLIC_PURCHASE_TERMS_URL=
PUBLIC_PURCHASE_PRIVACY_URL=
PUBLIC_PURCHASE_REFUND_URL=
