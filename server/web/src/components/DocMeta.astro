---
import type { CollectionEntry } from 'astro:content';
import { DOC_STAGE_LABELS } from '../consts';
import { expandPlatforms, platformLabel } from '../lib/docs';

interface Props {
  doc: CollectionEntry<'docs'>;
  class?: string;
}

// Availability badges: platforms, premium and release stage, read from the
// doc's frontmatter. Shown under the title of a doc and of its feature page.
const { doc, class: className } = Astro.props;
const platforms = expandPlatforms(doc.data.platforms).map(platformLabel).join(' · ');
const stage = doc.data.stage && DOC_STAGE_LABELS[doc.data.stage];
---

<div class:list={['flex flex-wrap items-center gap-2 text-sm', className]} data-pagefind-ignore>
  <span class="text-on-surface-variant">{platforms}</span>
  {
    doc.data.premium && (
      <a
        href="/docs/premium/"
        class="doc-badge rounded-full bg-primary-container px-3 py-1 text-xs font-semibold text-on-primary-container"
      >
        Premium
      </a>
    )
  }
  {
    stage && (
      <span class="doc-badge rounded-full border border-outline-variant px-3 py-1 text-xs font-semibold text-on-surface-variant">
        {stage}
      </span>
    )
  }
</div>
