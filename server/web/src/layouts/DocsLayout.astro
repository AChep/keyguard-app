---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import DocLink from '../components/DocLink.astro';
import DocMeta from '../components/DocMeta.astro';
import PlatformMatrix from '../components/docs/PlatformMatrix.astro';
import TroubleshootingIndex from '../components/docs/TroubleshootingIndex.astro';
import { getDocGroups, resolveRelated } from '../lib/docs';

interface Props {
  title: string;
  description?: string;
  /** the rendered doc; undefined on the docs index */
  entry?: CollectionEntry<'docs'>;
}

const { title, description, entry } = Astro.props;
const currentId = entry?.id;

const groups = await getDocGroups();
const related = entry ? await resolveRelated(entry) : [];
const relatedTitle = entry?.data.type === 'tutorial' ? 'Next steps' : 'Related';
// The Pagefind index exists only in a built site (`pnpm build`).
const search = import.meta.env.PROD;
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    {search && <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />}
  </Fragment>

  <div class="mx-auto flex max-w-6xl flex-col gap-10 px-6 py-12 md:flex-row">
    <aside class="md:w-60 md:shrink-0">
      <div id="docs-search" class="mb-4" data-pagefind-ignore>
        {search && <pagefind-modal-trigger placeholder="Search docs" />}
        {search && <pagefind-modal />}
        <p class="docs-search-missing rounded-xl border border-dashed border-outline-variant px-4 py-2 text-sm text-on-surface-variant">
          Search works in the built site.
        </p>
      </div>
      <details id="docs-nav" class="group" open>
        {/* On mobile this summary is a tap-to-expand bar; hidden from md up where
            the sidebar is always shown (the inline script keeps it open there). */}
        <summary class="flex cursor-pointer list-none items-center justify-between rounded-xl border border-outline-variant px-4 py-3 font-medium text-on-surface md:hidden [&::-webkit-details-marker]:hidden">
          Documentation
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-on-surface-variant transition-transform group-open:rotate-180">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <nav class="mt-4 flex flex-col gap-6 text-sm md:mt-0">
          {
            groups.map((group) => (
              <div>
                <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-on-surface-variant">
                  {group.label}
                </p>
                <div class="flex flex-col gap-1">
                  {group.entries.map((entry) =>
                    entry.kind === 'doc' ? (
                      <DocLink doc={entry.doc} currentId={currentId} />
                    ) : (
                      <div class="mt-1 flex flex-col gap-1 border-l border-outline-variant pl-3 ml-3">
                        <p class="px-3 pt-1 text-xs font-semibold text-on-surface-variant">
                          {entry.subsection.label}
                        </p>
                        {entry.subsection.docs.map((doc) => (
                          <DocLink doc={doc} currentId={currentId} />
                        ))}
                      </div>
                    ),
                  )}
                </div>
              </div>
            ))
          }
        </nav>
      </details>
    </aside>

    <article class="prose-doc min-w-0 flex-1" data-pagefind-body={entry ? '' : undefined}>
      <h1 class="text-3xl font-semibold tracking-tight text-on-surface">
        {title}
      </h1>
      {entry && <DocMeta doc={entry} class="mt-3" />}
      <div class="mt-6">
        <slot />
        {entry?.data.generated === 'platform-support' && <PlatformMatrix />}
        {entry?.data.generated === 'troubleshooting-index' && <TroubleshootingIndex />}
      </div>
      {
        related.length > 0 && (
          <nav aria-label={relatedTitle} data-pagefind-ignore>
            <h2>{relatedTitle}</h2>
            <ul>
              {related.map((doc) => (
                <li>
                  <a href={`/docs/${doc.id}/`}>{doc.data.title}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </article>
  </div>

  {search && <script is:inline type="module" src="/pagefind/pagefind-component-ui.js" onerror="document.getElementById('docs-search').dataset.missing = ''"></script>}

  <script is:inline>
    // Collapse the docs nav on small screens; keep it open (and the toggle bar
    // hidden) from md up. Defaults to open in the HTML, so it still works without JS.
    (function () {
      const nav = document.getElementById('docs-nav');
      if (!nav) return;
      const mq = window.matchMedia('(min-width: 768px)');
      const sync = () => { nav.open = mq.matches; };
      sync();
      mq.addEventListener('change', sync);
    })();
  </script>
</BaseLayout>

<style>
  /* The note shows in dev, where there is no index, and when the index fails to load. */
  .docs-search-missing {
    display: none;
  }
  #docs-search:not(:has(pagefind-modal-trigger)) .docs-search-missing,
  #docs-search[data-missing] .docs-search-missing {
    display: block;
  }
  #docs-search[data-missing] pagefind-modal-trigger {
    display: none;
  }
</style>
